@inherits InputText

@*
    Giống InputText nhưng cập nhật giá trị NGAY khi gõ (sự kiện "input"), không chờ rời ô ("change").
    Dùng cho form ngắn gửi bằng phím Enter / trình duyệt tự điền (đăng nhập, quên mật khẩu):
    tránh trường hợp bấm gửi khi con trỏ còn trong ô nên model vẫn rỗng.
    Vẫn giữ đầy đủ kiểm tra dữ liệu và lớp CSS "invalid" của EditForm.
*@
<input @attributes="AdditionalAttributes"
       class="@CssClass"
       value="@CurrentValueAsString"
       @oninput="OnInput"
       @ref="Element" />

@code {
    private void OnInput(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }
}
