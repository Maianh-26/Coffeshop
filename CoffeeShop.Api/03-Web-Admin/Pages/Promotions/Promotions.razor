@page "/promotions"
@attribute [Authorize(Roles = Roles.Admin)]
@implements IDisposable
@inject PromotionService PromotionApi
@inject ProductService ProductApi

<PageTitle>Khuyến mãi - Coffee Shop</PageTitle>

<div class="promotions-page">

    <section class="panel filters-panel">

        <div class="filter-row">

            <div class="search-field">

                <Icon Name="search" />

                <input @bind="search"
                       @bind:event="oninput"
                       @bind:after="Filter"
                       placeholder="Tìm mã khuyến mãi"
                       aria-label="Tìm khuyến mãi" />

            </div>

            <select aria-label="Lọc trạng thái" @bind="statusFilter" @bind:after="Filter">
                <option value="">Tất cả trạng thái</option>
                <option>Đang áp dụng</option>
                <option>Ngoài khung giờ</option>
                <option>Chưa bắt đầu</option>
                <option>Đã kết thúc</option>
            </select>

            <button class="btn outline"
                    @onclick="Reset">

                <Icon Name="reset" />
                Đặt lại

            </button>

        </div>

    </section>

    <section class="panel action-bar">

        <button class="btn primary"
                @onclick="Add">

            <Icon Name="plus" />
            Thêm khuyến mãi

        </button>

        <button class="btn outline"
                disabled="@(Selected is null)"
                @onclick="Edit">

            <Icon Name="edit" />
            Sửa

        </button>

        <button class="btn danger-outline"
                disabled="@(Selected is null)"
                @onclick="AskDelete">

            <Icon Name="trash" />
            Xóa

        </button>

    </section>

    @if (message is not null)
    {
        <p class="alert success" role="status">
            @message
        </p>
    }

    @if (loadError is not null)
    {
        <p class="alert error" role="alert">
            @loadError
            <button type="button" class="text-button" @onclick="Load">Thử lại</button>
        </p>
    }

    <section class="panel list-panel">

        <div class="table-wrap">

            <table>

                <thead>

                    <tr>
                        <th>Mã KM</th>
                        <th>Giảm giá</th>
                        <th>Bắt đầu</th>
                        <th>Kết thúc</th>
                        <th>Giờ vàng</th>
                        <th>Số món</th>
                        <th>Trạng thái</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in VisiblePromotions)
                    {
                        string status = StatusText(item);

                        <tr class="selectable @(selected == item.MaKhuyenMai ? "selected" : "")"
                            tabindex="0"
                            @onclick="() => selected = item.MaKhuyenMai"
                            @onkeydown="e => SelectKey(e, item.MaKhuyenMai)">

                            <td><strong>@item.Code</strong></td>
                            <td>@item.PhanTramGiam.ToString("0.##", Vi)%</td>
                            <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                            <td>@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                            <td>@(item.GioBatDau is null ? "Cả ngày" : $"{item.GioBatDau} – {item.GioKetThuc}")</td>
                            <td>@item.SoMonApDung</td>

                            <td>
                                <span class="badge @StatusColor(status)">
                                    @status
                                </span>
                            </td>

                        </tr>
                    }

                    @if (VisiblePromotions.Count == 0)
                    {
                        <tr>

                            <td class="empty-cell" colspan="7">

                                <Icon Name="tag" Size="32" />

                                <p>
                                    @(loading ? "Đang tải khuyến mãi…" : "Chưa có chương trình khuyến mãi phù hợp.")
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="list-footer">

            <span>
                @FilteredPromotions.Count() khuyến mãi
                · Trang @(page)/@Pages
            </span>

            <div class="pagination">

                <button class="page-button"
                        aria-label="Trang trước"
                        disabled="@(page <= 1)"
                        @onclick="() => Move(-1)">
                    <Icon Name="left" Size="16" />
                </button>

                <span class="page-number">@(page)</span>

                <button class="page-button"
                        aria-label="Trang sau"
                        disabled="@(page >= Pages)"
                        @onclick="() => Move(1)">
                    <Icon Name="right" Size="16" />
                </button>

            </div>

        </div>

    </section>

</div>

@if (dialog != "")
{
    <Modal Title="@DialogTitle"
           OnClose="Close"
           Busy="@saving">

        @if (dialog is "form")
        {
            <EditForm Model="model"
                      OnValidSubmit="Save">

                <DataAnnotationsValidator />

                <div class="form-grid">

                    <div class="field">
                        <label for="pm-code">Mã khuyến mãi *</label>
                        <InputText id="pm-code"
                                   @bind-Value="model.Code"
                                   placeholder="ví dụ: GIOVANG20" />
                        <ValidationMessage For="@(() => model.Code)" />
                    </div>

                    <div class="field">
                        <label for="pm-discount">Giảm giá (%) *</label>
                        <InputNumber id="pm-discount"
                                     @bind-Value="model.PhanTramGiam"
                                     step="1" />
                        <ValidationMessage For="@(() => model.PhanTramGiam)" />
                    </div>

                    <div class="field">
                        <label for="pm-start">Ngày bắt đầu *</label>
                        <InputDate id="pm-start"
                                   @bind-Value="model.NgayBatDau" />
                        <ValidationMessage For="@(() => model.NgayBatDau)" />
                    </div>

                    <div class="field">
                        <label for="pm-end">Ngày kết thúc *</label>
                        <InputDate id="pm-end"
                                   @bind-Value="model.NgayKetThuc" />
                        <ValidationMessage For="@(() => model.NgayKetThuc)" />
                    </div>

                    <div class="field">
                        <label for="pm-from">Giờ vàng từ</label>
                        <InputDate id="pm-from"
                                   Type="InputDateType.Time"
                                   @bind-Value="model.GioBatDau" />
                    </div>

                    <div class="field">
                        <label for="pm-to">Đến</label>
                        <InputDate id="pm-to"
                                   Type="InputDateType.Time"
                                   @bind-Value="model.GioKetThuc" />
                        <ValidationMessage For="@(() => model.GioKetThuc)" />
                    </div>

                </div>

                <p class="form-note">Bỏ trống giờ vàng nếu khuyến mãi áp dụng cả ngày.</p>

                <fieldset class="field">
                    <legend>Món áp dụng (@model.MaTenMons.Count)</legend>

                    @if (products.Count == 0)
                    {
                        <p class="form-note">@(productsError ?? "Chưa có món nào.")</p>
                    }
                    else
                    {
                        <div class="toppings-picker-grid">
                            @foreach (var mon in products)
                            {
                                var other = mon.KhuyenMai is { } km && km.MaKhuyenMai != model.MaKhuyenMai ? km.Code : null;

                                <label class="topping-checkbox-item">
                                    <input type="checkbox"
                                           checked="@model.MaTenMons.Contains(mon.MaTenMon)"
                                           @onchange="e => ToggleProduct(mon.MaTenMon, e)" />
                                    <span>
                                        @mon.TenMon
                                        @if (other is not null)
                                        {
                                            <small class="muted"> (đang thuộc @other)</small>
                                        }
                                    </span>
                                </label>
                            }
                        </div>

                        <p class="form-note">Mỗi món chỉ thuộc một khuyến mãi — chọn món đang thuộc khuyến mãi khác sẽ chuyển món sang khuyến mãi này.</p>
                    }
                </fieldset>

                @if (error is not null)
                {
                    <p class="alert error" role="alert">@error</p>
                }

                <div class="modal-footer">

                    <button type="button" class="btn outline"
                            disabled="@saving"
                            @onclick="Close">
                        Hủy
                    </button>

                    <button type="submit" class="btn primary" disabled="@(saving || productsLoading)">
                        @(saving ? "Đang lưu…"
                            : editing ? "Lưu thay đổi"
                            : "Thêm khuyến mãi")
                    </button>

                </div>

            </EditForm>
        }

        @if (dialog == "delete" && Selected is { } target)
        {
            <p>Xóa khuyến mãi <strong>@target.Code</strong>?</p>

            <p class="form-note">
                @(target.SoMonApDung > 0
                    ? $"{target.SoMonApDung} món đang áp dụng sẽ được gỡ khuyến mãi và trở về giá gốc."
                    : "Khuyến mãi chưa gắn với món nào.")
            </p>

            @if (error is not null)
            {
                <p class="alert error" role="alert">@error</p>
            }

            <div class="modal-footer">

                <button class="btn outline" disabled="@saving" @onclick="Close">
                    Hủy
                </button>

                <button class="btn danger" disabled="@saving" @onclick="Delete">
                    @(saving ? "Đang xóa…" : "Xóa khuyến mãi")
                </button>

            </div>
        }

    </Modal>
}

@code {
    private static readonly System.Globalization.CultureInfo Vi = new("vi-VN");

    private readonly CancellationTokenSource pageCts = new();

    private List<KhuyenMai> promotions = [];
    private List<Mon> products = [];
    private string? productsError;

    // Danh sách món chưa tải xong → KHÔNG được gửi maTenMons (backend sẽ coi là "gỡ hết món")
    private bool productsLoading;
    private bool productsReady;

    // Món đã ngừng bán đang gắn khuyến mãi này: không hiện trong ô chọn nhưng phải giữ khi lưu
    private List<int> stoppedProductIds = [];

    private string search = "";
    private string statusFilter = "";
    private int? selected;
    private int page = 1;
    private const int PageSize = 10;

    private string dialog = "";
    private bool editing;
    private bool loading;
    private bool saving;
    private string? error;
    private string? loadError;
    private string? message;

    private KhuyenMaiForm model = new();

    private KhuyenMai? Selected => promotions.FirstOrDefault(p => p.MaKhuyenMai == selected);

    private string DialogTitle => dialog switch
    {
        "form" => editing ? "Sửa khuyến mãi" : "Thêm khuyến mãi",
        "delete" => "Xóa khuyến mãi",
        _ => ""
    };

    private IEnumerable<KhuyenMai> FilteredPromotions =>
        promotions.Where(p =>
            (search == "" || p.Code.Contains(search, StringComparison.OrdinalIgnoreCase))
            && (statusFilter == "" || StatusText(p) == statusFilter));

    private List<KhuyenMai> VisiblePromotions =>
        FilteredPromotions
            .Skip((page - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int Pages => Math.Max(1, (int)Math.Ceiling(FilteredPromotions.Count() / (double)PageSize));

    /// <summary>
    /// DangApDung do backend tính (ngày + khung giờ); các trạng thái còn lại suy ra từ ngày.
    /// </summary>
    private static string StatusText(KhuyenMai p)
    {
        var now = DateTime.Now;

        if (p.DangApDung) return "Đang áp dụng";
        if (now > p.NgayKetThuc) return "Đã kết thúc";
        if (now < p.NgayBatDau) return "Chưa bắt đầu";
        return "Ngoài khung giờ";
    }

    private static string StatusColor(string status) => status switch
    {
        "Đang áp dụng" => "green",
        "Đã kết thúc" => "gray",
        _ => "yellow"
    };

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        loading = true;
        loadError = null;

        try
        {
            promotions = await PromotionApi.GetAllAsync(pageCts.Token);
            page = Math.Clamp(page, 1, Pages);
        }
        catch (ApiException ex)
        {
            loadError = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>Danh sách món cho ô "Món áp dụng" (tải lại mỗi lần mở form để thấy khuyến mãi hiện tại của món).</summary>
    private async Task LoadProducts()
    {
        productsError = null;
        productsReady = false;
        productsLoading = true;
        products = [];
        stoppedProductIds = [];

        try
        {
            var all = await ProductApi.GetAllAsync(pageCts.Token);

            products = all.Where(m => !m.NgungBan).OrderBy(m => m.TenMon).ToList();
            stoppedProductIds = all
                .Where(m => m.NgungBan && m.KhuyenMai is { } km && km.MaKhuyenMai == model.MaKhuyenMai && model.MaKhuyenMai != 0)
                .Select(m => m.MaTenMon)
                .ToList();
            productsReady = true;
        }
        catch (ApiException ex)
        {
            productsError = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            productsLoading = false;
        }
    }

    private void Filter() => page = 1;

    private void Reset()
    {
        search = "";
        statusFilter = "";
        page = 1;
    }

    private void Move(int direction)
    {
        int next = page + direction;
        if (next >= 1 && next <= Pages) page = next;
    }

    private void SelectKey(KeyboardEventArgs e, int id)
    {
        if (e.Key is "Enter" or " ") selected = id;
    }

    private async Task Add()
    {
        editing = false;
        error = null;
        message = null;
        model = new KhuyenMaiForm { NgayBatDau = DateTime.Today, NgayKetThuc = DateTime.Today.AddDays(7) };
        dialog = "form";
        await LoadProducts();
    }

    private async Task Edit()
    {
        if (Selected is not { } source) return;

        editing = true;
        error = null;
        message = null;
        model = new KhuyenMaiForm
        {
            MaKhuyenMai = source.MaKhuyenMai,
            Code = source.Code,
            PhanTramGiam = source.PhanTramGiam,
            NgayBatDau = source.NgayBatDau.Date,
            NgayKetThuc = source.NgayKetThuc.Date,
            GioBatDau = ParseTime(source.GioBatDau),
            GioKetThuc = ParseTime(source.GioKetThuc)
        };
        dialog = "form";

        await LoadProducts();
        model.MaTenMons = products
            .Where(m => m.KhuyenMai?.MaKhuyenMai == source.MaKhuyenMai)
            .Select(m => m.MaTenMon)
            .ToHashSet();
    }

    private static TimeOnly? ParseTime(string? hhmm) =>
        TimeOnly.TryParseExact(hhmm, "HH:mm", out var t) ? t : null;

    private void ToggleProduct(int id, ChangeEventArgs e)
    {
        if (e.Value is true) model.MaTenMons.Add(id);
        else model.MaTenMons.Remove(id);
    }

    private void AskDelete()
    {
        if (Selected is null) return;

        error = null;
        message = null;
        dialog = "delete";
    }

    private void Close()
    {
        if (saving) return;

        dialog = "";
        error = null;
    }

    private async Task Save()
    {
        if (saving || productsLoading) return;

        saving = true;
        error = null;

        // Ngày chọn trên form là giờ địa phương "không múi giờ" — tránh gửi kèm +07:00
        static DateTime Plain(DateTime d) => DateTime.SpecifyKind(d, DateTimeKind.Unspecified);

        var request = new KhuyenMaiRequest
        {
            Code = model.Code.Trim().ToUpperInvariant(),
            PhanTramGiam = model.PhanTramGiam,
            NgayBatDau = Plain(model.NgayBatDau!.Value.Date),
            NgayKetThuc = Plain(model.NgayKetThuc!.Value.Date.AddDays(1).AddSeconds(-1)),
            GioBatDau = model.GioBatDau?.ToString("HH:mm"),
            GioKetThuc = model.GioKetThuc?.ToString("HH:mm"),
            // Chưa tải được danh sách món → gửi null = giữ nguyên món áp dụng (không gỡ hết).
            // Có danh sách → món đã chọn + món ngừng bán đang gắn khuyến mãi này (không để mất).
            MaTenMons = productsReady ? model.MaTenMons.Concat(stoppedProductIds).Distinct().ToList() : null
        };

        try
        {
            var saved = editing
                ? await PromotionApi.UpdateAsync(model.MaKhuyenMai, request, pageCts.Token)
                : await PromotionApi.CreateAsync(request, pageCts.Token);

            message = editing ? $"Đã cập nhật khuyến mãi {saved.Code}." : $"Đã thêm khuyến mãi {saved.Code}.";
            selected = saved.MaKhuyenMai;
            dialog = "";
            await Load();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            saving = false;
        }
    }

    private async Task Delete()
    {
        if (saving || Selected is not { } target) return;

        saving = true;
        error = null;

        try
        {
            await PromotionApi.DeleteAsync(target.MaKhuyenMai, pageCts.Token);
            message = $"Đã xóa khuyến mãi {target.Code}.";
            selected = null;
            dialog = "";
            await Load();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            saving = false;
        }
    }

    public void Dispose()
    {
        pageCts.Cancel();
        pageCts.Dispose();
    }
}
