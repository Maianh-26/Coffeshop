@page "/orders"
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@inject OrderService OrderApi
@inject ProductService ProductApi
@inject ToppingService ToppingApi
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IServiceProvider Services
@inject ILogger<Orders> Logger

<PageTitle>Đơn hàng - Coffee Shop</PageTitle>

<!-- Banner thông báo kết quả thao tác / đơn mới -->
@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="alert @alertType alert-dismissible" role="status">
        <div>
            <span>@alertMessage</span>

            @if (stockWarnings.Count > 0)
            {
                <ul class="alert-list">
                    @foreach (var w in stockWarnings)
                    {
                        <li>@w.TenNguyenLieu chỉ còn @Number(w.SoLuongTon) @w.DonViTinh (mức cảnh báo @Number(w.MucCanhBaoToiThieu))</li>
                    }
                </ul>
            }
        </div>

        <button type="button" class="icon-button" aria-label="Đóng thông báo" @onclick="ClearAlert">
            <Icon Name="close" Size="14" />
        </button>
    </div>
}

<div class="orders-page master-detail-layout @(SelectedOrder != null ? "has-detail" : "")">

    <!-- Cột trái: Bộ lọc, Thanh tác vụ và Danh sách đơn hàng -->
    <div class="master-panel">

        <section class="panel filters-panel">

            <div class="filter-row">

                <div class="search-field">

                    <Icon Name="search" />

                    @* Chỉ tìm theo cột đang hiển thị: mã đơn hoặc số nhận món (chỉ nhận chữ số) *@
                    <input value="@search"
                           @oninput="OnSearchInput"
                           inputmode="numeric"
                           maxlength="10"
                           placeholder="Tìm mã đơn hoặc số nhận món…"
                           aria-label="Tìm trong trang hiện tại theo mã đơn hoặc số nhận món (chỉ nhập số)" />

                </div>

                <div class="date-range">

                    <input type="date"
                           aria-label="Từ ngày"
                           @bind="fromDate"
                           @bind:after="ApplyFilter" />

                    <span>–</span>

                    <input type="date"
                           aria-label="Đến ngày"
                           @bind="toDate"
                           @bind:after="ApplyFilter" />

                </div>

                <select aria-label="Lọc trạng thái phục vụ" @bind="statusFilter" @bind:after="ApplyFilter">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var s in ServingFilters)
                    {
                        <option value="@s" disabled="@(!servingSupported && s != TrangThaiPhucVus.CancelledFilter)">@TrangThaiPhucVus.Label(s)</option>
                    }
                </select>

                <select aria-label="Lọc thanh toán"
                        @bind="paymentFilter"
                        @bind:after="ApplyFilter"
                        disabled="@(statusFilter == TrangThaiPhucVus.CancelledFilter)"
                        title="@(statusFilter == TrangThaiPhucVus.CancelledFilter ? "Đơn đã hủy không lọc theo thanh toán" : null)">
                    <option value="">Tất cả thanh toán</option>
                    <option value="@TrangThaiDon.Pending">@TrangThaiDon.Label(TrangThaiDon.Pending)</option>
                    <option value="@TrangThaiDon.Paid">@TrangThaiDon.Label(TrangThaiDon.Paid)</option>
                </select>

                <button class="btn outline"
                        @onclick="Reset">

                    <Icon Name="reset" />
                    Đặt lại

                </button>

            </div>

        </section>

        <!-- Thanh thao tác: Tạo đơn tại quầy và tự động làm mới -->
        <section class="panel action-bar action-bar-split">

            <div class="action-group">

                <button class="btn primary"
                        @onclick="OpenCreateOrder">

                    <Icon Name="plus" />
                    Tạo đơn tại quầy

                </button>

                <button class="btn outline"
                        disabled="@(SelectedOrder is not { CoTheSua: true })"
                        title="@(SelectedOrder is { CoTheSua: false } ? "Chỉ sửa được đơn chưa thanh toán và chưa phục vụ" : "Sửa món trong đơn đang chọn")"
                        @onclick="OpenEditOrder">

                    <Icon Name="edit" />
                    Sửa đơn

                </button>

                @if (IsAdmin)
                {
                    <button class="btn danger-outline"
                            disabled="@(SelectedOrder is not { TrangThaiThanhToan: not TrangThaiDon.Cancelled })"
                            @onclick="OpenCancelOrder">

                        <Icon Name="trash" />
                        Hủy đơn

                    </button>
                }

            </div>

            <!-- Tự động tải lại danh sách để thấy đơn mới từ Tablet -->
            <div class="realtime-controls">

                <button type="button"
                        class="realtime-pill @(!autoRefreshEnabled ? "paused" : "")"
                        @onclick="ToggleAutoRefresh"
                        aria-pressed="@autoRefreshEnabled"
                        title="Bật/Tắt tự động tải đơn mới từ Tablet (mỗi @RefreshSeconds giây)">

                    <span class="live-indicator" aria-hidden="true"></span>
                    <span>@(autoRefreshEnabled ? "Tự động cập nhật: Bật" : "Tự động cập nhật: Tắt")</span>

                </button>

                @* Công cụ thử nghiệm — chỉ hiện khi chạy với dữ liệu giả *@
                @if (IsMock)
                {
                    <button class="btn outline btn-compact"
                            disabled="@loading"
                            @onclick="SimulateTabletOrder"
                            title="Mô phỏng khách bấm gửi đơn trên Tablet">

                        <Icon Name="cup" Size="14" />
                        Mô phỏng đơn từ Tablet

                    </button>
                }

            </div>

        </section>

        @if (loadError is not null)
        {
            <p class="alert error" role="alert">
                @loadError
                <button type="button" class="text-button" @onclick="() => LoadOrders()">Thử lại</button>
            </p>
        }

        <!-- Danh sách đơn hàng -->
        <section class="panel list-panel">

            <div class="table-wrap">

                <table class="orders-table">

                    <thead>

                        <tr>
                            <th>Mã đơn</th>
                            <th>Nguồn</th>
                            <th>Thời gian tạo</th>
                            <th>Tổng tiền</th>
                            <th>Số nhận món</th>
                            <th>Thanh toán</th>
                            <th>Trạng thái</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var order in VisibleOrders)
                        {
                            <tr class="selectable @(selectedId == order.MaDonHang ? "selected" : "")"
                                tabindex="0"
                                @onclick="() => SelectOrder(order.MaDonHang)"
                                @onkeydown="e => SelectKey(e, order.MaDonHang)">

                                <td>
                                    <strong>#@order.MaDonHang</strong>
                                </td>

                                <td>
                                    <span class="badge @(order.MaNguoiDung is null ? "purple" : "gray")">
                                        @order.Nguon
                                    </span>
                                </td>

                                <td>
                                    @order.ThoiGianTao.ToString("HH:mm · dd/MM")
                                </td>

                                <td>
                                    <strong class="text-accent">@Money(order.TongTien)</strong>
                                </td>

                                <td>
                                    @if (order.SoNhanMon is { } so)
                                    {
                                        <span class="pickup-number">@so</span>
                                    }
                                    else
                                    {
                                        <span class="muted">Chưa nhập</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge @PhuongThucThanhToans.SummaryColor(order)">
                                        @PhuongThucThanhToans.Summary(order)
                                    </span>
                                </td>

                                <td>
                                    @if (servingSupported || order.DaHuy)
                                    {
                                        <span class="badge @TrangThaiPhucVus.Color(order)">
                                            @TrangThaiPhucVus.Label(order)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="muted" title="Máy chủ chưa có trạng thái phục vụ">—</span>
                                    }
                                </td>

                            </tr>
                        }

                        @if (VisibleOrders.Count == 0)
                        {
                            <tr>

                                <td class="empty-cell" colspan="7">

                                    <Icon Name="orders" Size="32" />

                                    <p>
                                        @(loading && orders.Count == 0
                                            ? "Đang tải đơn hàng…"
                                            : "Không tìm thấy đơn hàng nào phù hợp với bộ lọc.")
                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="list-footer">

                <span>
                    @totalOrders đơn hàng
                    @(SelectedOrder == null ? "· Nhấp vào đơn hàng để xem chi tiết" : "")
                    · Trang @(page)/@totalPages
                </span>

                <div class="pagination">

                    <button class="page-button"
                            aria-label="Trang trước"
                            disabled="@(page <= 1 || loading)"
                            @onclick="() => Move(-1)">

                        <Icon Name="left" Size="16" />

                    </button>

                    <span class="page-number">
                        @(page)
                    </span>

                    <button class="page-button"
                            aria-label="Trang sau"
                            disabled="@(page >= totalPages || loading)"
                            @onclick="() => Move(1)">

                        <Icon Name="right" Size="16" />

                    </button>

                </div>

            </div>

        </section>

    </div>

    <!-- Cột phải: chi tiết đơn hàng (chỉ hiển thị khi đã chọn 1 đơn) -->
    @if (SelectedOrder is { } detail)
    {
        <aside class="detail-panel panel">

            <div class="order-detail-header">
                <div>
                    <h3>Đơn hàng #@detail.MaDonHang</h3>
                    <div class="order-badges">
                        <span class="badge @TrangThaiPhucVus.Color(detail)">
                            @TrangThaiPhucVus.Label(detail)
                        </span>
                        <span class="badge @PhuongThucThanhToans.SummaryColor(detail)">
                            @PhuongThucThanhToans.Summary(detail)
                        </span>
                        <span class="badge @(detail.MaNguoiDung is null ? "purple" : "gray")">
                            @detail.Nguon
                        </span>
                        @if (detail.DaHoanTien)
                        {
                            <span class="badge yellow">Đã hoàn tiền</span>
                        }
                    </div>
                </div>

                <button type="button"
                        class="icon-button"
                        aria-label="Đóng chi tiết"
                        title="Đóng khung chi tiết"
                        @onclick="CloseDetail">
                    <Icon Name="close" Size="20" />
                </button>
            </div>

            <!-- Thông tin tổng quan đơn hàng -->
            <div class="order-meta-info">
                <div class="meta-item">
                    <span class="meta-label">Thời gian tạo:</span>
                    <span class="meta-val">@detail.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Người tạo đơn:</span>
                    <span class="meta-val">@(detail.TenNhanVien ?? "Khách tự đặt trên Tablet")</span>
                </div>
                @if (detail.LyDoHuy is not null)
                {
                    <div class="meta-item">
                        <span class="meta-label">Lý do hủy:</span>
                        <span class="meta-val text-danger">@detail.LyDoHuy</span>
                    </div>
                }

                @if (detail.GioHoanTien.HasValue)
                {
                    <div class="meta-item">
                        <span class="meta-label">Hoàn tiền lúc:</span>
                        <span class="meta-val">@detail.GioHoanTien.Value.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                }
            </div>

            <!-- NGHIỆP VỤ: SỐ NHẬN MÓN & PHỤC VỤ -->
            @if (!servingSupported)
            {
                <p class="form-note serving-box">
                    Số nhận món và trạng thái phục vụ chưa dùng được: máy chủ chưa hỗ trợ (đã đề xuất với nhóm backend).
                </p>
            }
            else
            {
            <div class="serving-box">
                <div class="field">
                    <label for="pickup-number">Số nhận món (bảng gỗ @SoNhanMons.Min–@SoNhanMons.Max)</label>

                    @if (detail.DangPhucVu)
                    {
                        <div class="pickup-input-row">
                            <input id="pickup-number"
                                   type="number"
                                   inputmode="numeric"
                                   min="@SoNhanMons.Min"
                                   max="@SoNhanMons.Max"
                                   placeholder="1–50"
                                   aria-describedby="pickup-hint@(servingError is null ? "" : " serving-error")"
                                   value="@pickupInput"
                                   @oninput="OnPickupInput"
                                   @onkeydown="PickupKeyDown"
                                   disabled="@servingBusy" />

                            <button type="button"
                                    class="btn outline"
                                    disabled="@(servingBusy || pickupInput == detail.SoNhanMon)"
                                    @onclick="() => SavePickupNumber(detail)">
                                @(detail.SoNhanMon is null ? "Lưu số" : "Đổi số")
                            </button>
                        </div>

                        @if (servingError is not null)
                        {
                            <p id="serving-error" class="alert error" role="alert">@servingError</p>
                        }

                        <p id="pickup-hint" class="form-note">Số đang gắn với đơn chưa phục vụ xong sẽ bị khóa, chỉ giải phóng khi xác nhận đã phục vụ.</p>
                    }
                    else
                    {
                        <p class="pickup-readonly">
                            @if (detail.SoNhanMon is { } so)
                            {
                                <span class="pickup-number">@so</span>
                                <span class="muted">@(detail.DaHuy ? "Đơn đã hủy — số đã được giải phóng." : "Đã phục vụ — số đã được giải phóng.")</span>
                            }
                            else
                            {
                                <span class="muted">Không nhập số nhận món.</span>
                            }
                        </p>
                    }
                </div>

                @if (detail.DangPhucVu && confirmServeUnpaidId == detail.MaDonHang)
                {
                    @* Phục vụ khi chưa thu tiền là thao tác không hoàn tác (giải phóng số) → hỏi lại *@
                    <div class="confirm-inline" role="alertdialog" aria-labelledby="serve-unpaid-msg">
                        <p id="serve-unpaid-msg">
                            Đơn <strong>#@detail.MaDonHang</strong> <strong>chưa thanh toán</strong>. Vẫn xác nhận đã phục vụ?
                            @(detail.SoNhanMon is { } holding ? $" Số {holding} sẽ được giải phóng." : "")
                        </p>
                        <div class="serving-actions">
                            <button type="button" class="btn outline" disabled="@servingBusy" @onclick="() => confirmServeUnpaidId = null">
                                Quay lại
                            </button>
                            <button type="button" class="btn btn-success" disabled="@servingBusy"
                                    @onclick="() => SetServing(detail, TrangThaiPhucVus.Served, confirmed: true)">
                                Vẫn xác nhận đã phục vụ
                            </button>
                        </div>
                    </div>
                }
                else if (detail.DangPhucVu)
                {
                    <div class="serving-actions">
                        @if (detail.PhucVu == TrangThaiPhucVus.Waiting)
                        {
                            <button type="button"
                                    class="btn outline"
                                    disabled="@servingBusy"
                                    @onclick="() => SetServing(detail, TrangThaiPhucVus.Preparing)">
                                <Icon Name="cup" Size="16" />
                                Bắt đầu chuẩn bị
                            </button>
                        }

                        <button type="button"
                                class="btn btn-success"
                                disabled="@servingBusy"
                                @onclick="() => SetServing(detail, TrangThaiPhucVus.Served)">
                            <Icon Name="check" Size="16" />
                            Xác nhận đã phục vụ
                        </button>
                    </div>
                }

                @if (servingError is not null && !detail.DangPhucVu)
                {
                    <p class="alert error" role="alert">@servingError</p>
                }
            </div>
            }

            <!-- Danh sách món: tên + size, topping, ghi chú, giá -->
            <div class="order-items-section">
                <h4>Chi tiết món đã đặt (@detail.SoPhan phần)</h4>

                <div class="order-items-list">
                    @foreach (var item in detail.ChiTiet ?? [])
                    {
                        <div class="order-item-card">
                            <div class="item-main-row">
                                <span class="item-name">@item.TenMonLuu</span>
                                <span class="item-qty">x@(item.SoLuong)</span>
                                <span class="item-total">@Money(item.ThanhTien)</span>
                            </div>

                            <div class="item-options">
                                <div class="option-row">
                                    <span class="opt-label">Topping:</span>
                                    @if (item.Toppings.Count > 0)
                                    {
                                        <div class="toppings-tags">
                                            @foreach (var top in item.Toppings)
                                            {
                                                <span class="topping-pill">
                                                    + @top.TenToppingLuu
                                                    <strong>(+@Money(top.DonGiaTopping))</strong>
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="opt-muted">Không chọn thêm</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.GhiChu))
                                {
                                    <div class="option-row">
                                        <span class="opt-label">Ghi chú:</span>
                                        <span class="opt-note-text">@item.GhiChu</span>
                                    </div>
                                }

                                <div class="item-unit-calc">
                                    Đơn giá: @Money(item.DonGiaBan)
                                    @if (item.Toppings.Count > 0)
                                    {
                                        <span> + topping @Money(item.Toppings.Sum(t => t.DonGiaTopping))</span>
                                    }
                                    <span> / phần</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Tổng tiền -->
            <div class="order-summary-box">
                <div class="summary-line total-line">
                    <strong>Tổng tiền hóa đơn</strong>
                    <strong class="grand-total">@Money(detail.TongTien)</strong>
                </div>
                <p class="form-note">Giá đã gồm khuyến mãi của món tại thời điểm đặt.</p>
            </div>

            <!-- NGHIỆP VỤ: THANH TOÁN -->
            <div class="order-action-group">

                @if (detail.TrangThaiThanhToan == TrangThaiDon.Pending)
                {
                    @* Đơn giản hóa: không nhập "tiền khách đưa" — nhân viên chỉ xác nhận đã thu đủ.
                       Khách chuyển khoản trên tablet → cổng thanh toán báo về, đơn tự sang "Đã thanh toán". *@
                    <div class="pay-box">
                        <div class="pay-box-head">
                            <span>Cần thu (@PhuongThucThanhToans.Label(payMethod))</span>
                            <strong class="grand-total small">@Money(detail.TongTien)</strong>
                        </div>

                        @if (payMethod == PhuongThucThanhToans.QrTransfer)
                        {
                            <p class="form-note">
                                Khách chuyển khoản trên tablet: hệ thống tự cập nhật "Đã thanh toán" khi nhận được tiền.
                                Chỉ bấm xác nhận khi đã kiểm tra tài khoản nhận được tiền (nội dung: <strong>COFFEE @detail.MaDonHang</strong>).
                            </p>
                        }

                        <button type="button"
                                class="btn btn-success btn-large"
                                disabled="@paying"
                                @onclick="() => Pay(detail)">
                            <Icon Name="@(payMethod == PhuongThucThanhToans.Cash ? "coins" : "check")" Size="18" />
                            @(paying
                                ? "Đang xác nhận…"
                                : payMethod == PhuongThucThanhToans.Cash ? "Xác nhận đã thu tiền mặt" : "Xác nhận đã nhận chuyển khoản")
                        </button>

                        <button type="button"
                                class="text-button"
                                disabled="@paying"
                                @onclick="SwitchPayMethod">
                            Khách đổi sang @(payMethod == PhuongThucThanhToans.Cash
                                ? PhuongThucThanhToans.Label(PhuongThucThanhToans.QrTransfer).ToLowerInvariant()
                                : PhuongThucThanhToans.Label(PhuongThucThanhToans.Cash).ToLowerInvariant())
                        </button>
                    </div>

                    @if (payError is not null)
                    {
                        <p class="alert error" role="alert">@payError</p>
                    }
                }

                <!-- Các nút hành động phụ -->
                <div class="detail-actions">
                    <button type="button"
                            class="btn primary"
                            disabled="@detail.DaHuy"
                            title="@(detail.DaHuy ? "Đơn đã hủy, không in hóa đơn" : "In hóa đơn cho khách")"
                            @onclick="PrintReceipt">
                        <Icon Name="printer" Size="16" />
                        In hóa đơn
                    </button>

                    <button type="button"
                            class="btn outline"
                            @onclick="CloseDetail">
                        Đóng chi tiết
                    </button>
                </div>

            </div>

        </aside>
    }

</div>

<!-- ========================================================================= -->
<!-- MODAL TẠO ĐƠN TẠI QUẦY -->
<!-- ========================================================================= -->
@if (isOrderModalOpen)
{
    <Modal Title="@(editingOrderId is { } editId ? $"Sửa đơn hàng #{editId}" : "Tạo đơn hàng tại quầy")"
           OnClose="CloseOrderModal"
           Busy="@creating">

        <div class="order-modal-builder">

            @if (menuError is not null)
            {
                <p class="alert error" role="alert">@menuError</p>
            }

            <div class="form-grid">
                <div class="field">
                    <label for="order-payment">Hình thức thanh toán</label>
                    <select id="order-payment" @bind="draftPaymentMethod">
                        <option value="@PhuongThucThanhToans.Cash">@PhuongThucThanhToans.Label(PhuongThucThanhToans.Cash)</option>
                        <option value="@PhuongThucThanhToans.QrTransfer">@PhuongThucThanhToans.Label(PhuongThucThanhToans.QrTransfer)</option>
                    </select>
                </div>
            </div>

            <!-- Bộ công cụ thêm món vào đơn -->
            <div class="item-builder-card">
                <strong class="builder-title">Thêm món & topping vào đơn</strong>

                <div class="form-grid">
                    <div class="field">
                        <label for="builder-product">Chọn món</label>
                        <select id="builder-product" @bind="builderProductId" @bind:after="OnBuilderProductChanged">
                            @if (menuLoading)
                            {
                                <option value="0">Đang tải thực đơn…</option>
                            }
                            @foreach (var prod in menu)
                            {
                                <option value="@prod.MaTenMon">@prod.TenMon</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="builder-size">Kích cỡ</label>
                        <select id="builder-size" @bind="builderSizeId">
                            @foreach (var s in BuilderSizes)
                            {
                                <option value="@s.MaChiTietMon">
                                    @s.TenKichThuoc — @Money(s.GiaSauGiam)@(s.GiaSauGiam < s.GiaBan ? $" (gốc {Money(s.GiaBan)})" : "")
                                </option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="builder-quantity">Số lượng</label>
                        <input id="builder-quantity" type="number" min="1" max="50" @bind="builderQuantity" />
                    </div>

                    <div class="field">
                        <label for="builder-note">Ghi chú món</label>
                        <input id="builder-note" maxlength="255" @bind="builderNote" placeholder="70% đường, ít đá…" />
                    </div>
                </div>

                @if (availableToppings.Count > 0)
                {
                    <fieldset class="field">
                        <legend>Topping thêm (mỗi loại 1 phần/ly)</legend>
                        <div class="toppings-picker-grid">
                            @foreach (var top in availableToppings)
                            {
                                <label class="topping-checkbox-item">
                                    <input type="checkbox"
                                           checked="@selectedToppingIds.Contains(top.MaTopping)"
                                           @onchange="e => ToggleTopping(top.MaTopping, e)" />
                                    <span>@top.TenTopping (+@Money(top.GiaThem))</span>
                                </label>
                            }
                        </div>
                    </fieldset>
                }

                <div class="builder-actions">
                    <button type="button" class="btn outline" disabled="@(BuilderSize is null)" @onclick="AddItemToDraft">
                        <Icon Name="plus" Size="14" />
                        Thêm món này vào đơn
                    </button>
                </div>
            </div>

            <!-- Bảng các món trong đơn đang tạo -->
            <div>
                <strong class="builder-title">Các món trong đơn (@draftLines.Count):</strong>

                <div class="table-wrap builder-items-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Món & size</th>
                                <th>Topping</th>
                                <th>Đơn giá</th>
                                <th>SL</th>
                                <th>Thành tiền</th>
                                <th><span class="sr-only">Bỏ món</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in draftLines)
                            {
                                <tr>
                                    <td>
                                        <strong>@line.TenMon</strong>
                                        <div class="muted">@line.TenKichThuoc@(string.IsNullOrWhiteSpace(line.GhiChu) ? "" : $" · {line.GhiChu}")</div>
                                    </td>
                                    <td>
                                        @(line.Toppings.Count > 0 ? string.Join(", ", line.Toppings.Select(t => t.TenTopping)) : "Không")
                                    </td>
                                    <td>@Money(line.DonGia)</td>
                                    <td><strong>@line.SoLuong</strong></td>
                                    <td><strong class="text-accent">@Money(line.ThanhTien)</strong></td>
                                    <td>
                                        <button type="button" class="icon-button" aria-label="Bỏ @line.TenMon khỏi đơn" @onclick="() => draftLines.Remove(line)">
                                            <Icon Name="close" Size="14" />
                                        </button>
                                    </td>
                                </tr>
                            }

                            @if (draftLines.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="empty-cell">
                                        Chưa có món nào. Chọn món rồi bấm "Thêm món này vào đơn".
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4">Tạm tính:</td>
                                <td colspan="2"><strong class="grand-total small">@Money(draftLines.Sum(l => l.ThanhTien))</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <p class="form-note">
                    @(editingOrderId is null
                        ? "Tổng tiền chính thức do máy chủ tính khi tạo đơn (áp khuyến mãi theo giờ hiện tại)."
                        : "Tổng tiền chính thức do máy chủ tính lại khi lưu (áp khuyến mãi theo giờ tạo đơn).")
                </p>
            </div>

        </div>

        @if (orderModalError is not null)
        {
            <div class="alert error modal-error" role="alert">
                <span>@orderModalError</span>
                @if (shortages.Count > 0)
                {
                    <ul class="alert-list">
                        @foreach (var s in shortages)
                        {
                            <li>@s.TenNguyenLieu: cần @Number(s.CanDung) @s.DonViTinh, còn @Number(s.ConTon) @s.DonViTinh</li>
                        }
                    </ul>
                }
            </div>
        }

        <div class="modal-footer">
            <button type="button" class="btn outline" disabled="@creating" @onclick="CloseOrderModal">Hủy</button>
            <button type="button" class="btn primary" disabled="@(creating || draftLines.Count == 0)" @onclick="SaveDraftOrder">
                @(editingOrderId is null
                    ? (creating ? "Đang tạo đơn…" : "Tạo đơn hàng")
                    : (creating ? "Đang lưu…" : "Lưu thay đổi"))
            </button>
        </div>

    </Modal>
}

<!-- ========================================================================= -->
<!-- MODAL HỦY ĐƠN (chỉ Quản lý) -->
<!-- ========================================================================= -->
@if (isCancelModalOpen && SelectedOrder is { } toCancel)
{
    <Modal Title="Hủy đơn hàng" OnClose="CloseCancelModal" Busy="@cancelling">
        <p>
            Hủy đơn hàng <strong>#@toCancel.MaDonHang</strong> (tổng tiền @Money(toCancel.TongTien))?
        </p>

        @if (toCancel.TrangThaiThanhToan == TrangThaiDon.Paid)
        {
            <p class="alert error">Đơn đã thanh toán — hệ thống sẽ đánh dấu <strong>hoàn tiền</strong> cho khách. Nguyên liệu đã dùng không được cộng lại kho.</p>
        }

        <div class="field">
            <label for="cancel-reason">Lý do hủy *</label>
            <textarea id="cancel-reason"
                      rows="2"
                      maxlength="255"
                      @bind="cancelReason"
                      @bind:event="oninput"
                      placeholder="Ví dụ: Khách đổi ý, hết món…"></textarea>
        </div>

        @if (cancelError is not null)
        {
            <p class="alert error" role="alert">@cancelError</p>
        }

        <div class="modal-footer">
            <button type="button" class="btn outline" disabled="@cancelling" @onclick="CloseCancelModal">Đóng</button>
            <button type="button" class="btn danger" disabled="@(cancelling || string.IsNullOrWhiteSpace(cancelReason))" @onclick="ConfirmCancelOrder">
                @(cancelling ? "Đang hủy…" : "Xác nhận hủy đơn")
            </button>
        </div>
    </Modal>
}

<!-- ========================================================================= -->
<!-- MẪU HÓA ĐƠN IN CHO KHÁCH (ẩn; appHelpers.printReceipt chép nội dung này sang khung in riêng) -->
<!-- ========================================================================= -->
@if (SelectedOrder is { } receipt)
{
    <div id="receipt-source" hidden>
        <div class="r-center">
            <div class="r-shop">COFFEE SHOP</div>
            <div class="r-title">HÓA ĐƠN</div>
        </div>

        <div class="r-row"><span>Mã đơn:</span><strong>#@receipt.MaDonHang</strong></div>
        @if (receipt.SoNhanMon is { } receiptNo)
        {
            <div class="r-row"><span>Số nhận món:</span><strong>@receiptNo</strong></div>
        }
        <div class="r-row"><span>Thời gian:</span><span>@receipt.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</span></div>

        <hr />

        @foreach (var line in receipt.ChiTiet ?? [])
        {
            <div class="r-item">
                <div class="r-row"><strong>@line.TenMonLuu</strong></div>
                <div class="r-row r-sub"><span>@line.SoLuong x @Money(line.DonGiaBan)</span><span>@Money(line.DonGiaBan * line.SoLuong)</span></div>
                @foreach (var top in line.Toppings)
                {
                    <div class="r-row r-sub"><span>+ @top.TenToppingLuu (@line.SoLuong x @Money(top.DonGiaTopping))</span><span>@Money(top.DonGiaTopping * line.SoLuong)</span></div>
                }
            </div>
        }

        <hr />

        <div class="r-row r-total"><span>TỔNG TIỀN</span><span>@Money(receipt.TongTien)</span></div>
        <div class="r-row r-sub"><span>Thanh toán:</span><span>@PhuongThucThanhToans.Summary(receipt)</span></div>

        <div class="r-center r-thanks">Cảm ơn quý khách!</div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private const int PageSize = 20;
    private const int RefreshSeconds = 10;

    private static readonly System.Globalization.CultureInfo Vi = new("vi-VN");

    private readonly CancellationTokenSource pageCts = new();

    // Danh sách (phân trang ở máy chủ)
    private List<DonHang> orders = [];
    private int totalOrders;
    private int totalPages = 1;
    private int page = 1;
    private int lastSeenOrderId;
    private bool loading;
    private string? loadError;

    // Bộ lọc
    private string search = "";
    private DateTime? fromDate;
    private DateTime? toDate;
    private string statusFilter = "";   // trạng thái phục vụ, hoặc "CANCELLED" = đã hủy
    private string paymentFilter = "";  // PENDING / PAID

    private static readonly string[] ServingFilters =
    [
        TrangThaiPhucVus.Waiting,
        TrangThaiPhucVus.Preparing,
        TrangThaiPhucVus.Served,
        TrangThaiPhucVus.CancelledFilter
    ];

    private int? selectedId;

    // Đơn đang xem chi tiết — giữ riêng để không mất khi đơn trôi sang trang khác lúc tự làm mới
    private DonHang? selectedOrder;

    // Mỗi lần tải danh sách có token riêng: thao tác của người dùng hủy lần tải cũ (kể cả lượt làm mới nền)
    private CancellationTokenSource? loadCts;
    private bool isAdmin;

    // Thông báo
    private string? alertMessage;
    private string alertType = "success";
    private List<CanhBaoKho> stockWarnings = [];

    // Thanh toán
    private string payMethod = PhuongThucThanhToans.Cash;
    private bool paying;
    private string? payError;

    // Số nhận món & trạng thái phục vụ
    private int? pickupInput;
    private bool servingSupported = true;  // false khi máy chủ chưa trả trangThaiPhucVu (backend chưa cập nhật)
    private bool pickupDirty;         // người dùng đã gõ vào ô số nhận món mà chưa lưu
    private int? pickupServerValue;    // số nhận món máy chủ trả về lần gần nhất cho đơn đang xem
    private bool servingBusy;
    private int? confirmServeUnpaidId;     // đơn đang chờ xác nhận "phục vụ khi chưa thanh toán"
    private string? servingError;

    // Tự động làm mới
    private bool autoRefreshEnabled = true;
    private Timer? autoRefreshTimer;

    // Tạo đơn tại quầy / sửa đơn (editingOrderId != null = đang sửa đơn đó)
    private int? editingOrderId;
    private bool isOrderModalOpen;
    private bool creating;
    private bool menuLoading;
    private string? menuError;
    private string? orderModalError;
    private List<ThieuNguyenLieu> shortages = [];
    private List<Mon> menu = [];
    private List<Topping> availableToppings = [];
    private List<DraftLine> draftLines = [];
    private string draftPaymentMethod = PhuongThucThanhToans.Cash;
    private int builderProductId;
    private int builderSizeId;
    private int builderQuantity = 1;
    private string builderNote = "";
    private HashSet<int> selectedToppingIds = [];

    // Hủy đơn
    private bool isCancelModalOpen;
    private bool cancelling;
    private string cancelReason = "";
    private string? cancelError;

    /// <summary>Một dòng món trong đơn đang tạo (hiển thị tạm tính; giá chính thức do backend tính).</summary>
    private sealed record DraftLine(
        int MaChiTietMon,
        string TenMon,
        string TenKichThuoc,
        decimal GiaSize,
        int SoLuong,
        string? GhiChu,
        List<Topping> Toppings)
    {
        public decimal DonGia => GiaSize + Toppings.Sum(t => t.GiaThem);
        public decimal ThanhTien => DonGia * SoLuong;
    }

    private bool IsAdmin => isAdmin;

    private bool IsMock => Configuration.GetValue("Api:UseMock", true);

    private static string Money(decimal value) => value.ToString("N0", Vi) + " đ";

    private static string Number(decimal value) => value.ToString("#,##0.##", Vi);

    private DonHang? SelectedOrder => selectedOrder;

    /// <summary>
    /// Tìm nhanh trong trang đang hiển thị (máy chủ chưa hỗ trợ tìm theo từ khóa).
    /// Chỉ so với dữ liệu nhìn thấy trên bảng: mã đơn bắt đầu bằng số đã nhập, hoặc số nhận món trùng khớp.
    /// (Trước đây tìm cả tên món / nhân viên vốn không hiện trên bảng → kết quả trông như "lọc sai".)
    /// </summary>
    private List<DonHang> VisibleOrders =>
        search.Length == 0
            ? orders
            : orders.Where(o =>
                    o.MaDonHang.ToString(System.Globalization.CultureInfo.InvariantCulture).StartsWith(search, StringComparison.Ordinal)
                    || o.SoNhanMon?.ToString(System.Globalization.CultureInfo.InvariantCulture) == search)
                .ToList();

    /// <summary>Ô tìm kiếm chỉ giữ chữ số (bỏ "#", chữ cái, khoảng trắng).</summary>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? "";
        string digits = new(raw.Where(char.IsAsciiDigit).Take(10).ToArray());

        if (digits != raw)
        {
            // Giá trị đã lọc có thể trùng giá trị cũ → Blazor không vẽ lại và chữ cái vẫn nằm trong ô.
            // Vẽ một nhịp với chuỗi thô rồi mới gán chuỗi đã lọc để ô nhập luôn khớp với bộ lọc.
            search = raw;
            StateHasChanged();
            await Task.Yield();
        }

        search = digits;
    }

    private Mon? BuilderProduct => menu.FirstOrDefault(m => m.MaTenMon == builderProductId);

    private List<GiaTheoSize> BuilderSizes =>
        BuilderProduct?.KichThuoc.Where(s => s.DangApDung && s.DuNguyenLieu).ToList() ?? [];

    private GiaTheoSize? BuilderSize => BuilderSizes.FirstOrDefault(s => s.MaChiTietMon == builderSizeId);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            isAdmin = (await AuthState).User.IsInRole(Roles.Admin);
        }

        await LoadOrders();

        // Rời trang khi lần tải đầu chưa xong → Dispose đã chạy, không tạo timer nữa
        if (pageCts.IsCancellationRequested) return;

        autoRefreshTimer = new Timer(_ => _ = InvokeAsync(AutoRefresh), null,
            TimeSpan.FromSeconds(RefreshSeconds), TimeSpan.FromSeconds(RefreshSeconds));
    }

    // =========================================================================
    // TẢI DANH SÁCH
    // =========================================================================

    /// <param name="quiet">
    /// true = lượt làm mới nền: bỏ qua nếu đang tải, không xóa lỗi đang hiện.
    /// false = thao tác của người dùng: hủy lần tải đang chạy và tải theo bộ lọc / trang mới nhất.
    /// </param>
    private async Task LoadOrders(bool quiet = false)
    {
        if (quiet && loading) return;

        loadCts?.Cancel();
        loadCts?.Dispose();

        CancellationTokenSource cts;

        try
        {
            cts = CancellationTokenSource.CreateLinkedTokenSource(pageCts.Token);
        }
        catch (ObjectDisposedException)
        {
            return; // trang đã đóng
        }

        loadCts = cts;
        loading = true;

        if (!quiet)
        {
            loadError = null;
        }

        try
        {
            // "Đã hủy" là trạng thái thanh toán CANCELLED; các trạng thái còn lại là trạng thái phục vụ
            bool cancelledOnly = statusFilter == TrangThaiPhucVus.CancelledFilter;

            var result = await OrderApi.GetPageAsync(
                page, PageSize,
                trangThai: cancelledOnly ? TrangThaiDon.Cancelled : (paymentFilter == "" ? null : paymentFilter),
                trangThaiPhucVu: cancelledOnly || statusFilter == "" ? null : statusFilter,
                tuNgay: fromDate,
                denNgay: toDate,
                ct: cts.Token);

            orders = result.Data;
            totalOrders = result.Meta.Total;

            // Backend cũ không trả trangThaiPhucVu → ẩn phần phục vụ thay vì hiện "Chờ phục vụ" cho mọi đơn
            if (orders.Count > 0) servingSupported = orders.Any(o => o.TrangThaiPhucVu is not null);
            totalPages = Math.Max(1, result.Meta.TotalPages);
            loadError = null;

            await RefreshSelected(cts.Token);

            // Báo đơn mới từ Tablet (so với mã đơn lớn nhất đã thấy)
            int maxId = orders.Count == 0 ? 0 : orders.Max(o => o.MaDonHang);
            int newTablet = orders.Count(o => o.MaDonHang > lastSeenOrderId && o.MaNguoiDung is null);

            // Không đè thông báo thanh toán đang kèm cảnh báo kho
            if (lastSeenOrderId > 0 && newTablet > 0 && stockWarnings.Count == 0)
            {
                ShowAlert($"Có {newTablet} đơn mới từ Tablet!", "success");
            }

            lastSeenOrderId = Math.Max(lastSeenOrderId, maxId);
        }
        catch (ApiException ex)
        {
            if (!cts.IsCancellationRequested)
            {
                loadError = ex.Message;
            }
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Bị thay bởi lần tải mới hơn, hoặc rời trang
        }
        finally
        {
            // Chỉ lần tải mới nhất mới được tắt cờ "đang tải"
            if (loadCts == cts)
            {
                loading = false;
            }
        }
    }

    /// <summary>
    /// Cập nhật đơn đang xem: lấy từ trang vừa tải, nếu đơn không còn trong trang thì hỏi riêng máy chủ.
    /// </summary>
    private async Task RefreshSelected(CancellationToken ct)
    {
        if (selectedId is not { } id) return;

        var inPage = orders.FirstOrDefault(o => o.MaDonHang == id);

        if (inPage is not null)
        {
            selectedOrder = inPage;
            SyncPickupInput(inPage);
            return;
        }

        try
        {
            selectedOrder = await OrderApi.GetAsync(id, ct);
            SyncPickupInput(selectedOrder);
        }
        catch (ApiException)
        {
            // Giữ bản đang hiển thị; lần làm mới sau sẽ thử lại
        }
    }

    private async Task AutoRefresh()
    {
        // Không làm mới khi đang thao tác (tránh danh sách nhảy dưới tay người dùng)
        if (!autoRefreshEnabled || loading || paying || creating || cancelling || servingBusy
            || isOrderModalOpen || isCancelModalOpen || pageCts.IsCancellationRequested)
        {
            return;
        }

        await LoadOrders(quiet: true);
        StateHasChanged();
    }

    private async Task ApplyFilter()
    {
        if (fromDate.HasValue && toDate.HasValue && toDate < fromDate)
        {
            loadError = "Ngày kết thúc phải sau hoặc bằng ngày bắt đầu.";
            return;
        }

        // Lọc "Đã hủy" không đi cùng lọc thanh toán (đơn hủy không còn chưa/đã thanh toán)
        if (statusFilter == TrangThaiPhucVus.CancelledFilter) paymentFilter = "";

        page = 1;
        await LoadOrders();
    }

    private async Task Reset()
    {
        search = "";
        fromDate = null;
        toDate = null;
        statusFilter = "";
        paymentFilter = "";
        page = 1;
        await LoadOrders();
    }

    private async Task Move(int direction)
    {
        int next = page + direction;
        if (next < 1 || next > totalPages) return;

        page = next;
        await LoadOrders();
    }

    private void ToggleAutoRefresh()
    {
        autoRefreshEnabled = !autoRefreshEnabled;
        ShowAlert(autoRefreshEnabled
            ? $"Đã bật tự động cập nhật đơn mới (mỗi {RefreshSeconds} giây)."
            : "Đã tắt tự động cập nhật. Bấm Đặt lại hoặc đổi trang để tải lại danh sách.", "success");
    }

    /// <summary>Chế độ giả lập: yêu cầu API giả sinh một đơn tablet rồi tải lại danh sách.</summary>
    private async Task SimulateTabletOrder()
    {
        if (Services.GetService<CoffeeShop.Admin.Services.Mock.MockDatabase>() is { } mock)
        {
            mock.TabletOrderRequested = true;
            page = 1;
            await LoadOrders();
        }
    }

    // =========================================================================
    // CHỌN ĐƠN & THANH TOÁN
    // =========================================================================

    // Cờ yêu cầu cuộn tới khung chi tiết sau khi vẽ lại (màn hình hẹp)
    private bool scrollToDetail;

    private void SelectOrder(int id)
    {
        if (selectedId != id)
        {
            var order = orders.FirstOrDefault(o => o.MaDonHang == id);
            payMethod = order?.PhuongThucThanhToan ?? PhuongThucThanhToans.Cash;
            pickupInput = order?.SoNhanMon;
            pickupServerValue = order?.SoNhanMon;
            pickupDirty = false;
            payError = null;
            servingError = null;
        }

        selectedId = id;
        selectedOrder = orders.FirstOrDefault(o => o.MaDonHang == id) ?? (selectedOrder?.MaDonHang == id ? selectedOrder : null);
        scrollToDetail = true;
    }

    private void SelectKey(KeyboardEventArgs e, int id)
    {
        if (e.Key is "Enter" or " ") SelectOrder(id);
    }

    private void CloseDetail()
    {
        selectedId = null;
        selectedOrder = null;
        payError = null;
        servingError = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollToDetail) return;

        scrollToDetail = false;

        try
        {
            await JS.InvokeVoidAsync("appHelpers.scrollIntoViewOnNarrow", ".detail-panel", 1000);
        }
        catch (JSException)
        {
            // Cuộn chỉ là tiện ích: nếu trình duyệt còn app.js cũ thì bỏ qua, không làm sập trang
        }
    }

    private async Task Pay(DonHang order)
    {
        if (paying) return;

        paying = true;
        payError = null;

        try
        {
            // Không gửi "tiền khách đưa": nhân viên chỉ xác nhận đã thu đủ tiền
            var result = await OrderApi.PayAsync(order.MaDonHang, new ThanhToanRequest
            {
                PhuongThucThanhToan = payMethod
            }, pageCts.Token);

            Replace(result.DonHang);

            ShowAlert($"Đơn #{order.MaDonHang} đã thanh toán {Money(result.DonHang.TongTien)} ({PhuongThucThanhToans.Label(result.DonHang.PhuongThucThanhToan)}).",
                "success", result.CanhBaoKho);
        }
        catch (ApiException ex)
        {
            payError = ex.Message;

            // Đơn đã đổi trạng thái ở nơi khác (409) → tải lại cho đúng
            if (ex.Status == 409) await LoadOrders(quiet: true);
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            paying = false;
        }
    }

    private void Replace(DonHang updated)
    {
        int index = orders.FindIndex(o => o.MaDonHang == updated.MaDonHang);
        if (index >= 0) orders[index] = updated;

        if (selectedId == updated.MaDonHang)
        {
            selectedOrder = updated;
            SyncPickupInput(updated);
        }
    }

    /// <summary>
    /// Đồng bộ ô "Số nhận món" với dữ liệu máy chủ. Khi người dùng đang gõ dở thì giữ nguyên chữ họ gõ,
    /// nhưng nếu máy khác vừa đổi số của chính đơn này thì báo và nạp lại số mới — tránh lưu đè (vd. xóa mất số).
    /// </summary>
    private void SyncPickupInput(DonHang order)
    {
        if (!pickupDirty)
        {
            pickupInput = order.SoNhanMon;
        }
        else if (order.SoNhanMon != pickupServerValue)
        {
            pickupInput = order.SoNhanMon;
            pickupDirty = false;
            servingError = order.SoNhanMon is { } so
                ? $"Số nhận món của đơn này vừa được đổi ở máy khác thành {so}. Kiểm tra lại trước khi đổi."
                : "Số nhận món của đơn này vừa được bỏ ở máy khác. Kiểm tra lại trước khi nhập.";
        }

        pickupServerValue = order.SoNhanMon;
    }

    private void OnPickupInput(ChangeEventArgs e)
    {
        pickupInput = int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.None,
            System.Globalization.CultureInfo.InvariantCulture, out int n) ? n : null;
        pickupDirty = true;
    }

    private void SwitchPayMethod()
    {
        payMethod = payMethod == PhuongThucThanhToans.Cash ? PhuongThucThanhToans.QrTransfer : PhuongThucThanhToans.Cash;
        payError = null;
    }

    /// <summary>
    /// Các API số nhận món / trạng thái phục vụ / sửa đơn mới chỉ là đề xuất: backend chưa có thì báo rõ thay vì "không tìm thấy".
    /// </summary>
    /// Backend thật trả 404 NOT_FOUND "Không có endpoint ..." (MapFallback) cho route chưa có; đơn hàng thì không bị xóa,
    /// nên 404/405/501 trên các route đề xuất được coi là "chưa hỗ trợ".
    private static string ProposedApiError(ApiException ex) =>
        ex.Status is 404 or 405 or 501
            ? "Máy chủ chưa hỗ trợ chức năng này (đã đề xuất với nhóm backend)."
            : ex.Message;

    // =========================================================================
    // SỐ NHẬN MÓN & TRẠNG THÁI PHỤC VỤ
    // =========================================================================

    private async Task PickupKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && SelectedOrder is { } order) await SavePickupNumber(order);
    }

    private async Task SavePickupNumber(DonHang order)
    {
        if (servingBusy || pickupInput == order.SoNhanMon) return;

        if (pickupInput is { } n && (n < SoNhanMons.Min || n > SoNhanMons.Max))
        {
            servingError = $"Số nhận món phải từ {SoNhanMons.Min} đến {SoNhanMons.Max}.";
            return;
        }

        servingBusy = true;
        servingError = null;

        try
        {
            var updated = await OrderApi.SetPickupNumberAsync(order.MaDonHang, pickupInput, pageCts.Token);
            pickupDirty = false;
            Replace(updated);
            ShowAlert(updated.SoNhanMon is { } so
                ? $"Đã gán số nhận món {so} cho đơn #{updated.MaDonHang}."
                : $"Đã bỏ số nhận món của đơn #{updated.MaDonHang}.", "success");
        }
        catch (ApiException ex)
        {
            servingError = ProposedApiError(ex);
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            servingBusy = false;
        }
    }

    private async Task SetServing(DonHang order, string status, bool confirmed = false)
    {
        if (servingBusy) return;

        // Phục vụ khi chưa thu tiền: hỏi lại trước (thao tác không hoàn tác)
        if (status == TrangThaiPhucVus.Served && !confirmed && order.TrangThaiThanhToan == TrangThaiDon.Pending)
        {
            confirmServeUnpaidId = order.MaDonHang;
            return;
        }

        confirmServeUnpaidId = null;

        servingBusy = true;
        servingError = null;

        try
        {
            var updated = await OrderApi.SetServingStatusAsync(order.MaDonHang, status, pageCts.Token);
            Replace(updated);
            ShowAlert(status == TrangThaiPhucVus.Served
                ? $"Đơn #{updated.MaDonHang} đã phục vụ.{(updated.SoNhanMon is { } so ? $" Số {so} đã được giải phóng." : "")}"
                : $"Đơn #{updated.MaDonHang} đang được chuẩn bị.", "success");
        }
        catch (ApiException ex)
        {
            servingError = ProposedApiError(ex);
            if (ex.Status == 409) await LoadOrders(quiet: true);
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            servingBusy = false;
        }
    }

