    private void ShowAlert(string msg, string type, List<CanhBaoKho>? warnings = null)
    {
        alertMessage = msg;
        alertType = type;
        stockWarnings = warnings ?? [];

        if (stockWarnings.Count > 0)
        {
            alertMessage += " Cảnh báo kho:";
        }
    }

    private void ClearAlert()
    {
        alertMessage = null;
        stockWarnings = [];
    }

    /// <summary>In riêng hóa đơn (mẫu #receipt-source) cho khách — không in cả giao diện trang.</summary>
    private async Task PrintReceipt()
    {
        try
        {
            await JS.InvokeVoidAsync("appHelpers.printReceipt", "#receipt-source");
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Mở hộp thoại in thất bại.");
            ShowAlert("Không mở được hộp thoại in. Hãy tải lại trang rồi thử lại.", "error");
        }
    }

