    private void OpenCancelOrder()
    {
        if (SelectedOrder is null) return;

        cancelReason = "";
        cancelError = null;
        isCancelModalOpen = true;
    }

    private void CloseCancelModal()
    {
        if (cancelling) return;
        isCancelModalOpen = false;
    }

    private async Task ConfirmCancelOrder()
    {
        if (cancelling || SelectedOrder is not { } order || string.IsNullOrWhiteSpace(cancelReason)) return;

        cancelling = true;
        cancelError = null;

        try
        {
            var updated = await OrderApi.CancelAsync(order.MaDonHang, cancelReason.Trim(), pageCts.Token);
            Replace(updated);
            isCancelModalOpen = false;
            ShowAlert(updated.DaHoanTien
                ? $"Đã hủy đơn #{updated.MaDonHang} và đánh dấu hoàn tiền {Money(updated.TongTien)} cho khách."
                : $"Đã hủy đơn #{updated.MaDonHang}.", "success");
        }
        catch (ApiException ex)
        {
            cancelError = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            cancelling = false;
        }
    }

    // =========================================================================
    // TẠO ĐƠN TẠI QUẦY
    // =========================================================================

    private async Task OpenCreateOrder()
    {
        editingOrderId = null;
        draftLines = [];
        draftPaymentMethod = PhuongThucThanhToans.Cash;
        await OpenOrderModal();
    }

    /// <summary>Sửa đơn: mở lại hộp thoại tạo đơn với các món hiện có (chỉ đơn chưa thanh toán, chưa phục vụ).</summary>
    private async Task OpenEditOrder()
    {
        if (SelectedOrder is not { CoTheSua: true } order) return;

        editingOrderId = order.MaDonHang;
        draftPaymentMethod = order.PhuongThucThanhToan;
        draftLines = (order.ChiTiet ?? []).Select(c =>
        {
            // TenMonLuu = "Tên món - Size"
            int cut = c.TenMonLuu.LastIndexOf(" - ", StringComparison.Ordinal);
            return new DraftLine(
                c.MaChiTietMon,
                cut > 0 ? c.TenMonLuu[..cut] : c.TenMonLuu,
                cut > 0 ? c.TenMonLuu[(cut + 3)..] : "",
                c.DonGiaBan,
                c.SoLuong,
                c.GhiChu,
                c.Toppings.Select(t => new Topping { MaTopping = t.MaTopping, TenTopping = t.TenToppingLuu, GiaThem = t.DonGiaTopping }).ToList());
        }).ToList();

        await OpenOrderModal();
    }

    private async Task OpenOrderModal()
    {
        orderModalError = null;
        shortages = [];
        ResetBuilder();
        isOrderModalOpen = true;

        // Tải thực đơn mỗi lần mở: món hết nguyên liệu / tạm hết sẽ không xuất hiện
        menuLoading = true;
        menuError = null;

        try
        {
            var menuTask = ProductApi.GetSellableAsync(pageCts.Token);
            var toppingTask = ToppingApi.GetAllAsync(ct: pageCts.Token);

            menu = (await menuTask).OrderBy(m => m.TenDanhMuc).ThenBy(m => m.TenMon).ToList();
            availableToppings = (await toppingTask).Where(t => t.ConHang && !t.NgungBan && t.DuNguyenLieu).ToList();

            if (menu.Count == 0)
            {
                menuError = "Hiện không có món nào bán được (hết hàng hoặc thiếu nguyên liệu).";
            }

            ResetBuilder();
        }
        catch (ApiException ex)
        {
            menuError = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            menuLoading = false;
        }
    }

    private void ResetBuilder()
    {
        builderProductId = menu.FirstOrDefault()?.MaTenMon ?? 0;
        OnBuilderProductChanged();
        builderQuantity = 1;
        builderNote = "";
        selectedToppingIds.Clear();
    }

    private void OnBuilderProductChanged()
    {
        builderSizeId = BuilderSizes.FirstOrDefault()?.MaChiTietMon ?? 0;
    }

    private void ToggleTopping(int id, ChangeEventArgs e)
    {
        if (e.Value is true) selectedToppingIds.Add(id);
        else selectedToppingIds.Remove(id);
    }

    private void AddItemToDraft()
    {
        if (BuilderProduct is not { } product || BuilderSize is not { } size) return;

        draftLines.Add(new DraftLine(
            size.MaChiTietMon,
            product.TenMon,
            size.TenKichThuoc,
            size.GiaSauGiam,
            Math.Clamp(builderQuantity, 1, 50),
            string.IsNullOrWhiteSpace(builderNote) ? null : builderNote.Trim(),
            availableToppings.Where(t => selectedToppingIds.Contains(t.MaTopping)).ToList()));

        orderModalError = null;
        shortages = [];

        // Giữ món đang chọn (hay gọi nhiều ly cùng món), chỉ xóa phần tùy chọn
        builderQuantity = 1;
        builderNote = "";
        selectedToppingIds.Clear();
    }

    private async Task SaveDraftOrder()
    {
        if (creating) return;

        if (draftLines.Count == 0)
        {
            orderModalError = "Vui lòng thêm ít nhất một món vào đơn hàng trước khi lưu.";
            return;
        }

        creating = true;
        orderModalError = null;
        shortages = [];

        try
        {
            var request = new DatMonRequest
            {
                PhuongThucThanhToan = draftPaymentMethod,
                ChiTiet = draftLines.Select(l => new DongDatMonRequest
                {
                    MaChiTietMon = l.MaChiTietMon,
                    SoLuong = l.SoLuong,
                    GhiChu = l.GhiChu,
                    Toppings = l.Toppings.Count == 0 ? null : l.Toppings.Select(t => t.MaTopping).ToList()
                }).ToList()
            };

            if (editingOrderId is { } editId)
            {
                var updated = await OrderApi.UpdateAsync(editId, request, pageCts.Token);
                Replace(updated);
                if (selectedId == updated.MaDonHang) payMethod = updated.PhuongThucThanhToan;
                isOrderModalOpen = false;
                editingOrderId = null;
                ShowAlert($"Đã cập nhật đơn #{updated.MaDonHang} — tổng mới {Money(updated.TongTien)}.", "success");
                return;
            }

            var created = await OrderApi.CreateAsync(request, pageCts.Token);

            isOrderModalOpen = false;
            lastSeenOrderId = Math.Max(lastSeenOrderId, created.MaDonHang);
            ShowAlert($"Đã tạo đơn #{created.MaDonHang} — tổng {Money(created.TongTien)}. Chọn đơn để thu tiền.", "success");

            page = 1;
            await LoadOrders();
            SelectOrder(created.MaDonHang);
        }
        catch (ApiException ex)
        {
            orderModalError = editingOrderId is null ? ex.Message : ProposedApiError(ex);

            if (ex.Code == ApiErrorCodes.OutOfIngredients && ex.Details is { ValueKind: System.Text.Json.JsonValueKind.Array } details)
            {
                try
                {
                    shortages = System.Text.Json.JsonSerializer.Deserialize<List<ThieuNguyenLieu>>(details,
                        new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)) ?? [];
                }
                catch (System.Text.Json.JsonException jsonEx)
                {
                    Logger.LogWarning(jsonEx, "Không đọc được chi tiết thiếu nguyên liệu.");
                }
            }
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            creating = false;
        }
    }

    private void CloseOrderModal()
    {
        if (creating) return;

        isOrderModalOpen = false;
        editingOrderId = null;
        orderModalError = null;
    }

