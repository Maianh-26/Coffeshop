<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Tải đủ dữ liệu ngôn ngữ để định dạng vi-VN hoạt động (29.000 đ, dd/MM/yyyy).
         Mặc định Blazor WASM chỉ tải dữ liệu vài ngôn ngữ châu Âu nên vi-VN bị rơi về kiểu tiếng Anh (29,000). -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.33" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.33" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.33" PrivateAssets="all" />
  </ItemGroup>

</Project>
