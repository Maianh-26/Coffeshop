@page "/accounts"
@attribute [Authorize(Roles = Roles.Admin)]
@implements IDisposable
@inject AccountService AccountApi
@inject AuthenticationService AuthService

<PageTitle>Tài khoản - Coffee Shop</PageTitle>

<div class="accounts-page">

    <section class="panel filters-panel">

        <div class="filter-row">

            <div class="search-field">

                <Icon Name="search" />

                <input @bind="search"
                       @bind:event="oninput"
                       @bind:after="Filter"
                       placeholder="Tìm mã, tên, tên đăng nhập hoặc email"
                       aria-label="Tìm tài khoản" />

            </div>

            <select aria-label="Lọc vai trò"
                    @bind="roleFilter"
                    @bind:after="Filter">

                <option value="">Tất cả vai trò</option>
                <option value="@Roles.Admin">@Roles.Label(Roles.Admin)</option>
                <option value="@Roles.Staff">@Roles.Label(Roles.Staff)</option>

            </select>

            <select aria-label="Lọc trạng thái"
                    @bind="statusFilter"
                    @bind:after="Filter">

                <option value="">Tất cả trạng thái</option>
                <option value="active">Đang hoạt động</option>
                <option value="locked">Đã khóa</option>

            </select>

            <button class="btn outline"
                    @onclick="Reset">

                <Icon Name="reset" />
                Đặt lại

            </button>

        </div>

    </section>

    <section class="panel action-bar">

        <button class="btn primary"
                @onclick="Add">

            <Icon Name="plus" />
            Thêm tài khoản

        </button>

        <button class="btn outline"
                disabled="@(Selected is null)"
                @onclick="Edit">

            <Icon Name="edit" />
            Sửa

        </button>

        <button class="btn danger-outline"
                disabled="@(Selected is null || IsMe(Selected))"
                title="@(IsMe(Selected) ? "Không thể tự khóa tài khoản đang đăng nhập" : null)"
                @onclick="AskToggleLock">

            <Icon Name="lock" />
            @(Selected is { TrangThai: false } ? "Mở khóa" : "Khóa tài khoản")

        </button>

    </section>

    @if (message is not null)
    {
        <p class="alert success" role="status">
            @message
        </p>
    }

    @if (loadError is not null)
    {
        <p class="alert error" role="alert">
            @loadError
            <button type="button" class="text-button" @onclick="Load">Thử lại</button>
        </p>
    }

    <section class="panel list-panel">

        <div class="table-wrap">

            <table>

                <thead>

                    <tr>
                        <th>Mã TK</th>
                        <th>Họ và tên</th>
                        <th>Tên đăng nhập</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in VisibleAccounts)
                    {
                        <tr class="selectable @(selected == item.MaNguoiDung ? "selected" : "")"
                            tabindex="0"
                            @onclick="() => selected = item.MaNguoiDung"
                            @onkeydown="e => SelectKey(e, item.MaNguoiDung)">

                            <td>@item.MaNguoiDung</td>
                            <td>@item.HoTen</td>
                            <td>@item.TenDangNhap</td>
                            <td>@item.Email</td>

                            <td>
                                <span class="badge @(item.VaiTro == Roles.Admin ? "yellow" : "green")">
                                    @Roles.Label(item.VaiTro)
                                </span>
                            </td>

                            <td>
                                <span class="badge @(item.TrangThai ? "green" : "red")">
                                    @(item.TrangThai ? "Đang hoạt động" : "Đã khóa")
                                </span>
                            </td>

                        </tr>
                    }

                    @if (VisibleAccounts.Count == 0)
                    {
                        <tr>

                            <td class="empty-cell" colspan="6">

                                <Icon Name="user" Size="32" />

                                <p>
                                    @(loading ? "Đang tải danh sách tài khoản…" : "Không có tài khoản phù hợp.")
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="list-footer">

            <span>
                @FilteredAccounts.Count() tài khoản
                · Trang @(page)/@Pages
            </span>

            <div class="pagination">

                <button class="page-button"
                        aria-label="Trang trước"
                        disabled="@(page <= 1)"
                        @onclick="() => Move(-1)">
                    <Icon Name="left" Size="16" />
                </button>

                <span class="page-number">@(page)</span>

                <button class="page-button"
                        aria-label="Trang sau"
                        disabled="@(page >= Pages)"
                        @onclick="() => Move(1)">
                    <Icon Name="right" Size="16" />
                </button>

            </div>

        </div>

    </section>

</div>

@if (dialog != "")
{
    <Modal Title="@DialogTitle"
           OnClose="Close"
           Busy="@saving">

        @if (dialog == "form")
        {
            <EditForm Model="model"
                      OnValidSubmit="Save">

                <DataAnnotationsValidator />

                <div class="form-stack">

                    <div class="field">
                        <label for="a-username">Tên đăng nhập *</label>
                        <InputText id="a-username"
                                   @bind-Value="model.TenDangNhap"
                                   readonly="@editing"
                                   placeholder="ví dụ: lan.nv"
                                   autocomplete="off" />
                        <ValidationMessage For="@(() => model.TenDangNhap)" />
                        @if (editing)
                        {
                            <small class="form-note">Không đổi được tên đăng nhập.</small>
                        }
                    </div>

                    <div class="field">
                        <label for="a-name">Họ và tên *</label>
                        <InputText id="a-name"
                                   @bind-Value="model.HoTen"
                                   placeholder="Nhập họ và tên" />
                        <ValidationMessage For="@(() => model.HoTen)" />
                    </div>

                    <div class="field">
                        <label for="a-email">Email *</label>
                        <InputText id="a-email"
                                   @bind-Value="model.Email"
                                   placeholder="Nhập email"
                                   type="email" />
                        <ValidationMessage For="@(() => model.Email)" />
                    </div>

                    <div class="field">
                        <label for="a-role">Vai trò</label>
                        <InputSelect id="a-role"
                                     @bind-Value="model.VaiTro">
                            <option value="@Roles.Staff">@Roles.Label(Roles.Staff)</option>
                            <option value="@Roles.Admin">@Roles.Label(Roles.Admin)</option>
                        </InputSelect>
                    </div>

                    <div class="field">
                        <label for="a-password">@(editing ? "Đặt lại mật khẩu" : "Mật khẩu *")</label>
                        <InputText id="a-password"
                                   type="password"
                                   @bind-Value="model.MatKhau"
                                   placeholder="@(editing ? "Để trống nếu giữ mật khẩu cũ" : "Tối thiểu 6 ký tự")"
                                   autocomplete="new-password" />
                        <ValidationMessage For="@(() => model.MatKhau)" />
                    </div>

                </div>

                @if (error is not null)
                {
                    <p class="alert error" role="alert">@error</p>
                }

                <div class="modal-footer">

                    <button type="button" class="btn outline"
                            disabled="@saving"
                            @onclick="Close">
                        Hủy
                    </button>

                    <button type="submit" class="btn primary" disabled="@saving">
                        @(saving ? "Đang lưu…"
                            : editing ? "Lưu thay đổi"
                            : "Thêm tài khoản")
                    </button>

                </div>

            </EditForm>
        }

        @if (dialog == "lock" && Selected is { } target)
        {
            <p>
                @(target.TrangThai ? "Khóa" : "Mở khóa") tài khoản
                <strong>@target.HoTen (@target.TenDangNhap)</strong>?
            </p>

            <p class="form-note">
                @(target.TrangThai
                    ? "Tài khoản bị khóa sẽ không đăng nhập được. Lịch sử đơn hàng vẫn được giữ."
                    : "Tài khoản sẽ đăng nhập lại được bằng mật khẩu hiện tại.")
            </p>

            @if (error is not null)
            {
                <p class="alert error" role="alert">@error</p>
            }

            <div class="modal-footer">

                <button class="btn outline" disabled="@saving" @onclick="Close">
                    Hủy
                </button>

                <button class="btn @(target.TrangThai ? "danger" : "primary")" disabled="@saving" @onclick="ToggleLock">
                    @(saving ? "Đang lưu…" : target.TrangThai ? "Khóa tài khoản" : "Mở khóa")
                </button>

            </div>
        }

    </Modal>
}

@code {
    private readonly CancellationTokenSource pageCts = new();

    private List<NguoiDung> accounts = [];

    private string search = "";
    private string roleFilter = "";
    private string statusFilter = "";
    private int? selected;
    private int page = 1;
    private const int PageSize = 10;

    private string dialog = "";
    private bool editing;
    private bool loading;
    private bool saving;
    private string? error;
    private string? loadError;
    private string? message;

    private NguoiDungForm model = new();

    private NguoiDung? Selected => accounts.FirstOrDefault(a => a.MaNguoiDung == selected);

    /// <summary>Mã tài khoản đang đăng nhập (backend cũng chặn tự khóa / tự hạ quyền — 409).</summary>
    private int? myId;

    private bool IsMe(NguoiDung? account) => account is not null && account.MaNguoiDung == myId;

    private string DialogTitle => dialog switch
    {
        "form" => editing ? "Sửa tài khoản" : "Thêm tài khoản",
        "lock" => Selected is { TrangThai: false } ? "Mở khóa tài khoản" : "Khóa tài khoản",
        _ => ""
    };

    private IEnumerable<NguoiDung> FilteredAccounts =>
        accounts.Where(a =>
            (roleFilter == "" || a.VaiTro == roleFilter)
            && (statusFilter == "" || a.TrangThai == (statusFilter == "active"))
            && (search == ""
                || a.MaNguoiDung.ToString().Contains(search, StringComparison.OrdinalIgnoreCase)
                || a.HoTen.Contains(search, StringComparison.OrdinalIgnoreCase)
                || a.TenDangNhap.Contains(search, StringComparison.OrdinalIgnoreCase)
                || a.Email.Contains(search, StringComparison.OrdinalIgnoreCase)));

    private List<NguoiDung> VisibleAccounts =>
        FilteredAccounts
            .Skip((page - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int Pages => Math.Max(1, (int)Math.Ceiling(FilteredAccounts.Count() / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        var me = await AuthService.GetMyAccountAsync(pageCts.Token);
        myId = me.Success ? me.Data?.MaNguoiDung : null;

        await Load();
    }

    private async Task Load()
    {
        loading = true;
        loadError = null;

        try
        {
            accounts = await AccountApi.GetAllAsync(pageCts.Token);
            page = Math.Clamp(page, 1, Pages);
        }
        catch (ApiException ex)
        {
            loadError = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            loading = false;
        }
    }

    private void Filter()
    {
        page = 1;
    }

    private void Reset()
    {
        search = "";
        roleFilter = "";
        statusFilter = "";
        page = 1;
    }

    private void Move(int direction)
    {
        int next = page + direction;
        if (next >= 1 && next <= Pages) page = next;
    }

    private void SelectKey(KeyboardEventArgs e, int id)
    {
        if (e.Key is "Enter" or " ") selected = id;
    }

    private void Add()
    {
        editing = false;
        error = null;
        message = null;
        model = new NguoiDungForm { VaiTro = Roles.Staff, IsNew = true };
        dialog = "form";
    }

    private void Edit()
    {
        if (Selected is not { } source) return;

        editing = true;
        error = null;
        message = null;
        model = new NguoiDungForm
        {
            MaNguoiDung = source.MaNguoiDung,
            TenDangNhap = source.TenDangNhap,
            HoTen = source.HoTen,
            Email = source.Email,
            VaiTro = source.VaiTro,
            TrangThai = source.TrangThai
        };
        dialog = "form";
    }

    private void AskToggleLock()
    {
        if (Selected is null || IsMe(Selected)) return;

        error = null;
        message = null;
        dialog = "lock";
    }

    private void Close()
    {
        if (saving) return;

        dialog = "";
        error = null;
    }

    private async Task Save()
    {
        if (saving) return;

        if (!editing && string.IsNullOrEmpty(model.MatKhau))
        {
            error = "Nhập mật khẩu cho tài khoản mới (tối thiểu 6 ký tự).";
            return;
        }

        saving = true;
        error = null;

        try
        {
            NguoiDung saved;

            if (editing)
            {
                saved = await AccountApi.UpdateAsync(model.MaNguoiDung, new NguoiDungCapNhatRequest
                {
                    HoTen = model.HoTen.Trim(),
                    Email = model.Email.Trim(),
                    VaiTro = model.VaiTro,
                    MatKhauMoi = string.IsNullOrEmpty(model.MatKhau) ? null : model.MatKhau
                }, pageCts.Token);

                message = $"Đã cập nhật tài khoản {saved.HoTen}.";
            }
            else
            {
                saved = await AccountApi.CreateAsync(new NguoiDungTaoRequest
                {
                    TenDangNhap = model.TenDangNhap.Trim(),
                    MatKhau = model.MatKhau!,
                    HoTen = model.HoTen.Trim(),
                    Email = model.Email.Trim(),
                    VaiTro = model.VaiTro
                }, pageCts.Token);

                message = $"Đã thêm tài khoản {saved.HoTen}.";
            }

            dialog = "";
            selected = saved.MaNguoiDung;
            await Load();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleLock()
    {
        if (saving || Selected is not { } target || IsMe(target)) return;

        saving = true;
        error = null;

        try
        {
            bool unlock = !target.TrangThai;
            var saved = await AccountApi.UpdateAsync(target.MaNguoiDung,
                new NguoiDungCapNhatRequest { TrangThai = unlock }, pageCts.Token);

            message = unlock ? $"Đã mở khóa tài khoản {saved.HoTen}." : $"Đã khóa tài khoản {saved.HoTen}.";
            dialog = "";
            await Load();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            saving = false;
        }
    }

    public void Dispose()
    {
        pageCts.Cancel();
        pageCts.Dispose();
    }
}
