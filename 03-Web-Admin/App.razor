@inject NavigationManager Navigation

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">

        <!-- Trang có [Authorize] mà chưa đăng nhập → chuyển về /login -->
        <AuthorizeRouteView RouteData="@routeData"
                            DefaultLayout="@typeof(MainLayout)">

            <Authorizing>
                <p class="auth-checking">Đang kiểm tra đăng nhập…</p>
            </Authorizing>

            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else if (IsHomePage)
                {
                    @* Nhân viên mở trang chủ (Tổng quan — chỉ dành cho chủ quán) → về trang Đơn hàng *@
                    <RedirectTo Url="orders" />
                }
                else
                {
                    <PageTitle>Không có quyền truy cập - Coffee Shop</PageTitle>
                    <section class="panel placeholder-page">
                        <Icon Name="lock" Size="40" />
                        <h2>Không có quyền truy cập</h2>
                        <p class="muted">Trang này chỉ dành cho tài khoản quản lý (chủ quán). Liên hệ chủ quán nếu bạn cần quyền này.</p>
                        <a class="btn primary" href="@Roles.HomeUrl(context.User)">Về trang chính</a>
                    </section>
                }
            </NotAuthorized>

        </AuthorizeRouteView>

        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>

    <NotFound>
        @* Chưa đăng nhập thì không hiện khung quản trị — chuyển về trang Đăng nhập *@
        <AuthorizeView>
            <Authorized>
                <LayoutView Layout="@typeof(MainLayout)">
                    <PageTitle>Không tìm thấy trang - Coffee Shop</PageTitle>
                    <section class="panel placeholder-page">
                        <Icon Name="search" Size="40" />
                        <h2>Không tìm thấy trang</h2>
                        <p class="muted">Đường dẫn bạn truy cập không tồn tại.</p>
                        <a class="btn primary" href="@Roles.HomeUrl(context.User)">Về trang chính</a>
                    </section>
                </LayoutView>
            </Authorized>
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeView>
    </NotFound>
</Router>

@code {
    private bool IsHomePage =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/').Length == 0;

}
