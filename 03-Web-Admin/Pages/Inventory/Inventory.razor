@page "/inventory"
@attribute [Authorize(Roles = Roles.Admin)]
@implements IDisposable
@inject InventoryService InventoryApi

<PageTitle>Kho nguyên liệu - Coffee Shop</PageTitle>

<div class="inventory-page">

    <section class="panel filters-panel">

        <div class="tabs">

            <button class="tab @(!transactionTab ? "active" : "")"
                    aria-pressed="@(!transactionTab ? "true" : "false")"
                    @onclick="() => SwitchTab(false)">

                <Icon Name="box" />
                Nguyên liệu

            </button>

            <button class="tab @(transactionTab ? "active" : "")"
                    aria-pressed="@(transactionTab ? "true" : "false")"
                    @onclick="() => SwitchTab(true)">

                <Icon Name="orders" />
                Lịch sử kho

            </button>

        </div>

        @* Bộ lọc đồng bộ với trang Đơn hàng: màn hình rộng hiện đủ; màn hình hẹp gom vào nút "Bộ lọc (n)".
           Nút Làm mới (biểu tượng) bỏ mọi bộ lọc của tab đang xem, về trang 1 và tải lại; có chấm khi đang lọc. *@
        <div class="filter-row">

            @if (!transactionTab)
            {
                <div class="search-field">

                    <Icon Name="search" />

                    <input @bind="search"
                           @bind:event="oninput"
                           @bind:after="ResetPage"
                           maxlength="100"
                           placeholder="Tìm theo tên hoặc mã nguyên liệu…"
                           aria-label="Tìm nguyên liệu theo tên hoặc mã" />

                </div>
            }

            <button type="button"
                    class="btn outline filters-toggle"
                    aria-expanded="@(filtersOpen ? "true" : "false")"
                    aria-controls="inventory-filters"
                    @onclick="() => filtersOpen = !filtersOpen">
                <Icon Name="filter" />
                Bộ lọc@(ActiveFilterCount > 0 ? $" ({ActiveFilterCount})" : "")
            </button>

            <button type="button"
                    class="btn outline refresh-button @(refreshing ? "is-loading" : "")"
                    title="@RefreshTitle"
                    aria-label="@RefreshTitle"
                    @onclick="RefreshAll">
                <Icon Name="reset" Size="18" />
                @if (FiltersActive)
                {
                    <span class="filter-dot" aria-hidden="true"></span>
                }
            </button>

            <div id="inventory-filters" class="filter-extra @(filtersOpen ? "open" : "")">

                @if (transactionTab)
                {
                    @* Thời gian: mốc nhanh (áp dụng ngay) hoặc "Chọn khoảng ngày…" (chỉ lọc khi bấm Áp dụng) — giống trang Đơn hàng *@
                    <select class="date-preset"
                            aria-label="Lọc theo thời gian giao dịch"
                            @bind="datePreset"
                            @bind:after="OnDatePresetChanged">
                        @foreach (var p in DatePresets.Options)
                        {
                            <option value="@p">@DatePresets.Label(p)</option>
                        }
                    </select>

                    @if (datePreset == DatePresets.Custom)
                    {
                        <form class="custom-range" @onsubmit="ApplyCustomRange" novalidate>

                            <label class="range-field">
                                <span>Từ ngày</span>
                                <input type="date"
                                       @bind="customFrom"
                                       max="@DatePresets.IsoDate(customTo ?? DateTime.Today)"
                                       aria-invalid="@(dateError is not null ? "true" : null)"
                                       aria-describedby="@(dateError is not null ? "date-range-help" : null)" />
                            </label>

                            <label class="range-field">
                                <span>Đến ngày</span>
                                <input type="date"
                                       @bind="customTo"
                                       min="@(customFrom is { } cf ? DatePresets.IsoDate(cf) : null)"
                                       max="@DatePresets.IsoDate(DateTime.Today)"
                                       aria-invalid="@(dateError is not null ? "true" : null)"
                                       aria-describedby="@(dateError is not null ? "date-range-help" : null)" />
                            </label>

                            <button type="submit" class="btn primary btn-compact" disabled="@loading">Áp dụng</button>

                            @if (dateError is not null)
                            {
                                <p id="date-range-help" class="range-help is-error">@dateError</p>
                            }

                            <span class="sr-only" role="alert">@dateError</span>

                        </form>
                    }

                    <select class="filter-half" aria-label="Lọc nguyên liệu" @bind="historyIngredient" @bind:after="ApplyHistoryFilter">
                        <option value="0">Tất cả nguyên liệu</option>
                        @foreach (var item in ingredients)
                        {
                            <option value="@item.MaNguyenLieu">@item.TenNguyenLieu</option>
                        }
                    </select>

                    <select class="filter-half" aria-label="Lọc loại giao dịch" @bind="historyType" @bind:after="ApplyHistoryFilter">
                        <option value="">Tất cả loại giao dịch</option>
                        @foreach (var type in HistoryTypes)
                        {
                            <option value="@type">@LoaiGiaoDichKho.Label(type)</option>
                        }
                    </select>
                }
                else
                {
                    @* Màn hình hẹp: xuống hàng sau nút Bộ lọc + Làm mới, 2 ô lọc chia đôi hàng dưới (như trang Đơn hàng) *@
                    <span class="filter-break" aria-hidden="true"></span>

                    <select class="filter-half" aria-label="Lọc trạng thái sử dụng" @bind="usageFilter" @bind:after="ApplyIngredientFilter">
                        @foreach (var u in LocSuDung.Options)
                        {
                            <option value="@u">@LocSuDung.Label(u)</option>
                        }
                    </select>

                    @* Giống trang Đơn hàng: chọn "Đã hủy" thì khóa lọc thanh toán; ở đây chọn "Ngừng sử dụng" thì khóa lọc tình trạng tồn *@
                    <select class="filter-half"
                            aria-label="Lọc tình trạng tồn kho"
                            @bind="stockFilter"
                            @bind:after="ResetPage"
                            disabled="@(usageFilter == LocSuDung.NgungSuDung)"
                            title="@(usageFilter == LocSuDung.NgungSuDung ? "Nguyên liệu ngừng sử dụng không lọc theo tình trạng tồn" : null)">
                        <option value="">Tất cả tình trạng</option>
                        @foreach (var s in TinhTrangKho.FilterOptions)
                        {
                            <option value="@s">@TinhTrangKho.Label(s)</option>
                        }
                    </select>
                }

            </div>

        </div>

        @* Khoảng thời gian đang lọc — ghi rõ mốc bắt đầu để không hiểu nhầm *@
        @if (transactionTab && fromDate is { } rangeFrom)
        {
            <p class="active-range">
                <Icon Name="calendar" Size="14" />
                @if (toDate is { } rangeTo)
                {
                    @(rangeFrom.Date == rangeTo.Date
                        ? $"Đang xem giao dịch ngày {rangeFrom:dd/MM/yyyy}"
                        : $"Đang xem giao dịch từ {rangeFrom:dd/MM/yyyy} đến hết {rangeTo:dd/MM/yyyy}")
                }
                else
                {
                    @($"Đang xem giao dịch từ {rangeFrom:HH:mm dd/MM/yyyy} đến nay ({DatePresets.Label(appliedPreset).ToLowerInvariant()})")
                }
            </p>
        }

    </section>

    @* Lịch sử kho chỉ để xem: phiếu nhập / xuất hủy tạo ở tab Nguyên liệu (trước đây 2 tab có 2 nút mở cùng một hộp thoại) *@
    @if (!transactionTab)
    {
        <section class="panel action-bar">

            <button class="btn primary"
                    @onclick="Add">

                <Icon Name="plus" />
                Thêm nguyên liệu

            </button>

            <button class="btn outline"
                    title="@(Selected switch
                    {
                        { DangSuDung: true } s => $"Tạo phiếu nhập / xuất hủy cho {s.TenNguyenLieu}",
                        { } s => $"{s.TenNguyenLieu} đã ngừng sử dụng — chọn nguyên liệu khác trong phiếu",
                        _ => "Tạo phiếu nhập hàng hoặc xuất hủy"
                    })"
                    @onclick="Transact">

                <Icon Name="box" />
                Nhập / xuất hủy

            </button>

            <button class="btn outline"
                    disabled="@(Selected is null)"
                    title="@(Selected is null ? "Chọn một nguyên liệu trong bảng để sửa" : null)"
                    @onclick="Edit">

                <Icon Name="edit" />
                Sửa

            </button>

        </section>
    }

    @if (message is not null)
    {
        <p class="alert success" role="status">
            @message
        </p>
    }

    @if (loadError is not null)
    {
        <p class="alert error" role="alert">
            @loadError
            <button type="button" class="text-button" @onclick="() => Load()">Thử lại</button>
        </p>
    }

    @* Cảnh báo cần nhập thêm: vàng = có nguyên liệu "Sắp hết", đỏ = có nguyên liệu "Hết hàng" (cùng màu huy hiệu).
       Ẩn khi đang xem nguyên liệu ngừng sử dụng (các nguyên liệu được nhắc không nằm trong danh sách đó). *@
    @if (!transactionTab && NeedRestockCount > 0 && usageFilter != LocSuDung.NgungSuDung)
    {
        var outOfStock = ingredients.Where(i => i.TinhTrang == TinhTrangKho.HetHang).ToList();
        var lowStock = ingredients.Where(i => i.TinhTrang == TinhTrangKho.SapHet).ToList();

        @* Nêu rõ từng nguyên liệu cần nhập: hết hàng (chỉ tên) và sắp hết (tên + số còn lại) *@
        @* role="status" chỉ trên phần chữ: trình đọc màn hình đọc nội dung cảnh báo, không đọc lại nút *@
        <div class="alert restock-alert @(outOfStock.Count > 0 ? "red" : "yellow")">
            <div class="restock-text" role="status">
                <strong>Cần nhập thêm @NeedRestockCount nguyên liệu</strong>
                @if (outOfStock.Count > 0)
                {
                    <p>
                        <span class="restock-label">Hết hàng:</span>
                        @for (int k = 0; k < outOfStock.Count; k++)
                        {
                            @* Mỗi mục không ngắt dòng bên trong; danh sách chỉ xuống dòng sau dấu phẩy *@
                            <span class="restock-item">@outOfStock[k].TenNguyenLieu@(k < outOfStock.Count - 1 ? "," : "")</span>
                            @(" ")
                        }
                    </p>
                }
                @if (lowStock.Count > 0)
                {
                    <p>
                        <span class="restock-label">Sắp hết:</span>
                        @for (int k = 0; k < lowStock.Count; k++)
                        {
                            var item = lowStock[k];
                            <span class="restock-item">@item.TenNguyenLieu còn @Number(item.SoLuongTon) @item.DonViTinh@(k < lowStock.Count - 1 ? "," : "")</span>
                            @(" ")
                        }
                    </p>
                }
            </div>
            @* Ẩn "Lọc danh sách" chỉ khi danh sách đang hiện ĐÚNG các nguyên liệu được đếm *@
            @if (!(stockFilter == TinhTrangKho.CanNhapFilter && search.Trim() == "" && usageFilter == LocSuDung.DangSuDung))
            {
                <button type="button" class="text-button restock-filter" @onclick="ShowNeedRestock">Lọc danh sách</button>
            }
        </div>
    }

    @* tabindex="-1": nhận focus bằng code sau khi bấm "Lọc danh sách" (nút đó tự ẩn), không nằm trong vòng Tab *@
    <section class="panel list-panel" tabindex="-1" aria-label="Danh sách" @ref="listPanel">

        <div class="table-wrap">

            @* Lớp riêng cho từng bảng để ẩn / gộp cột phụ trên màn hình hẹp (CSS mục [11]) *@
            <table class="inventory-table @(transactionTab ? "stock-history-table" : "ingredient-table")">

                <thead>

                    @if (transactionTab)
                    {
                        <tr>
                            <th>Mã</th>
                            <th>Thời gian</th>
                            <th>Nguyên liệu</th>
                            <th>Loại</th>
                            <th>Thay đổi</th>
                            <th>Đơn hàng</th>
                            <th>Ghi chú</th>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <th>Mã NL</th>
                            <th>Tên nguyên liệu</th>
                            <th>Tồn kho</th>
                            <th>Mức cảnh báo</th>
                            <th>Tình trạng</th>
                        </tr>
                    }

                </thead>

                <tbody>

                    @if (transactionTab)
                    {
                        @foreach (var item in history)
                        {
                            <tr @key="item.MaLichSu">
                                <td>@item.MaLichSu</td>
                                <td>@item.ThoiGian.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @item.TenNguyenLieu
                                    @* Điện thoại: cột Đơn hàng / Ghi chú bị ẩn → hiện gọn dưới tên nguyên liệu *@
                                    @if (HistorySubText(item) is { } sub)
                                    {
                                        <span class="stock-sub">@sub</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge @LoaiGiaoDichKho.Color(item.LoaiGiaoDich)">
                                        @LoaiGiaoDichKho.Label(item.LoaiGiaoDich)
                                    </span>
                                </td>

                                <td class="@(item.SoLuongThayDoi < 0 ? "text-danger" : "")">
                                    @(item.SoLuongThayDoi > 0 ? "+" : "")@Number(item.SoLuongThayDoi) @UnitOf(item.MaNguyenLieu)
                                </td>

                                <td>@(item.MaDonHang is { } don ? $"#{don}" : "—")</td>
                                <td>@(item.GhiChu ?? "—")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        @foreach (var item in VisibleIngredients)
                        {
                            string status = item.TinhTrang;

                            <tr @key="item.MaNguyenLieu"
                                class="selectable @(selected == item.MaNguyenLieu ? "selected" : "")"
                                tabindex="0"
                                @onclick="() => selected = item.MaNguyenLieu"
                                @onkeydown="e => SelectKey(e, item.MaNguyenLieu)">

                                <td>@item.MaNguyenLieu</td>
                                <td>@item.TenNguyenLieu</td>
                                <td>
                                    <strong>@Number(item.SoLuongTon)</strong> @item.DonViTinh
                                    @* Màn hình hẹp: cột Mức cảnh báo bị ẩn → hiện gọn dưới số tồn *@
                                    <span class="stock-sub">Mức cảnh báo: @Number(item.MucCanhBaoToiThieu) @item.DonViTinh</span>
                                </td>
                                <td>@Number(item.MucCanhBaoToiThieu) @item.DonViTinh</td>

                                <td>
                                    <span class="badge @TinhTrangKho.Color(status)">
                                        @TinhTrangKho.Label(status)
                                    </span>
                                </td>

                            </tr>
                        }
                    }

                    @if (ItemCount == 0)
                    {
                        <tr>

                            <td class="empty-cell" colspan="@(transactionTab ? 7 : 5)">

                                <Icon Name="box" Size="32" />

                                <p>@EmptyText</p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="list-footer">

            <span>
                @(transactionTab ? historyTotal : FilteredIngredients.Count()) @(transactionTab ? "giao dịch" : "nguyên liệu")
                · Trang @(page)/@Pages
            </span>

            <div class="pagination">

                <button class="page-button"
                        aria-label="Trang trước"
                        disabled="@(page <= 1 || loading)"
                        @onclick="() => Move(-1)">
                    <Icon Name="left" Size="16" />
                </button>

                <span class="page-number">@(page)</span>

                <button class="page-button"
                        aria-label="Trang sau"
                        disabled="@(page >= Pages || loading)"
                        @onclick="() => Move(1)">
                    <Icon Name="right" Size="16" />
                </button>

            </div>

        </div>

    </section>

</div>

@if (dialog != "")
{
    <Modal Title="@DialogTitle"
           OnClose="Close"
           Busy="@saving">

        @if (dialog == "ingredient")
        {
            <EditForm Model="ingredientModel"
                      OnValidSubmit="SaveIngredient">

                <DataAnnotationsValidator />

                <div class="form-stack">

                    <div class="field">
                        <label for="i-name">Tên nguyên liệu *</label>
                        <InputText id="i-name"
                                   @bind-Value="ingredientModel.TenNguyenLieu"
                                   placeholder="Nhập tên nguyên liệu" />
                        <ValidationMessage For="@(() => ingredientModel.TenNguyenLieu)" />
                    </div>

                    <div class="field">
                        <label for="i-unit">Đơn vị tính *</label>
                        <InputText id="i-unit"
                                   @bind-Value="ingredientModel.DonViTinh"
                                   placeholder="gram, ml, cái, miếng…" />
                        <ValidationMessage For="@(() => ingredientModel.DonViTinh)" />
                    </div>

                    @if (!editingIngredient)
                    {
                        <div class="field">
                            <label for="i-stock">Tồn kho ban đầu</label>
                            <InputNumber id="i-stock"
                                         @bind-Value="ingredientModel.SoLuongTon"
                                         step="0.01" />
                            <ValidationMessage For="@(() => ingredientModel.SoLuongTon)" />
                        </div>
                    }

                    <div class="field">
                        <label for="i-min">Mức cảnh báo</label>
                        <InputNumber id="i-min"
                                     @bind-Value="ingredientModel.MucCanhBaoToiThieu"
                                     step="0.01" />
                        <ValidationMessage For="@(() => ingredientModel.MucCanhBaoToiThieu)" />
                    </div>

                    @if (editingIngredient)
                    {
                        @* Trạng thái: ô sổ xuống (Đang sử dụng / Ngừng sử dụng) theo yêu cầu chủ quán,
                           thay cho ô tích và nút "Ngừng sử dụng" riêng trên thanh công cụ (trùng chức năng) *@
                        <div class="field">
                            <label for="i-status">Trạng thái</label>
                            <InputSelect id="i-status"
                                         @bind-Value="ingredientModel.DangSuDung">
                                <option value="true">@LocSuDung.Label(LocSuDung.DangSuDung)</option>
                                <option value="false">@LocSuDung.Label(LocSuDung.NgungSuDung)</option>
                            </InputSelect>
                        </div>
                    }

                </div>

                @if (error is not null)
                {
                    <p class="alert error" role="alert">@error</p>
                }

                <div class="modal-footer">

                    <button type="button" class="btn outline"
                            disabled="@saving"
                            @onclick="Close">
                        Hủy
                    </button>

                    <button type="submit" class="btn primary" disabled="@saving">
                        @(saving ? "Đang lưu…"
                            : editingIngredient ? "Lưu thay đổi"
                            : "Thêm nguyên liệu")
                    </button>

                </div>

            </EditForm>
        }

        @if (dialog == "transaction")
        {
            <EditForm Model="transactionModel"
                      OnValidSubmit="SaveTransaction">

                <DataAnnotationsValidator />

                <div class="form-stack">

                    <div class="field">
                        <label for="t-type">Loại phiếu *</label>
                        <InputSelect id="t-type"
                                     @bind-Value="transactionModel.Loai">
                            <option value="@LoaiGiaoDichKho.NhapHang">@LoaiGiaoDichKho.Label(LoaiGiaoDichKho.NhapHang)</option>
                            <option value="@LoaiGiaoDichKho.XuatHuy">@LoaiGiaoDichKho.Label(LoaiGiaoDichKho.XuatHuy)</option>
                        </InputSelect>
                    </div>

                    <div class="field">
                        <label for="t-ingredient">Nguyên liệu *</label>
                        <InputSelect id="t-ingredient"
                                     @bind-Value="transactionModel.MaNguyenLieu">
                            <option value="0">Chọn nguyên liệu</option>
                            @foreach (var item in ingredients.Where(i => i.DangSuDung))
                            {
                                <option value="@item.MaNguyenLieu">@item.TenNguyenLieu (tồn @Number(item.SoLuongTon) @item.DonViTinh)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => transactionModel.MaNguyenLieu)" />
                    </div>

                    <div class="field">
                        <label for="t-qty">Số lượng@(UnitOf(transactionModel.MaNguyenLieu) is { Length: > 0 } unit ? $" ({unit})" : "") *</label>
                        <InputNumber id="t-qty"
                                     @bind-Value="transactionModel.SoLuong"
                                     step="0.01" />
                        <ValidationMessage For="@(() => transactionModel.SoLuong)" />
                    </div>

                    <div class="field">
                        <label for="t-note">Ghi chú</label>
                        <InputTextArea id="t-note"
                                       @bind-Value="transactionModel.GhiChu"
                                       placeholder="Nhà cung cấp, lý do xuất hủy…"
                                       rows="2" />
                        <ValidationMessage For="@(() => transactionModel.GhiChu)" />
                    </div>

                </div>

                @if (error is not null)
                {
                    <p class="alert error" role="alert">@error</p>
                }

                <div class="modal-footer">

                    <button type="button" class="btn outline"
                            disabled="@saving"
                            @onclick="Close">
                        Hủy
                    </button>

                    <button type="submit" class="btn primary" disabled="@saving">
                        @(saving ? "Đang lưu…" : "Lưu phiếu")
                    </button>

                </div>

            </EditForm>
        }

    </Modal>
}

@code {
    private static readonly System.Globalization.CultureInfo Vi = new("vi-VN");

    private static readonly string[] HistoryTypes =
        [LoaiGiaoDichKho.NhapHang, LoaiGiaoDichKho.XuatHuy, LoaiGiaoDichKho.TieuHaoTheoDon];

    private readonly CancellationTokenSource pageCts = new();

    private ElementReference listPanel;

    private List<NguyenLieu> ingredients = [];
    private List<LichSuKho> history = [];
    private int historyTotal;
    private int historyPages = 1;

    // Đổi bộ lọc nhanh → nhiều lần tải chồng nhau; lượt mới hủy lượt cũ, chỉ nhận kết quả của lượt mới nhất
    private CancellationTokenSource? loadCts;
    private int loadVersion;

    private bool transactionTab;
    private bool filtersOpen;   // màn hình hẹp: khung bộ lọc đang mở

    // Bộ lọc tab Nguyên liệu (lọc tại chỗ — danh sách nguyên liệu ít)
    private string search = "";
    private string usageFilter = LocSuDung.DangSuDung;
    private string stockFilter = "";

    // Bộ lọc tab Lịch sử kho (lọc ở máy chủ, có phân trang)
    private int historyIngredient;
    private string historyType = "";
    private string datePreset = DatePresets.All;      // lựa chọn đang hiện trong ô chọn
    private string appliedPreset = DatePresets.All;   // lựa chọn ĐANG ÁP DỤNG (Custom chỉ có hiệu lực sau khi bấm Áp dụng)
    private DateTime? fromDate;     // mốc đang lọc (tính lại mỗi lần tải với mốc nhanh)
    private DateTime? toDate;       // chỉ có với khoảng ngày tự chọn
    private DateTime? customFrom;
    private DateTime? customTo;
    private string? dateError;

    private int? selected;
    private int page = 1;
    private const int PageSize = 10;

    private string dialog = "";
    private bool editingIngredient;
    private bool editingWasActive;   // trạng thái sử dụng lúc mở hộp thoại Sửa (để báo "đã ngừng" / "sử dụng lại")
    private bool loading;
    private bool refreshing;
    private bool saving;
    private string? error;
    private string? loadError;
    private string? message;

    private NguyenLieuForm ingredientModel = new();
    private GiaoDichKhoForm transactionModel = new();

    private static string Number(decimal value) => value.ToString("#,##0.##", Vi);

    private static string? HistorySubText(LichSuKho item)
    {
        var parts = new List<string>(2);
        if (item.MaDonHang is { } don) parts.Add($"Đơn #{don}");
        if (!string.IsNullOrWhiteSpace(item.GhiChu)) parts.Add(item.GhiChu);
        return parts.Count > 0 ? string.Join(" · ", parts) : null;
    }

    private string UnitOf(int maNguyenLieu) =>
        ingredients.FirstOrDefault(i => i.MaNguyenLieu == maNguyenLieu)?.DonViTinh ?? "";

    // Chỉ tính dòng đang thấy trên trang hiện tại: nguyên liệu bị ẩn (vừa ngừng sử dụng, bị lọc,
    // hoặc nằm ở trang khác) không còn được "chọn" ngầm cho nút Sửa / Nhập / xuất hủy
    private NguyenLieu? Selected => VisibleIngredients.FirstOrDefault(i => i.MaNguyenLieu == selected);

    private int NeedRestockCount => ingredients.Count(TinhTrangKho.CanNhap);

    private string DialogTitle => dialog switch
    {
        "ingredient" => editingIngredient ? "Sửa nguyên liệu" : "Thêm nguyên liệu",
        "transaction" => "Phiếu nhập hàng / xuất hủy",
        _ => ""
    };

    // ---------------------------------------------------------------- Bộ lọc

    private int ActiveFilterCount => transactionTab
        ? (appliedPreset != DatePresets.All ? 1 : 0) + (historyIngredient > 0 ? 1 : 0) + (historyType != "" ? 1 : 0)
        : (usageFilter != LocSuDung.DangSuDung ? 1 : 0) + (stockFilter != "" ? 1 : 0);

    // Đang lọc / tìm khác mặc định → nút Làm mới có chấm báo (bấm sẽ đưa về mặc định)
    private bool FiltersActive => ActiveFilterCount > 0 || (!transactionTab && search.Trim() != "");

    private string RefreshTitle => transactionTab
        ? (FiltersActive ? "Làm mới và bỏ lọc, xem toàn bộ lịch sử kho" : "Làm mới lịch sử kho")
        : (FiltersActive ? "Làm mới và bỏ lọc, xem nguyên liệu đang sử dụng" : "Làm mới danh sách nguyên liệu");

    private IEnumerable<NguyenLieu> FilteredIngredients
    {
        get
        {
            string term = search.Trim();

            return ingredients.Where(i =>
                (term == ""
                 || i.MaNguyenLieu.ToString(System.Globalization.CultureInfo.InvariantCulture).Contains(term, StringComparison.Ordinal)
                 || i.TenNguyenLieu.Contains(term, StringComparison.OrdinalIgnoreCase))
                && usageFilter switch
                {
                    LocSuDung.NgungSuDung => !i.DangSuDung,
                    LocSuDung.TatCa => true,
                    _ => i.DangSuDung
                }
                // Lọc tình trạng tồn chỉ áp dụng cho nguyên liệu đang sử dụng
                && (usageFilter == LocSuDung.NgungSuDung || TinhTrangKho.Matches(i, stockFilter)))
                // Lọc "Cần nhập thêm": nguyên liệu Hết hàng lên đầu (nhập gấp), giữ thứ tự tên trong từng nhóm
                .OrderBy(i => stockFilter == TinhTrangKho.CanNhapFilter && i.TinhTrang != TinhTrangKho.HetHang ? 1 : 0);
        }
    }

    private List<NguyenLieu> VisibleIngredients =>
        FilteredIngredients
            .Skip((page - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int ItemCount => transactionTab ? history.Count : VisibleIngredients.Count;

    private int Pages => transactionTab
        ? Math.Max(1, historyPages)
        : Math.Max(1, (int)Math.Ceiling(FilteredIngredients.Count() / (double)PageSize));

    private string EmptyText =>
        loading ? "Đang tải dữ liệu…"
        : FiltersActive ? (transactionTab ? "Không có giao dịch khớp bộ lọc." : "Không có nguyên liệu khớp bộ lọc.")
        : transactionTab ? "Chưa có giao dịch kho." : "Chưa có nguyên liệu.";

    // ---------------------------------------------------------------- Tải dữ liệu

    protected override async Task OnInitializedAsync() => await Load();

    /// <summary>Tải danh sách nguyên liệu (và lịch sử nếu đang ở tab Lịch sử kho); true nếu thành công.</summary>
    private Task<bool> Load() => RunLoad(async ct =>
    {
        var list = await InventoryApi.GetIngredientsAsync(ct: ct);
        ct.ThrowIfCancellationRequested();
        ingredients = list;

        if (transactionTab)
        {
            await LoadHistory(ct);
        }
        else
        {
            page = Math.Clamp(page, 1, Pages);
        }
    });

    /// <summary>Lịch sử kho phân trang ở máy chủ (có thể rất nhiều dòng).</summary>
    private async Task LoadHistory(CancellationToken ct)
    {
        // Mốc nhanh tính lại theo thời điểm hiện tại mỗi lần tải (khoảng trượt), giống trang Đơn hàng
        if (appliedPreset != DatePresets.Custom)
        {
            fromDate = DatePresets.From(appliedPreset, DateTime.Now);
            toDate = null;
        }

        var result = await InventoryApi.GetHistoryAsync(
            page, PageSize,
            historyIngredient > 0 ? historyIngredient : null,
            historyType == "" ? null : historyType,
            fromDate, toDate,
            ct);

        // Lượt này đã bị lượt mới hơn thay thế → không ghi đè dữ liệu
        ct.ThrowIfCancellationRequested();

        history = result.Data;
        historyTotal = result.Meta.Total;
        historyPages = result.Meta.TotalPages;
    }

    /// <summary>
    /// Chạy một lượt tải: hiện trạng thái đang tải, báo lỗi; trả về true nếu thành công.
    /// Mỗi lượt mới hủy lượt đang chạy (đổi bộ lọc nhanh): lượt cũ không ghi đè dữ liệu,
    /// không hiện lỗi và không tắt trạng thái đang tải của lượt mới.
    /// </summary>
    private async Task<bool> RunLoad(Func<CancellationToken, Task> action)
    {
        // Hủy lượt cũ; lượt cũ tự giải phóng token của nó khi kết thúc (finally bên dưới)
        loadCts?.Cancel();
        var cts = CancellationTokenSource.CreateLinkedTokenSource(pageCts.Token);
        loadCts = cts;
        int version = ++loadVersion;

        loading = true;
        loadError = null;

        try
        {
            await action(cts.Token);
            return version == loadVersion;
        }
        catch (ApiException ex)
        {
            if (version == loadVersion) loadError = ex.Message;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Bị lượt mới thay thế hoặc rời trang
        }
        finally
        {
            if (version == loadVersion) loading = false;

            // Lượt đã bị thay thế: giải phóng token liên kết (bỏ đăng ký khỏi pageCts). Lượt mới nhất được giải phóng ở Dispose.
            if (!ReferenceEquals(loadCts, cts)) cts.Dispose();
        }

        return false;
    }

    private async Task SwitchTab(bool isTransaction)
    {
        if (transactionTab == isTransaction) return;

        transactionTab = isTransaction;
        page = 1;
        selected = null;
        message = null;
        filtersOpen = false;

        // Mỗi lần chuyển tab tải lại dữ liệu mới nhất (tồn kho thay đổi theo đơn đã thanh toán)
        await Load();
    }

    private void ResetPage() => page = 1;

    /// <summary>Nút "Lọc danh sách" trên cảnh báo: lọc nhanh các nguyên liệu đang sử dụng cần nhập thêm.</summary>
    private async Task ShowNeedRestock()
    {
        search = "";
        usageFilter = LocSuDung.DangSuDung;
        stockFilter = TinhTrangKho.CanNhapFilter;
        page = 1;

        // Nút vừa bấm sẽ ẩn → chuyển focus sang danh sách để người dùng bàn phím không bị đưa về đầu trang
        StateHasChanged();
        await Task.Yield();

        try
        {
            await listPanel.FocusAsync();
        }
        catch (JSException)
        {
            // Không đặt được focus thì bỏ qua (không ảnh hưởng việc lọc)
        }
    }

    private void ApplyIngredientFilter()
    {
        // Giống "Đã hủy" ở trang Đơn hàng: lọc ngừng sử dụng không đi cùng lọc tình trạng tồn
        if (usageFilter == LocSuDung.NgungSuDung) stockFilter = "";
        page = 1;
    }

    private async Task ApplyHistoryFilter()
    {
        page = 1;
        await RunLoad(LoadHistory);
    }

    private async Task OnDatePresetChanged()
    {
        dateError = null;

        if (datePreset == DatePresets.Custom)
        {
            // Mở 2 ô Từ / Đến, điền sẵn khoảng đang lọc (hoặc hôm nay). Chưa lọc cho tới khi bấm Áp dụng.
            customFrom = (fromDate ?? DateTime.Today).Date;
            customTo = (toDate ?? DateTime.Today).Date;
            return;
        }

        appliedPreset = datePreset;
        await ApplyHistoryFilter();
    }

    /// <summary>Xóa lỗi một nhịp rồi mới gán, để vùng live đọc lại cả khi lỗi trùng lần trước.</summary>
    private async Task ShowDateError(string text)
    {
        if (dateError == text)
        {
            dateError = null;
            StateHasChanged();
            await Task.Yield();
        }

        dateError = text;
    }

    private async Task ApplyCustomRange()
    {
        if (DatePresets.ValidateCustom(customFrom, customTo, out DateTime from, out DateTime to) is { } rangeError)
        {
            await ShowDateError(rangeError);
            return;
        }

        dateError = null;
        customFrom = from;
        customTo = to;
        fromDate = from;
        toDate = to;
        appliedPreset = DatePresets.Custom;

        await ApplyHistoryFilter();
    }

    /// <summary>Nút Làm mới: bỏ mọi bộ lọc của tab đang xem, về trang 1 và tải lại dữ liệu mới nhất.</summary>
    private async Task RefreshAll()
    {
        if (refreshing) return;

        page = 1;

        if (transactionTab)
        {
            historyIngredient = 0;
            historyType = "";
            datePreset = DatePresets.All;
            appliedPreset = DatePresets.All;
            fromDate = null;
            toDate = null;
            customFrom = null;
            customTo = null;
            dateError = null;
        }
        else
        {
            search = "";
            usageFilter = LocSuDung.DangSuDung;
            stockFilter = "";
        }

        // Tải lại là thao tác thường xuyên: không hiện thông báo "Đã tải lại…" (yêu cầu chủ quán).
        // Biểu tượng xoay khi đang tải là đủ phản hồi; chỉ hiện lỗi nếu tải thất bại.
        refreshing = true;
        message = null;

        try
        {
            await Load();
        }
        finally
        {
            refreshing = false;
        }
    }

    private async Task Move(int direction)
    {
        int next = page + direction;
        if (next < 1 || next > Pages) return;

        page = next;

        if (transactionTab)
        {
            await RunLoad(LoadHistory);
        }
    }

    private void SelectKey(KeyboardEventArgs e, int id)
    {
        if (e.Key is "Enter" or " ") selected = id;
    }

    // ---------------------------------------------------------------- Hộp thoại

    private void Add()
    {
        error = null;
        message = null;
        editingIngredient = false;
        ingredientModel = new NguyenLieuForm();
        dialog = "ingredient";
    }

    /// <summary>Phiếu nhập / xuất hủy: bấm được ngay; đang chọn nguyên liệu (đang sử dụng) thì điền sẵn.</summary>
    private void Transact()
    {
        error = null;
        message = null;
        transactionModel = new GiaoDichKhoForm
        {
            MaNguyenLieu = Selected is { DangSuDung: true } source ? source.MaNguyenLieu : 0
        };
        dialog = "transaction";
    }

    private void Edit()
    {
        if (Selected is not { } source) return;

        error = null;
        message = null;
        editingIngredient = true;
        editingWasActive = source.DangSuDung;
        ingredientModel = new NguyenLieuForm
        {
            MaNguyenLieu = source.MaNguyenLieu,
            TenNguyenLieu = source.TenNguyenLieu,
            DonViTinh = source.DonViTinh,
            SoLuongTon = source.SoLuongTon,
            MucCanhBaoToiThieu = source.MucCanhBaoToiThieu,
            DangSuDung = source.DangSuDung
        };
        dialog = "ingredient";
    }

    private void Close()
    {
        if (saving) return;

        dialog = "";
        error = null;
    }

    /// <summary>Gọi API ghi dữ liệu: khóa nút, báo lỗi trong hộp thoại, tải lại danh sách khi xong.</summary>
    private async Task Save(Func<Task<string>> action)
    {
        if (saving) return;

        saving = true;
        error = null;

        try
        {
            message = await action();
            dialog = "";
            await Load();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            saving = false;
        }
    }

    private Task SaveIngredient() => Save(async () =>
    {
        if (editingIngredient)
        {
            bool wasActive = editingWasActive;

            var saved = await InventoryApi.UpdateAsync(ingredientModel.MaNguyenLieu, new NguyenLieuCapNhatRequest
            {
                TenNguyenLieu = ingredientModel.TenNguyenLieu.Trim(),
                DonViTinh = ingredientModel.DonViTinh.Trim(),
                MucCanhBaoToiThieu = ingredientModel.MucCanhBaoToiThieu,
                DangSuDung = ingredientModel.DangSuDung
            }, pageCts.Token);

            return (wasActive, saved.DangSuDung) switch
            {
                (true, false) => $"Đã ngừng sử dụng nguyên liệu {saved.TenNguyenLieu}.",
                (false, true) => $"Đã sử dụng lại nguyên liệu {saved.TenNguyenLieu}.",
                _ => $"Đã cập nhật nguyên liệu {saved.TenNguyenLieu}."
            };
        }

        var created = await InventoryApi.CreateAsync(new NguyenLieuRequest
        {
            TenNguyenLieu = ingredientModel.TenNguyenLieu.Trim(),
            DonViTinh = ingredientModel.DonViTinh.Trim(),
            SoLuongTon = ingredientModel.SoLuongTon,
            MucCanhBaoToiThieu = ingredientModel.MucCanhBaoToiThieu,
            DangSuDung = true
        }, pageCts.Token);

        selected = created.MaNguyenLieu;
        return $"Đã thêm nguyên liệu {created.TenNguyenLieu}.";
    });

    private Task SaveTransaction() => Save(async () =>
    {
        var saved = await InventoryApi.TransactAsync(
            transactionModel.MaNguyenLieu,
            transactionModel.Loai,
            new GiaoDichKhoRequest
            {
                SoLuong = transactionModel.SoLuong,
                GhiChu = string.IsNullOrWhiteSpace(transactionModel.GhiChu) ? null : transactionModel.GhiChu.Trim()
            },
            pageCts.Token);

        string verb = transactionModel.Loai == LoaiGiaoDichKho.XuatHuy ? "xuất hủy" : "nhập";
        return $"Đã {verb} {Number(transactionModel.SoLuong ?? 0)} {saved.DonViTinh} {saved.TenNguyenLieu}. Tồn kho: {Number(saved.SoLuongTon)} {saved.DonViTinh}.";
    });

    public void Dispose()
    {
        pageCts.Cancel();
        loadCts?.Dispose();
        pageCts.Dispose();
    }
}
