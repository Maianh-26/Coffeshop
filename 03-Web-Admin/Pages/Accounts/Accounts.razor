@page "/accounts"
@attribute [Authorize(Roles = Roles.Admin)]
@implements IDisposable
@inject AccountService AccountApi
@inject AuthenticationService AuthService

<PageTitle>Tài khoản - Coffee Shop</PageTitle>

<div class="accounts-page">

    @* Thanh lọc chung (như Đơn hàng / Kho / Món / Khuyến mãi) *@
    <section class="panel filters-panel">

        <div class="filter-row">

            <div class="search-field">

                <Icon Name="search" />

                <input @bind="search"
                       @bind:event="oninput"
                       @bind:after="Filter"
                       maxlength="100"
                       placeholder="Tìm theo tên, tên đăng nhập hoặc mã…"
                       aria-label="Tìm tài khoản theo tên, tên đăng nhập hoặc mã" />

            </div>

            <button type="button"
                    class="btn outline filters-toggle"
                    aria-expanded="@(filtersOpen ? "true" : "false")"
                    aria-controls="account-filters"
                    @onclick="() => filtersOpen = !filtersOpen">
                <Icon Name="filter" />
                Bộ lọc@(ActiveFilterCount > 0 ? $" ({ActiveFilterCount})" : "")
            </button>

            <RefreshButton Active="FiltersActive" Spinning="refreshing" Title="@RefreshTitle" OnClick="RefreshAll" />

            <div id="account-filters" class="filter-extra @(filtersOpen ? "open" : "")">

                <span class="filter-break" aria-hidden="true"></span>

                <select class="filter-half" aria-label="Lọc vai trò" @bind="roleFilter" @bind:after="Filter">
                    <option value="">Tất cả vai trò</option>
                    <option value="@Roles.Admin">@Roles.Label(Roles.Admin)</option>
                    <option value="@Roles.Staff">@Roles.Label(Roles.Staff)</option>
                </select>

            </div>

        </div>

    </section>

    <CrudActions AddLabel="Thêm tài khoản"
                 ItemName="tài khoản"
                 HasSelection="@(Selected is not null)"
                 DeleteBlockedReason="@(IsMe(Selected) ? "Không thể xóa tài khoản đang đăng nhập" : null)"
                 OnAdd="Add"
                 OnEdit="Edit"
                 OnDelete="AskDelete" />

    @if (message is not null)
    {
        <p class="alert success" role="status">
            @message
        </p>
    }

    @if (loadError is not null)
    {
        <p class="alert error" role="alert">
            @loadError
            <button type="button" class="text-button" @onclick="Load">Thử lại</button>
        </p>
    }

    <section class="panel list-panel">

        <div class="table-wrap">

            @* account-table: gộp cột phụ trên màn hình hẹp (CSS mục [13]) *@
            <table class="account-table">

                <thead>

                    <tr>
                        <SortHeader Sort="sort" Key="@SortId" Label="Mã TK" Name="mã tài khoản" OnSort="ToggleSort" />
                        <th>Họ và tên</th>
                        <th>Tên đăng nhập</th>
                        <th>Vai trò</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in VisibleAccounts)
                    {
                        <tr @key="item.MaNguoiDung"
                            class="selectable @(selected == item.MaNguoiDung ? "selected" : "")"
                            tabindex="0"
                            @onclick="() => selected = item.MaNguoiDung"
                            @onkeydown="e => SelectKey(e, item.MaNguoiDung)">

                            <td>@item.MaNguoiDung</td>
                            <td>
                                @item.HoTen
                                @* Màn hình hẹp: cột Tên đăng nhập bị ẩn → hiện gọn dưới họ tên *@
                                <span class="stock-sub sub-login">@item.TenDangNhap</span>
                            </td>
                            <td>@item.TenDangNhap</td>

                            <td>
                                <span class="badge @(item.VaiTro == Roles.Admin ? "yellow" : "green")">
                                    @Roles.Label(item.VaiTro)
                                </span>
                            </td>

                        </tr>
                    }

                    @if (VisibleAccounts.Count == 0)
                    {
                        <EmptyRow Columns="4"
                                  IconName="user"
                                  Text="@EmptyText"
                                  ShowClear="@(!loading && FiltersActive)"
                                  OnClear="RefreshAll" />
                    }

                </tbody>

            </table>

        </div>

        <div class="list-footer">

            <span>
                @FilteredAccounts.Count() tài khoản
                · Trang @(page)/@Pages
            </span>

            <div class="pagination">

                <button class="page-button"
                        aria-label="Trang trước"
                        disabled="@(page <= 1)"
                        @onclick="() => Move(-1)">
                    <Icon Name="left" Size="16" />
                </button>

                <span class="page-number">@(page)</span>

                <button class="page-button"
                        aria-label="Trang sau"
                        disabled="@(page >= Pages)"
                        @onclick="() => Move(1)">
                    <Icon Name="right" Size="16" />
                </button>

            </div>

        </div>

    </section>

</div>

@if (dialog != "")
{
    <Modal Title="@DialogTitle"
           OnClose="Close"
           Busy="@saving">

        @if (dialog == "form")
        {
            <EditForm Model="model"
                      OnValidSubmit="Save">

                <DataAnnotationsValidator />

                <div class="form-stack">

                    <div class="field">
                        <label for="a-username">Tên đăng nhập *</label>
                        <InputText id="a-username"
                                   @bind-Value="model.TenDangNhap"
                                   readonly="@editing"
                                   placeholder="ví dụ: lan.nv"
                                   autocomplete="off" />
                        <ValidationMessage For="@(() => model.TenDangNhap)" />
                    </div>

                    <div class="field">
                        <label for="a-name">Họ và tên *</label>
                        <InputText id="a-name"
                                   @bind-Value="model.HoTen"
                                   placeholder="Nhập họ và tên" />
                        <ValidationMessage For="@(() => model.HoTen)" />
                    </div>

                    <div class="field">
                        <label for="a-role">Vai trò</label>
                        <InputSelect id="a-role"
                                     @bind-Value="model.VaiTro">
                            <option value="@Roles.Staff">@Roles.Label(Roles.Staff)</option>
                            <option value="@Roles.Admin">@Roles.Label(Roles.Admin)</option>
                        </InputSelect>
                    </div>

                    <div class="field">
                        <label for="a-password">@(editing ? "Đặt lại mật khẩu" : "Mật khẩu *")</label>
                        <InputText id="a-password"
                                   type="password"
                                   @bind-Value="model.MatKhau"
                                   placeholder="@(editing ? "Để trống nếu giữ mật khẩu cũ" : "Tối thiểu 6 ký tự")"
                                   autocomplete="new-password" />
                        <ValidationMessage For="@(() => model.MatKhau)" />
                    </div>

                </div>

                @if (error is not null)
                {
                    <p class="alert error" role="alert">@error</p>
                }

                <div class="modal-footer">

                    <button type="button" class="btn outline"
                            disabled="@saving"
                            @onclick="Close">
                        Hủy
                    </button>

                    <button type="submit" class="btn primary" disabled="@saving">
                        @(saving ? "Đang lưu…"
                            : editing ? "Lưu thay đổi"
                            : "Thêm tài khoản")
                    </button>

                </div>

            </EditForm>
        }

        @if (dialog == "delete" && Selected is { } target)
        {
            <p>Xóa tài khoản <strong>@target.HoTen (@target.TenDangNhap)</strong>?</p>

            @if (error is not null)
            {
                <p class="alert error" role="alert">@error</p>
            }

            <div class="modal-footer">

                <button class="btn outline" disabled="@saving" @onclick="Close">
                    Hủy
                </button>

                <button class="btn danger" disabled="@saving" @onclick="Delete">
                    @(saving ? "Đang xóa…" : "Xóa")
                </button>

            </div>
        }

    </Modal>
}

@code {
    private readonly CancellationTokenSource pageCts = new();

    private List<NguoiDung> accounts = [];

    private string search = "";
    private string roleFilter = "";
    private bool filtersOpen;       // màn hình hẹp: khung bộ lọc đang mở
    private bool refreshing;        // đang tải lại do bấm nút Làm mới

    private readonly ColumnSort sort = new();
    private const string SortId = "id";
    private int? selected;
    private int page = 1;
    private const int PageSize = 10;

    private string dialog = "";
    private bool editing;
    private bool loading;
    private bool saving;
    private string? error;
    private string? loadError;
    private string? message;

    private NguoiDungForm model = new();

    // Chỉ tính dòng đang thấy: tài khoản bị lọc / ở trang khác không còn được "chọn" ngầm cho nút Sửa / Xóa
    private NguoiDung? Selected => VisibleAccounts.FirstOrDefault(a => a.MaNguoiDung == selected);

    /// <summary>Mã tài khoản đang đăng nhập (không cho tự xóa; backend cũng chặn tự hạ quyền — 409).</summary>
    private int? myId;

    private bool IsMe(NguoiDung? account) => account is not null && account.MaNguoiDung == myId;

    private string DialogTitle => dialog switch
    {
        "form" => editing ? "Sửa tài khoản" : "Thêm tài khoản",
        "delete" => "Xóa tài khoản",
        _ => ""
    };

    private int ActiveFilterCount => roleFilter != "" ? 1 : 0;

    // Đang lọc / tìm / sắp xếp khác mặc định → nút Làm mới có chấm báo
    private bool FiltersActive => ActiveFilterCount > 0 || search.Trim() != "" || sort.Active;

    private string RefreshTitle => FiltersActive ? "Làm mới và bỏ lọc, xem toàn bộ tài khoản" : "Làm mới danh sách tài khoản";

    private string EmptyText =>
        loading ? "Đang tải dữ liệu…"
        : FiltersActive ? "Không có tài khoản khớp bộ lọc."
        : "Chưa có tài khoản.";

    /// <summary>
    /// Tài khoản đã xóa (TrangThai = false) không hiện. Tìm không phân biệt dấu theo họ tên, tên đăng nhập, mã.
    /// </summary>
    private IEnumerable<NguoiDung> FilteredAccounts
    {
        get
        {
            string term = SearchText.Fold(search);

            return sort.Apply(
                accounts.Where(a =>
                    a.TrangThai
                    && (roleFilter == "" || a.VaiTro == roleFilter)
                    && (term == ""
                        || a.MaNguoiDung.ToString(System.Globalization.CultureInfo.InvariantCulture).Contains(term, StringComparison.Ordinal)
                        || SearchText.Contains(a.HoTen, term)
                        || SearchText.Contains(a.TenDangNhap, term))),
                (SortId, a => a.MaNguoiDung));
        }
    }

    private List<NguoiDung> VisibleAccounts =>
        FilteredAccounts
            .Skip((page - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int Pages => Math.Max(1, (int)Math.Ceiling(FilteredAccounts.Count() / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        var me = await AuthService.GetMyAccountAsync(pageCts.Token);
        myId = me.Success ? me.Data?.MaNguoiDung : null;

        await Load();
    }

    private async Task Load()
    {
        loading = true;
        loadError = null;

        try
        {
            accounts = await AccountApi.GetAllAsync(pageCts.Token);
            page = Math.Clamp(page, 1, Pages);
        }
        catch (ApiException ex)
        {
            loadError = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            loading = false;
        }
    }

    private void Filter()
    {
        page = 1;
    }

    private void ToggleSort(string key)
    {
        sort.Toggle(key);
        page = 1;
    }

    /// <summary>Nút Làm mới: bỏ mọi bộ lọc / tìm kiếm / sắp xếp, về trang 1 và tải lại.</summary>
    private async Task RefreshAll()
    {
        search = "";
        roleFilter = "";
        sort.Reset();
        page = 1;
        message = null;

        if (refreshing || loading) return;

        refreshing = true;

        try
        {
            await Load();
        }
        finally
        {
            refreshing = false;
        }
    }

    private void Move(int direction)
    {
        int next = page + direction;
        if (next >= 1 && next <= Pages) page = next;
    }

    private void SelectKey(KeyboardEventArgs e, int id)
    {
        if (e.Key is "Enter" or " ") selected = id;
    }

    private void Add()
    {
        editing = false;
        error = null;
        message = null;
        model = new NguoiDungForm { VaiTro = Roles.Staff, IsNew = true };
        dialog = "form";
    }

    private void Edit()
    {
        if (Selected is not { } source) return;

        editing = true;
        error = null;
        message = null;
        model = new NguoiDungForm
        {
            MaNguoiDung = source.MaNguoiDung,
            TenDangNhap = source.TenDangNhap,
            HoTen = source.HoTen,
            VaiTro = source.VaiTro,
            TrangThai = source.TrangThai
        };
        dialog = "form";
    }

    private void AskDelete()
    {
        if (Selected is null || IsMe(Selected)) return;

        error = null;
        message = null;
        dialog = "delete";
    }

    private void Close()
    {
        if (saving) return;

        dialog = "";
        error = null;
    }

    private async Task Save()
    {
        if (saving) return;

        if (!editing && string.IsNullOrEmpty(model.MatKhau))
        {
            error = "Nhập mật khẩu cho tài khoản mới (tối thiểu 6 ký tự).";
            return;
        }

        saving = true;
        error = null;

        try
        {
            NguoiDung saved;

            if (editing)
            {
                saved = await AccountApi.UpdateAsync(model.MaNguoiDung, new NguoiDungCapNhatRequest
                {
                    HoTen = model.HoTen.Trim(),
                    VaiTro = model.VaiTro,
                    MatKhauMoi = string.IsNullOrEmpty(model.MatKhau) ? null : model.MatKhau
                }, pageCts.Token);

                message = $"Đã cập nhật tài khoản {saved.HoTen}.";
            }
            else
            {
                saved = await AccountApi.CreateAsync(new NguoiDungTaoRequest
                {
                    TenDangNhap = model.TenDangNhap.Trim(),
                    MatKhau = model.MatKhau!,
                    HoTen = model.HoTen.Trim(),
                    // Web không nhập email (không có quên mật khẩu) — backend vẫn bắt buộc nên gửi email nội bộ
                    Email = NguoiDungTaoRequest.EmailNoiBo(model.TenDangNhap.Trim()),
                    VaiTro = model.VaiTro
                }, pageCts.Token);

                message = $"Đã thêm tài khoản {saved.HoTen}.";
            }

            dialog = "";
            selected = saved.MaNguoiDung;
            await Load();
        }
        catch (ApiException ex) when (ex.Status == 409 && !editing)
        {
            // Email gửi lên suy ra từ tên đăng nhập nên mọi lỗi trùng (tên đăng nhập hay email) đều là trùng tên đăng nhập.
            // Tài khoản đã xóa vẫn giữ tên đăng nhập trong CSDL (backend chưa có xóa thật) → trùng mà không thấy trong bảng
            error = "Tên đăng nhập đã được dùng (có thể bởi một tài khoản đã xóa) — hãy chọn tên đăng nhập khác.";
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            saving = false;
        }
    }

    private async Task Delete()
    {
        if (saving || Selected is not { } target || IsMe(target)) return;

        saving = true;
        error = null;

        try
        {
            await AccountApi.DeleteAsync(target.MaNguoiDung, pageCts.Token);

            message = $"Đã xóa tài khoản {target.HoTen}.";
            selected = null;
            dialog = "";
            await Load();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            saving = false;
        }
    }

    public void Dispose()
    {
        pageCts.Cancel();
        pageCts.Dispose();
    }
}
