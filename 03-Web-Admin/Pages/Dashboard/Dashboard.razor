@page "/"
@attribute [Authorize(Roles = Roles.Admin)]

<PageTitle>Tổng quan - Coffee Shop</PageTitle>

<div class="dashboard-toolbar">

    <div class="date-filters">

        <div class="date-range">

            <input type="date"
                   aria-label="Từ ngày"
                   @bind="filter.From" />

            <span>–</span>

            <input type="date"
                   aria-label="Đến ngày"
                   @bind="filter.To" />

        </div>

        <select aria-label="Khoảng thời gian"
                @onchange="ChangePeriod">

            <option value="">Tùy chọn</option>
            <option value="7" selected>7 ngày gần nhất</option>
            <option value="30">30 ngày gần nhất</option>
            <option value="month">Tháng này</option>
            <option value="all">Toàn bộ thời gian</option>

        </select>

        <button class="btn primary"
                disabled="@loading"
                @onclick="Apply">
            @(loading ? "Đang tải…" : "Áp dụng")
        </button>

    </div>

    <button class="btn primary"
            disabled="@(report is null)"
            @onclick="() => exportOpen = true">

        <Icon Name="download" />
        Xuất báo cáo

    </button>

</div>

<p class="filter-caption">
    @range
</p>

@if (error is not null)
{
    <p class="alert error" role="alert">
        @error
    </p>
}

<div class="stat-grid">

    <section class="stat-card">

        <span class="stat-icon">
            <Icon Name="coins" Size="25" />
        </span>

        <div>

            <p>Doanh thu đã thanh toán</p>

            <strong>
                @(report is null ? "—" : Money(report.DoanhThu))
            </strong>

            <small>Đã áp khuyến mãi; không tính đơn hủy.</small>

        </div>

    </section>

    <section class="stat-card">

        <span class="stat-icon">
            <Icon Name="orders" Size="25" />
        </span>

        <div>

            <p>Đơn đã thanh toán</p>

            <strong>
                @(report is null ? "—" : report.SoDonDaThanhToan + " đơn")
            </strong>

            <small>
                @(report is null
                    ? "Trong khoảng thời gian đã áp dụng."
                    : $"Chờ thanh toán: {report.SoDonChoThanhToan} · Đã hủy: {report.SoDonHuy}")
            </small>

        </div>

    </section>

    <section class="stat-card">

        <span class="stat-icon">
            <Icon Name="tag" Size="25" />
        </span>

        <div>

            <p>Giá trị đơn trung bình</p>

            <strong>
                @(report is null ? "—" : Money(report.GiaTriDonTrungBinh))
            </strong>

            <small>
                @(report is null
                    ? "Doanh thu chia số đơn đã thanh toán."
                    : $"Tiền mặt: {Money(report.TheoPhuongThuc.GetValueOrDefault(PhuongThucThanhToans.Cash))} · QR: {Money(report.TheoPhuongThuc.GetValueOrDefault(PhuongThucThanhToans.QrTransfer))}")
            </small>

        </div>

    </section>

</div>

<section class="panel chart-panel">

    <h2>Doanh thu theo ngày</h2>

    <span class="axis-unit">
        Triệu đồng
    </span>

    @if (Rows.Count == 0)
    {
        <div class="chart-empty">
            @(loading ? "Đang tải dữ liệu…" : "Chưa có doanh thu trong khoảng thời gian này.")
        </div>
    }
    else
    {
        <div class="chart-scroll">

            <div class="chart-container"
                 style="@($"min-width:{Math.Max(600, Rows.Count * 48)}px")">

                <div class="chart-axis">

                    @for (int i = 6; i >= 0; i--)
                    {
                        <span style="@AxisPosition(i)">
                            @((ChartMax * i / 6m / 1000000m)
                                .ToString("0.#", Vi))
                        </span>
                    }

                </div>

                <div class="plot">

                    <div class="grid-lines">

                        @for (int i = 0; i < 7; i++)
                        {
                            <div></div>
                        }

                    </div>

                    <div class="bars">

                        @foreach (var row in Rows)
                        {
                            <div class="bar-column">

                                <div class="bar-value-area">

                                    <strong style="@LabelPosition(row.DoanhThu)">
                                        @((row.DoanhThu / 1000000m)
                                            .ToString("0.#", Vi))
                                    </strong>

                                    <div class="bar"
                                         style="@BarHeight(row.DoanhThu)">
                                    </div>

                                </div>

                                <span>
                                    @row.Ngay.ToString("dd/MM", Vi)
                                </span>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>
    }

</section>

<section class="panel report-panel">

    <h2>Báo cáo theo ngày</h2>

    <div class="table-wrap">

        <table class="report-table">

            <thead>

                <tr>
                    <th>Ngày</th>
                    <th>Đơn đã thanh toán</th>
                    <th>Doanh thu</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var row in Rows)
                {
                    <tr>
                        <td>@row.Ngay.ToString("dd/MM/yyyy", Vi)</td>
                        <td>@row.SoDon</td>
                        <td>@Money(row.DoanhThu)</td>
                    </tr>
                }

                @if (Rows.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="empty-cell">
                            Chưa có dữ liệu báo cáo.
                        </td>
                    </tr>
                }

            </tbody>

            <tfoot>

                <tr>
                    <td>Tổng</td>
                    <td>@(report?.SoDonDaThanhToan ?? 0)</td>
                    <td>@Money(report?.DoanhThu ?? 0)</td>
                </tr>

            </tfoot>

        </table>

    </div>

</section>

<section class="panel report-panel">

    <h2>Món bán chạy</h2>

    <div class="table-wrap">

        <table class="report-table">

            <thead>

                <tr>
                    <th>#</th>
                    <th>Món</th>
                    <th>Số lượng</th>
                    <th>Doanh thu</th>
                </tr>

            </thead>

            <tbody>

                @for (int i = 0; i < bestSellers.Count; i++)
                {
                    var item = bestSellers[i];
                    int rank = i + 1;

                    <tr>
                        <td>@rank</td>
                        <td>@item.TenMon</td>
                        <td>@item.SoLuong</td>
                        <td>@Money(item.DoanhThu)</td>
                    </tr>
                }

                @if (bestSellers.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="empty-cell">
                            Chưa có món nào được bán trong khoảng thời gian này.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</section>

@if (exportOpen)
{
    <Modal Title="Xuất báo cáo"
           OnClose="() => exportOpen = false">

        <p>@range</p>

        <div class="actions">

            <button class="btn primary"
                    disabled="@exporting"
                    @onclick="ExportExcel">
                Excel (.csv)
            </button>

            <button class="btn outline"
                    @onclick="PrintPdf">
                PDF / In
            </button>

        </div>

        <p class="form-note">
            Báo cáo dùng bộ lọc đã Áp dụng.
            Với PDF, chọn Lưu dưới dạng PDF trong hộp thoại in.
        </p>

        <div class="modal-footer">

            <button class="btn outline"
                    @onclick="() => exportOpen = false">
                Đóng
            </button>

        </div>

    </Modal>
}
