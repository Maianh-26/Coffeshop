@page "/"
@attribute [Authorize(Roles = Roles.Admin)]

<PageTitle>Tổng quan - Coffee Shop</PageTitle>

@* Bộ lọc thời gian (mặc định Hôm nay): mốc nhanh áp dụng ngay, "Chọn khoảng ngày…" chỉ lọc khi bấm Áp dụng — giống trang Đơn hàng / Kho *@
<section class="panel filters-panel dashboard-filters-panel">

<div class="filter-row dashboard-filters">

    <select class="date-preset"
            aria-label="Khoảng thời gian báo cáo"
            @bind="datePreset"
            @bind:after="OnDatePresetChanged">
        @foreach (var p in DatePresets.ReportOptions)
        {
            <option value="@p">@DatePresets.Label(p)</option>
        }
    </select>

    <RefreshButton Active="FiltersActive" Spinning="loading" Title="@RefreshTitle" OnClick="RefreshAll" />

    @* Tải ngay file Excel (.xlsx) đúng khoảng đang xem: tổng quan, doanh thu theo mốc, top 50 món, top 50 topping *@
    <button type="button"
            class="btn primary dashboard-export"
            disabled="@(report is null || loading || exporting)"
            aria-busy="@(exporting ? "true" : "false")"
            @onclick="ExportExcel">
        <Icon Name="download" />
        @(exporting ? "Đang xuất…" : "Xuất Excel")
    </button>

    <span class="sr-only" role="status">@(exporting ? "Đang xuất file Excel…" : "")</span>

    @if (datePreset == DatePresets.Custom)
    {
        <form class="custom-range" @onsubmit="ApplyCustomRange" novalidate>

            <label class="range-field">
                <span>Từ ngày</span>
                <input type="date"
                       @bind="customFrom"
                       max="@DatePresets.IsoDate(customTo ?? DateTime.Today)"
                       aria-invalid="@(dateError is not null ? "true" : null)"
                       aria-describedby="@(dateError is not null ? "date-range-help" : null)" />
            </label>

            <label class="range-field">
                <span>Đến ngày</span>
                <input type="date"
                       @bind="customTo"
                       min="@(customFrom is { } cf ? DatePresets.IsoDate(cf) : null)"
                       max="@DatePresets.IsoDate(DateTime.Today)"
                       aria-invalid="@(dateError is not null ? "true" : null)"
                       aria-describedby="@(dateError is not null ? "date-range-help" : null)" />
            </label>

            <button type="submit" class="btn primary btn-compact" disabled="@loading">Áp dụng</button>

            @if (dateError is not null)
            {
                <p id="date-range-help" class="range-help is-error">@dateError</p>
            }

            <span class="sr-only" role="alert">@dateError</span>

        </form>
    }

</div>

</section>

@if (error is not null)
{
    <p class="alert error" role="alert">
        @error
    </p>
}

@if (exportError is not null)
{
    <p class="alert error" role="alert">
        @exportError
    </p>
}

<div class="stat-grid">

    <section class="stat-card">

        <span class="stat-icon">
            <Icon Name="coins" Size="25" />
        </span>

        <div>

            <p>Doanh thu thuần</p>

            <strong>
                @(report is null ? "—" : Money(report.DoanhThu))
            </strong>

            @if (report is not null)
            {
                <small>@PhuongThucThanhToans.Label(PhuongThucThanhToans.Cash): @Money(report.TheoPhuongThuc.GetValueOrDefault(PhuongThucThanhToans.Cash)) · @PhuongThucThanhToans.Label(PhuongThucThanhToans.QrTransfer): @Money(report.TheoPhuongThuc.GetValueOrDefault(PhuongThucThanhToans.QrTransfer))</small>
            }

        </div>

    </section>

    <section class="stat-card">

        <span class="stat-icon">
            <Icon Name="orders" Size="25" />
        </span>

        <div>

            <p>Đơn đã thanh toán</p>

            <strong>
                @(report is null ? "—" : report.SoDonDaThanhToan + " đơn")
            </strong>

            @if (report is not null)
            {
                <small>Chờ thanh toán: @report.SoDonChoThanhToan · Đã hủy: @report.SoDonHuy</small>
            }

        </div>

    </section>

    <section class="stat-card">

        <span class="stat-icon">
            <Icon Name="tag" Size="25" />
        </span>

        <div>

            <p>Giá trị đơn trung bình</p>

            <strong>
                @(report is null ? "—" : Money(report.GiaTriDonTrungBinh))
            </strong>

        </div>

    </section>

</div>

<section class="panel chart-panel">

    @* Tên cố định cho mọi khoảng lọc; đơn vị cột (giờ / ngày / tháng) thể hiện qua nhãn trục thời gian.
       Khoảng ngày đang xem ghi gọn ngay cạnh tiêu đề (thay cho dòng "Đang xem…" dưới bộ lọc). *@
    <div class="chart-head">
        <h2>Biểu đồ doanh thu</h2>
        @if (range != "")
        {
            <span class="chart-range">@range</span>
        }
    </div>

    <div class="chart-container @(loading ? "is-loading" : "")">

        @* Trục tiền tự co giãn theo mốc cao nhất; không có doanh thu → chỉ còn 0 đ *@
        <div class="chart-axis" aria-hidden="true">

            @for (int i = axis.Steps; i >= 0; i--)
            {
                <span style="@AxisPosition(i)">
                    @AxisLabel(axis.Step * i)
                </span>
            }

        </div>

        <div class="plot">

            <div class="grid-lines @(axis.Steps == 0 ? "is-zero" : "")" aria-hidden="true">

                @for (int i = 0; i <= axis.Steps; i++)
                {
                    <div></div>
                }

            </div>

            @if (!loading && axis.Steps == 0)
            {
                <p class="chart-note">Chưa có doanh thu trong khoảng thời gian này</p>
            }

            @* Bàn phím: cả biểu đồ chỉ là MỘT điểm dừng Tab, phím ← / → chuyển giữa các cột (roving tabindex) *@
            <div class="bars" role="group" aria-label="Các cột doanh thu, dùng phím mũi tên trái phải để chuyển">

                @for (int i = 0; i < points.Count; i++)
                {
                    var p = points[i];
                    int idx = i;

                    @* Rê chuột / chạm / chọn bằng bàn phím → tô nền cả cột và hiện doanh thu + số đơn *@
                    <div class="bar-column @TipSide(i)"
                         style="@BarVar(p.DoanhThu)"
                         @key="p.MocDayDu"
                         @ref="barRefs[idx]"
                         tabindex="@(idx == ActiveBar ? 0 : -1)"
                         role="img"
                         aria-label="@BarTitle(p)"
                         @onfocus="() => activeBar = idx"
                         @onkeydown="e => OnBarKey(e, idx)">

                        <div class="bar-value-area">

                            @if (p.DoanhThu > 0)
                            {
                                <div class="bar" style="@BarHeight(p.DoanhThu)"></div>
                            }

                            <div class="bar-tip" aria-hidden="true">
                                <span>@p.MocDayDu</span>
                                <strong>@Money(p.DoanhThu)</strong>
                                <small>@p.SoDon đơn</small>
                            </div>

                        </div>

                        <span class="bar-label @(IsMajorLabel(i) ? "" : "is-minor")" aria-hidden="true">
                            @if (ShowLabel(i))
                            {
                                @p.Moc
                                @if (p.MocPhu is not null)
                                {
                                    <small>@p.MocPhu</small>
                                }
                            }
                        </span>

                    </div>
                }

            </div>

        </div>

    </div>

</section>

<section class="panel report-panel">

    <h2>Món bán chạy</h2>

    <div class="table-wrap">

        <table class="report-table">

            <thead>

                <tr>
                    <th class="rank-col">#</th>
                    <th>Món</th>
                    <th class="num">Số lượng</th>
                    <th class="num">Doanh thu</th>
                </tr>

            </thead>

            <tbody>

                @for (int i = 0; i < bestSellers.Count; i++)
                {
                    var item = bestSellers[i];
                    int rank = i + 1;

                    <tr @key="item.MaTenMon">
                        <td class="rank-col">@rank</td>
                        <td>@item.TenMon</td>
                        <td class="num">@item.SoLuong</td>
                        <td class="num">@Money(item.DoanhThuGomTopping)</td>
                    </tr>
                }

                @if (bestSellers.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="empty-cell">
                            Chưa có món nào được bán trong khoảng thời gian này.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</section>

