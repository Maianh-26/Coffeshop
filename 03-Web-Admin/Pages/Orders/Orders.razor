@if (isOrderModalOpen)
{
    <Modal Title="@(editingOrderId is { } editId ? $"Sửa đơn hàng #{editId}" : "Tạo đơn hàng tại quầy")"
           OnClose="CloseOrderModal"
           Busy="@creating">

        <div class="order-modal-builder">

            @if (menuError is not null)
            {
                <p class="alert error" role="alert">@menuError</p>
            }

            <div class="form-grid">
                <div class="field">
                    <label for="order-payment">Hình thức thanh toán</label>
                    <select id="order-payment" @bind="draftPaymentMethod">
                        <option value="@PhuongThucThanhToans.Cash">@PhuongThucThanhToans.Label(PhuongThucThanhToans.Cash)</option>
                        <option value="@PhuongThucThanhToans.QrTransfer">@PhuongThucThanhToans.Label(PhuongThucThanhToans.QrTransfer)</option>
                    </select>
                </div>
            </div>

            <!-- Bộ công cụ thêm món vào đơn -->
            <div class="item-builder-card">
                <strong class="builder-title">Thêm món & topping vào đơn</strong>

                <div class="form-grid">
                    <div class="field">
                        <label for="builder-product">Chọn món</label>
                        <select id="builder-product" @bind="builderProductId" @bind:after="OnBuilderProductChanged">
                            @if (menuLoading)
                            {
                                <option value="0">Đang tải thực đơn…</option>
                            }
                            @foreach (var prod in menu)
                            {
                                <option value="@prod.MaTenMon">@prod.TenMon</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="builder-size">Kích cỡ</label>
                        <select id="builder-size" @bind="builderSizeId">
                            @foreach (var s in BuilderSizes)
                            {
                                <option value="@s.MaChiTietMon">
                                    @s.TenKichThuoc — @Money(s.GiaSauGiam)@(s.GiaSauGiam < s.GiaBan ? $" (gốc {Money(s.GiaBan)})" : "")
                                </option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="builder-quantity">Số lượng</label>
                        <input id="builder-quantity" type="number" min="1" max="50" @bind="builderQuantity" />
                    </div>

                    <div class="field">
                        <label for="builder-note">Ghi chú món</label>
                        <input id="builder-note" maxlength="255" @bind="builderNote" placeholder="70% đường, ít đá…" />
                    </div>
                </div>

                @if (availableToppings.Count > 0)
                {
                    <fieldset class="field">
                        <legend>Topping thêm (mỗi loại 1 phần/ly)</legend>
                        <div class="toppings-picker-grid">
                            @foreach (var top in availableToppings)
                            {
                                <label class="topping-checkbox-item">
                                    <input type="checkbox"
                                           checked="@selectedToppingIds.Contains(top.MaTopping)"
                                           @onchange="e => ToggleTopping(top.MaTopping, e)" />
                                    <span>@top.TenTopping (+@Money(top.GiaThem))</span>
                                </label>
                            }
                        </div>
                    </fieldset>
                }

                <div class="builder-actions">
                    <button type="button" class="btn outline" disabled="@(BuilderSize is null)" @onclick="AddItemToDraft">
                        <Icon Name="plus" Size="14" />
                        Thêm món này vào đơn
                    </button>
                </div>
            </div>

            <!-- Bảng các món trong đơn đang tạo -->
            <div>
                <strong class="builder-title">Các món trong đơn (@draftLines.Count):</strong>

                <div class="table-wrap builder-items-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Món & size</th>
                                <th>Topping</th>
                                <th>Đơn giá</th>
                                <th>SL</th>
                                <th>Thành tiền</th>
                                <th><span class="sr-only">Bỏ món</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in draftLines)
                            {
                                <tr>
                                    <td>
                                        <strong>@line.TenMon</strong>
                                        <div class="muted">@line.TenKichThuoc@(string.IsNullOrWhiteSpace(line.GhiChu) ? "" : $" · {line.GhiChu}")</div>
                                    </td>
                                    <td>
                                        @(line.Toppings.Count > 0 ? string.Join(", ", line.Toppings.Select(t => t.TenTopping)) : "Không")
                                    </td>
                                    <td>@Money(line.DonGia)</td>
                                    <td><strong>@line.SoLuong</strong></td>
                                    <td><strong class="text-accent">@Money(line.ThanhTien)</strong></td>
                                    <td>
                                        <button type="button" class="icon-button" aria-label="Bỏ @line.TenMon khỏi đơn" @onclick="() => draftLines.Remove(line)">
                                            <Icon Name="close" Size="14" />
                                        </button>
                                    </td>
                                </tr>
                            }

                            @if (draftLines.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="empty-cell">
                                        Chưa có món nào. Chọn món rồi bấm "Thêm món này vào đơn".
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4">Tạm tính:</td>
                                <td colspan="2"><strong class="grand-total small">@Money(draftLines.Sum(l => l.ThanhTien))</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <p class="form-note">
                    @(editingOrderId is null
                        ? "Tổng tiền chính thức do máy chủ tính khi tạo đơn (áp khuyến mãi theo giờ hiện tại)."
                        : "Tổng tiền chính thức do máy chủ tính lại khi lưu (áp khuyến mãi theo giờ tạo đơn).")
                </p>
            </div>

        </div>

        @if (orderModalError is not null)
        {
            <div class="alert error modal-error" role="alert">
                <span>@orderModalError</span>
                @if (shortages.Count > 0)
                {
                    <ul class="alert-list">
                        @foreach (var s in shortages)
                        {
                            <li>@s.TenNguyenLieu: cần @Number(s.CanDung) @s.DonViTinh, còn @Number(s.ConTon) @s.DonViTinh</li>
                        }
                    </ul>
                }
            </div>
        }

        <div class="modal-footer">
            <button type="button" class="btn outline" disabled="@creating" @onclick="CloseOrderModal">Hủy</button>
            <button type="button" class="btn primary" disabled="@(creating || draftLines.Count == 0)" @onclick="SaveDraftOrder">
                @(editingOrderId is null
                    ? (creating ? "Đang tạo đơn…" : "Tạo đơn hàng")
                    : (creating ? "Đang lưu…" : "Lưu thay đổi"))
            </button>
        </div>

    </Modal>
}

