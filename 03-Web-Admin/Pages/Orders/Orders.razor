    private void ShowAlert(string msg, string type, List<CanhBaoKho>? warnings = null)
    {
        alertMessage = msg;
        alertType = type;
        stockMessageActive = warnings is { Count: > 0 };

        if (stockMessageActive)
        {
            stockWarnings = warnings!;
            stockCollapsed = false;
            alertMessage += " Cảnh báo kho:";
        }
        else if (stockWarnings.Count > 0)
        {
            // Thông báo khác đến sau: GIỮ dòng cảnh báo kho (thu gọn) dưới thông báo mới, chỉ người dùng đóng mới mất
            stockCollapsed = true;
        }

        // Thông báo thành công tự ẩn sau vài giây. Có cảnh báo kho thì KHÔNG ẩn mà thu gọn còn 1 dòng
        // (vẫn bấm "Xem" để mở lại) — để không che khung chi tiết / nút thu tiền của đơn kế tiếp. Lỗi giữ đến khi đóng.
        int version = ++alertVersion;
        if (type == "success")
        {
            _ = DismissAlertLater(version, collapseOnly: stockMessageActive);
        }
    }

    private async Task DismissAlertLater(int version, bool collapseOnly = false)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(AlertSeconds), pageCts.Token);
        }
        catch (OperationCanceledException)
        {
            return; // rời trang
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        // Chỉ ẩn đúng thông báo đã hẹn giờ (có thông báo mới hơn thì để thông báo đó tự lo)
        if (version != alertVersion) return;

        if (collapseOnly)
        {
            stockCollapsed = true;
        }
        else
        {
            // Chỉ ẩn thông báo thường; dòng cảnh báo kho (nếu còn) ở lại
            alertMessage = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ClearAlert()
    {
        alertMessage = null;
        stockWarnings = [];
        stockMessageActive = false;
    }

