            userLoading = true;
            loadError = null;
        }

        // Mốc tính lại theo thời điểm hiện tại mỗi lần tải (kể cả lượt tự làm mới),
        // để "24 giờ qua" luôn đúng là 24 giờ tính tới lúc này
        if (appliedPreset != DatePresets.Custom)
        {
            fromDate = DatePresets.From(appliedPreset, DateTime.Now);
            toDate = null;
        }

        try
        {
            // "Đã hủy" là trạng thái thanh toán CANCELLED; các trạng thái còn lại là trạng thái phục vụ
            bool cancelledOnly = statusFilter == TrangThaiPhucVus.CancelledFilter;

            // Đang ở trang khác / đang lọc → dò đơn mới bằng 1 request riêng, chạy song song với request chính
            // (trang 1 theo thứ tự mặc định "mới nhất trước" mới chứa sẵn các đơn mới nhất)
            string? requestedSort = SortParam;
            bool unfilteredFirstPage = page == 1 && statusFilter == "" && paymentFilter == ""
                                       && !fromDate.HasValue && requestedSort is null;
            Task<PagedResult<DonHang>>? scanTask = unfilteredFirstPage
                ? null
                : OrderApi.GetPageAsync(1, NewOrderScan, ct: cts.Token);

            // Request chính lỗi / bị hủy thì scanTask không được await → "quan sát" lỗi của nó để không thành lỗi bị bỏ rơi
            _ = scanTask?.ContinueWith(t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted);

            var filter = new OrderFilter(
                cancelledOnly ? TrangThaiDon.Cancelled : (paymentFilter == "" ? null : paymentFilter),
                cancelledOnly || statusFilter == "" ? null : statusFilter,
                fromDate,
                toDate);

            if (requestedSort is not null && !serverSortSupported)
            {
                // Đã biết máy chủ chưa hỗ trợ "sapXep" → web tự sắp xếp TOÀN BỘ danh sách (không chỉ trang đang xem)
                if (!await LoadAllAndSort(filter, cts.Token)) return false;
            }
            else
            {
                var result = await OrderApi.GetPageAsync(
                    page, PageSize,
                    trangThai: filter.TrangThai,
                    trangThaiPhucVu: filter.TrangThaiPhucVu,
                    tuNgay: filter.TuNgay,
                    denNgay: filter.DenNgay,
                    sapXep: requestedSort,
                    ct: cts.Token);

                // Phản hồi của lượt tải cũ về sau khi đã có lượt mới (WASM không hủy kịp request đã xong):
                // bỏ qua, không ghi đè danh sách và không kết luận sai về khả năng sắp xếp của máy chủ
                if (cts.IsCancellationRequested) return false;

                // Máy chủ bỏ qua "sapXep" (trả về thứ tự mặc định) → chuyển sang tự sắp xếp toàn bộ ở web.
                // So với đúng thứ tự ĐÃ GỬI đi (requestedSort), không phải giá trị có thể vừa đổi trong lúc chờ.
                if (requestedSort is not null && requestedSort == SortParam && !IsSorted(result.Data))
                {
                    serverSortSupported = false;
                    if (!await LoadAllAndSort(filter, cts.Token)) return false;
                }
                else
                {
                    orders = result.Data;
                    totalOrders = result.Meta.Total;
                    totalPages = Math.Max(1, result.Meta.TotalPages);
                    sortTruncated = false;
                    listFromCache = false;
                    ClearClientSortCache();
                }
            }

            // Backend cũ không trả trangThaiPhucVu → ẩn phần phục vụ thay vì hiện "Chờ phục vụ" cho mọi đơn
            if (orders.Count > 0) servingSupported = orders.Any(o => o.TrangThaiPhucVu is not null);
            loadError = null;

            await RefreshSelected(cts.Token);

            // Dò đơn mới từ Tablet KHÔNG phụ thuộc trang / bộ lọc đang xem.
            // Trang 1 không lọc: dùng lại danh sách vừa tải nếu nó đã phủ hết phần đơn mới
            // (ít hơn 1 trang, hoặc đơn cuối trang đã cũ hơn mốc) — nếu không, hỏi riêng máy chủ để khỏi sót.
            bool pageCoversNew = unfilteredFirstPage
                                 && (!newOrdersInitialized || orders.Count < PageSize
                                     || orders.Min(o => o.MaDonHang) <= lastSeenOrderId);
            await CheckNewOrders(pageCoversNew ? orders : null, scanTask, cts.Token);
            completed = !cts.IsCancellationRequested;
        }
        catch (ApiException ex)
        {
            if (!cts.IsCancellationRequested)
            {
                loadError = ex.Message;
            }
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Bị thay bởi lần tải mới hơn, hoặc rời trang
        }
        finally
        {
            // Chỉ lần tải mới nhất mới được tắt cờ "đang tải"
            if (loadCts == cts)
            {
                loading = false;
                userLoading = false;
            }
        }

        return completed;
    }

    /// <summary>
    /// Cập nhật đơn đang xem: lấy từ trang vừa tải, nếu đơn không còn trong trang thì hỏi riêng máy chủ.
    /// </summary>
    private async Task RefreshSelected(CancellationToken ct)
    {
        if (selectedId is not { } id) return;

        var inPage = orders.FirstOrDefault(o => o.MaDonHang == id)
                     ?? clientSorted?.FirstOrDefault(o => o.MaDonHang == id);

        // Danh sách lấy từ bộ nhớ đệm (tới 60 giây) có thể đã cũ → đơn đang xem luôn hỏi lại máy chủ
        // (khách chuyển khoản trên tablet, đơn bị hủy ở máy khác… phải hiện đúng sau ≤ 10 giây)
        if (inPage is not null && !listFromCache)
        {
            selectedOrder = inPage;
            SyncPickupInput(inPage);
            return;
        }

        try
        {
            var fresh = await OrderApi.GetAsync(id, ct);
            if (selectedId != id) return;   // đã chuyển sang xem đơn khác trong lúc chờ

            selectedOrder = fresh;
            SyncPickupInput(fresh);

            // Cập nhật luôn bản trong danh sách (không xếp lại; lần tải đầy đủ sau sẽ xếp đúng chỗ)
            int i = orders.FindIndex(o => o.MaDonHang == id);
            if (i >= 0) orders[i] = fresh;
            int j = clientSorted?.FindIndex(o => o.MaDonHang == id) ?? -1;
            if (j >= 0) clientSorted![j] = fresh;
        }
        catch (ApiException)
        {
            // Giữ bản đang hiển thị; lần làm mới sau sẽ thử lại
        }
    }

    private async Task AutoRefresh()
    {
        // Không làm mới khi đang thao tác (tránh danh sách nhảy dưới tay người dùng)
        if (!autoRefreshEnabled || loading || paying || creating || cancelling || servingBusy
            || isOrderModalOpen || isCancelModalOpen || pageCts.IsCancellationRequested)
        {
            return;
        }

        await LoadOrders(quiet: true);
        StateHasChanged();
    }

    // =========================================================================
    // LỌC THEO THỜI GIAN
    // =========================================================================

    /// <summary>
    /// Các mốc chọn nhanh. Tính lùi đúng 24 giờ / 7 ngày / 30 ngày từ thời điểm hiện tại (khoảng trượt),
    /// không có mốc kết thúc → luôn gồm cả đơn vừa tạo. Giống bộ lọc "Last 24 hours / 7 days / 30 days" của các trang quản trị lớn.
    /// </summary>
    private static class DatePresets
    {
        public const string All = "";
        public const string Last24h = "24h";
        public const string Last7 = "7d";
        public const string Last30 = "30d";
        public const string Custom = "custom";   // tự chọn Từ ngày / Đến ngày

        public static readonly string[] Options = [All, Last24h, Last7, Last30, Custom];

        public static string Label(string preset) => preset switch
        {
            Last24h => "Trong 24 giờ qua",
            Last7 => "Trong 7 ngày qua",
            Last30 => "Trong 30 ngày qua",
            Custom => "Chọn khoảng ngày…",
            _ => "Tất cả thời gian"
        };

        /// <summary>Mốc bắt đầu của một lựa chọn; null = không lọc theo thời gian.</summary>
        public static DateTime? From(string preset, DateTime now) => preset switch
        {
            Last24h => now.AddHours(-24),
            Last7 => now.AddDays(-7),
            Last30 => now.AddDays(-30),
            _ => null
        };
    }

    private static string IsoDate(DateTime d) => d.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

    private async Task OnDatePresetChanged()
    {
        dateError = null;

        if (datePreset == DatePresets.Custom)
        {
            // Mở 2 ô Từ / Đến, điền sẵn khoảng đang lọc (hoặc hôm nay). Chưa lọc cho tới khi bấm Áp dụng.
            customFrom = (fromDate ?? DateTime.Today).Date;
            customTo = (toDate ?? DateTime.Today).Date;
            return;
        }

        appliedPreset = datePreset;
        await ApplyFilter();
    }

    /// <summary>Xóa lỗi một nhịp rồi mới gán, để vùng live đọc lại cả khi lỗi trùng lần trước.</summary>
    private async Task ShowDateError(string message)
    {
        if (dateError == message)
        {
            dateError = null;
            StateHasChanged();
            await Task.Yield();
        }

        dateError = message;
    }

    private async Task ApplyCustomRange()
    {
        if (customFrom is null && customTo is null)
        {
            await ShowDateError("Hãy chọn ít nhất một ngày.");
            return;
        }

        // Chỉ chọn một đầu → lọc đúng ngày đó (không hiểu thành "từ ngày đó đến nay" hay "mọi ngày trước đó")
        DateTime from = (customFrom ?? customTo)!.Value.Date;
        DateTime to = (customTo ?? customFrom)!.Value.Date;

        if (to < from)
        {
            await ShowDateError("Ngày kết thúc phải sau hoặc bằng ngày bắt đầu.");
            return;
        }

        // Ô ngày có max nhưng vẫn gõ tay được ngày vượt mốc (form dùng novalidate) → kiểm tra lại cả 2 đầu
        if (from > DateTime.Today || to > DateTime.Today)
        {
            await ShowDateError("Không chọn ngày trong tương lai.");
            return;
        }

        dateError = null;
        customFrom = from;
        customTo = to;
        fromDate = from;
        toDate = to;
        appliedPreset = DatePresets.Custom;

        await ApplyFilter();
    }

