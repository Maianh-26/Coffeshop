            TableOrArea = "Mang đi",
            PaymentMethod = "Tiền mặt",
            Source = "Tại quầy",
            Items = new List<OrderItem>()
        };

        // Reset Item Builder
        ResetItemBuilder();
        isOrderModalOpen = true;
    }

    private void OpenEditOrder()
    {
        if (SelectedOrderDetail == null) return;

        isEditing = true;
        var src = SelectedOrderDetail;

        // Clone order sang draftOrder
        draftOrder = new Order
        {
            Code = src.Code,
            CreatedAt = src.CreatedAt,
            AcceptedAt = src.AcceptedAt,
            PaidAt = src.PaidAt,
            Status = src.Status,
            PaymentStatus = src.PaymentStatus,
            CashierName = src.CashierName,
            TableOrArea = src.TableOrArea,
            PaymentMethod = src.PaymentMethod,
            Source = src.Source,
            Note = src.Note,
            DiscountAmount = src.DiscountAmount,
            Items = src.Items.Select(i => new OrderItem
            {
                ProductCode = i.ProductCode,
                ProductName = i.ProductName,
                BasePrice = i.BasePrice,
                Quantity = i.Quantity,
                SizeName = i.SizeName,
                SizeExtraPrice = i.SizeExtraPrice,
                Note = i.Note,
                Toppings = i.Toppings.Select(t => new OrderItemTopping
                {
                    ToppingCode = t.ToppingCode,
                    ToppingName = t.ToppingName,
                    Price = t.Price
                }).ToList()
            }).ToList()
        };

        ResetItemBuilder();
        isOrderModalOpen = true;
    }

    private void ResetItemBuilder()
    {
        if (availableProducts.Count > 0)
        {
            builderProductCode = availableProducts[0].Code;
        }
        if (availableSizes.Count > 0)
        {
            builderSizeCode = availableSizes[0].Code;
        }
        builderQuantity = 1;
        builderNote = "";
        selectedToppingCodes.Clear();
    }

    private void OnBuilderProductChanged() { }
    private void OnBuilderSizeChanged() { }

    private void ToggleToppingInBuilder(string code, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        if (isChecked)
            selectedToppingCodes.Add(code);
        else
            selectedToppingCodes.Remove(code);
    }

    private void AddItemToDraftOrder()
    {
        var product = availableProducts.FirstOrDefault(p => p.Code == builderProductCode);
        if (product == null) return;

        var size = availableSizes.FirstOrDefault(s => s.Code == builderSizeCode);
        string sizeName = size?.Name ?? "Size M";
        decimal sizePrice = size?.ExtraPrice ?? 0;

        var toppings = availableToppings
            .Where(t => selectedToppingCodes.Contains(t.Code))
            .Select(t => new OrderItemTopping
            {
                ToppingCode = t.Code,
                ToppingName = t.Name,
                Price = t.ExtraPrice
            }).ToList();

        var newItem = new OrderItem
        {
            ProductCode = product.Code,
            ProductName = product.Name,
            BasePrice = product.Price ?? 0,
            Quantity = Math.Max(1, builderQuantity),
            SizeName = sizeName,
            SizeExtraPrice = sizePrice,
            Note = builderNote,
            Toppings = toppings
        };

        draftOrder.Items.Add(newItem);
        orderModalError = null;
        ResetItemBuilder();
    }

    private void SaveDraftOrder()
    {
        if (draftOrder.Items.Count == 0)
        {
            // Báo lỗi ngay trong hộp thoại — banner của trang nằm sau lớp phủ nên người dùng không thấy
            orderModalError = "Vui lòng thêm ít nhất một món vào đơn hàng trước khi lưu.";
            return;
        }

        orderModalError = null;

        if (isEditing)
        {
            var existing = orders.FirstOrDefault(o => o.Code == draftOrder.Code);
            if (existing != null)
            {
                existing.TableOrArea = draftOrder.TableOrArea;
                existing.PaymentMethod = draftOrder.PaymentMethod;
                existing.CashierName = draftOrder.CashierName;
                existing.DiscountAmount = draftOrder.DiscountAmount;
                existing.Note = draftOrder.Note;
                existing.Items = draftOrder.Items;
            }
            ShowAlert($"Đã cập nhật đơn hàng #{draftOrder.Code}!", "success");
        }
        else
        {
            orders.Insert(0, draftOrder);
            selected = draftOrder.Code;
            ShowAlert($"Đã tạo thành công đơn hàng #{draftOrder.Code} tại quầy!", "success");
        }

        isOrderModalOpen = false;
    }

    private void CloseOrderModal()
    {
        isOrderModalOpen = false;
        orderModalError = null;
    }

    private void OpenDeleteOrder()
    {
        if (SelectedOrderDetail == null) return;
        isDeleteModalOpen = true;
    }

    private void ConfirmCancelOrder()
    {
        if (SelectedOrderDetail != null)
        {
            SelectedOrderDetail.Status = "Đã hủy";
            ShowAlert($"Đã chuyển trạng thái đơn hàng #{SelectedOrderDetail.Code} sang 'Đã hủy'.", "success");
        }
        isDeleteModalOpen = false;
    }

    private void ShowAlert(string msg, string type)
    {
        alertMessage = msg;
        alertType = type;
    }

    private async Task PrintReceipt()
    {
        await JS.InvokeVoidAsync("appHelpers.printPage");
    }

    public void Dispose()
    {
        autoRefreshTimer?.Dispose();
    }
}
