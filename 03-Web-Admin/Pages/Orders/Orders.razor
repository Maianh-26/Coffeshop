@if (SelectedOrder is { } receipt)
{
    <div id="receipt-source" hidden>
        <div class="r-center">
            <div class="r-shop">COFFEE SHOP</div>
            <div class="r-title">HÓA ĐƠN</div>
        </div>

        <div class="r-row"><span>Mã đơn:</span><strong>#@receipt.MaDonHang</strong></div>
        @if (receipt.SoNhanMon is { } receiptNo)
        {
            <div class="r-row"><span>Số nhận món:</span><strong>@receiptNo</strong></div>
        }
        <div class="r-row"><span>Thời gian:</span><span>@receipt.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</span></div>

        <hr />

        @foreach (var line in receipt.ChiTiet ?? [])
        {
            <div class="r-item">
                <div class="r-row"><strong>@line.TenMonLuu</strong></div>
                <div class="r-row r-sub"><span>@line.SoLuong x @Money(line.DonGiaBan)</span><span>@Money(line.DonGiaBan * line.SoLuong)</span></div>
                @foreach (var top in line.Toppings)
                {
                    <div class="r-row r-sub"><span>+ @top.TenToppingLuu (@line.SoLuong x @Money(top.DonGiaTopping))</span><span>@Money(top.DonGiaTopping * line.SoLuong)</span></div>
                }
            </div>
        }

        <hr />

        <div class="r-row r-total"><span>TỔNG TIỀN</span><span>@Money(receipt.TongTien)</span></div>
        <div class="r-row r-sub"><span>Thanh toán:</span><span>@PhuongThucThanhToans.Summary(receipt)</span></div>

        <div class="r-center r-thanks">Cảm ơn quý khách!</div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private const int PageSize = 20;
    private const int RefreshSeconds = 10;

    private static readonly System.Globalization.CultureInfo Vi = new("vi-VN");

    private readonly CancellationTokenSource pageCts = new();

    // Danh sách (phân trang ở máy chủ)
    private List<DonHang> orders = [];
    private int totalOrders;
    private int totalPages = 1;
    private int page = 1;
    private int lastSeenOrderId;

    // Đơn mới từ Tablet chưa mở xem (đánh dấu "Mới" + thông báo có nút Xem)
    private const int NewOrderScan = 30;                       // số đơn mới nhất xem lại mỗi lần dò
    private readonly HashSet<int> newOrderIds = [];
    private readonly Dictionary<int, DonHang> newOrderCache = [];
    private bool newOrdersInitialized;
    private bool newBannerHidden;
    private bool loading;
    private string? loadError;

    // Bộ lọc
    private string search = "";
    private DateTime? fromDate;
    private DateTime? toDate;
    private string statusFilter = "";   // trạng thái phục vụ, hoặc "CANCELLED" = đã hủy
    private string paymentFilter = "";  // PENDING / PAID
    private bool filtersOpen;           // màn hình hẹp: khung bộ lọc đang mở

    private int ActiveFilterCount =>
        (fromDate.HasValue || toDate.HasValue ? 1 : 0) + (statusFilter != "" ? 1 : 0) + (paymentFilter != "" ? 1 : 0);

    private bool FiltersActive => search.Length > 0 || ActiveFilterCount > 0;

    private static readonly string[] ServingSteps =
    [
        TrangThaiPhucVus.Waiting,
        TrangThaiPhucVus.Preparing,
        TrangThaiPhucVus.Served
    ];

    private static readonly string[] ServingFilters =
    [
        TrangThaiPhucVus.Waiting,
        TrangThaiPhucVus.Preparing,
        TrangThaiPhucVus.Served,
        TrangThaiPhucVus.CancelledFilter
    ];

    private int? selectedId;

    // Đơn đang xem chi tiết — giữ riêng để không mất khi đơn trôi sang trang khác lúc tự làm mới
    private DonHang? selectedOrder;

    // Mỗi lần tải danh sách có token riêng: thao tác của người dùng hủy lần tải cũ (kể cả lượt làm mới nền)
    private CancellationTokenSource? loadCts;
    private bool isAdmin;

    // Thông báo
    private string? alertMessage;
    private string alertType = "success";
    private int alertVersion;
    private const int AlertSeconds = 6;
    private List<CanhBaoKho> stockWarnings = [];

    // Thanh toán
    private string payMethod = PhuongThucThanhToans.Cash;
    private bool paying;
    private string? payError;

    // Số nhận món & trạng thái phục vụ
    private int? pickupInput;
    private bool servingSupported = true;  // false khi máy chủ chưa trả trangThaiPhucVu (backend chưa cập nhật)
    private bool pickupDirty;         // người dùng đã gõ vào ô số nhận món mà chưa lưu
    private int? pickupServerValue;    // số nhận món máy chủ trả về lần gần nhất cho đơn đang xem
    private bool servingBusy;
    private int? confirmServeUnpaidId;     // đơn đang chờ xác nhận "phục vụ khi chưa thanh toán"
    private int? confirmNoPickupId;        // đơn đang chờ xác nhận "bắt đầu chuẩn bị khi chưa có số nhận món"
    private ElementReference confirmFirstButton;
    private ElementReference payButtonRef;
    private bool focusConfirmButton;
    private ElementReference pickupInputRef;
    private string? servingError;

    // Tự động làm mới
    private bool autoRefreshEnabled = true;
    private Timer? autoRefreshTimer;

    // Tạo đơn tại quầy / sửa đơn (editingOrderId != null = đang sửa đơn đó)
    private int? editingOrderId;
    private bool isOrderModalOpen;
    private bool creating;
    private bool menuLoading;
    private string? menuError;
    private string? orderModalError;
    private List<ThieuNguyenLieu> shortages = [];
    private List<Mon> menu = [];
    private List<Topping> availableToppings = [];
    private List<DraftLine> draftLines = [];
    private string draftPaymentMethod = PhuongThucThanhToans.Cash;
    private int builderProductId;
    private int builderSizeId;
    private int builderQuantity = 1;
    private string builderNote = "";
    private HashSet<int> selectedToppingIds = [];

    // Hủy đơn
    private bool isCancelModalOpen;
    private bool cancelling;
    private string cancelReason = "";
    private string? cancelError;

    /// <summary>Một dòng món trong đơn đang tạo (hiển thị tạm tính; giá chính thức do backend tính).</summary>
    private sealed record DraftLine(
        int MaChiTietMon,
        string TenMon,
        string TenKichThuoc,
        decimal GiaSize,
        int SoLuong,
        string? GhiChu,
        List<Topping> Toppings)
    {
        public decimal DonGia => GiaSize + Toppings.Sum(t => t.GiaThem);
        public decimal ThanhTien => DonGia * SoLuong;
    }

    private bool IsAdmin => isAdmin;

    private bool IsMock => Configuration.GetValue("Api:UseMock", true);

    private static string Money(decimal value) => value.ToString("N0", Vi) + " đ";

    private static string Number(decimal value) => value.ToString("#,##0.##", Vi);

    private DonHang? SelectedOrder => selectedOrder;

    /// <summary>
    /// Tìm nhanh trong trang đang hiển thị (máy chủ chưa hỗ trợ tìm theo từ khóa).
    /// Chỉ so với dữ liệu nhìn thấy trên bảng: mã đơn bắt đầu bằng số đã nhập, hoặc số nhận món trùng khớp.
    /// (Trước đây tìm cả tên món / nhân viên vốn không hiện trên bảng → kết quả trông như "lọc sai".)
    /// </summary>
    private List<DonHang> VisibleOrders =>
        search.Length == 0
            ? orders
            : orders.Where(o =>
                    o.MaDonHang.ToString(System.Globalization.CultureInfo.InvariantCulture).StartsWith(search, StringComparison.Ordinal)
                    || o.SoNhanMon?.ToString(System.Globalization.CultureInfo.InvariantCulture) == search)
                .ToList();

    /// <summary>Ô tìm kiếm chỉ giữ chữ số (bỏ "#", chữ cái, khoảng trắng).</summary>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? "";
        string digits = new(raw.Where(char.IsAsciiDigit).Take(10).ToArray());

        if (digits != raw)
        {
            // Giá trị đã lọc có thể trùng giá trị cũ → Blazor không vẽ lại và chữ cái vẫn nằm trong ô.
            // Vẽ một nhịp với chuỗi thô rồi mới gán chuỗi đã lọc để ô nhập luôn khớp với bộ lọc.
            search = raw;
            StateHasChanged();
            await Task.Yield();
        }

        search = digits;
    }

    private Mon? BuilderProduct => menu.FirstOrDefault(m => m.MaTenMon == builderProductId);

    private List<GiaTheoSize> BuilderSizes =>
        BuilderProduct?.KichThuoc.Where(s => s.DangApDung && s.DuNguyenLieu).ToList() ?? [];

    private GiaTheoSize? BuilderSize => BuilderSizes.FirstOrDefault(s => s.MaChiTietMon == builderSizeId);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            isAdmin = (await AuthState).User.IsInRole(Roles.Admin);
        }

        await LoadOrders();

        // Rời trang khi lần tải đầu chưa xong → Dispose đã chạy, không tạo timer nữa
        if (pageCts.IsCancellationRequested) return;

        autoRefreshTimer = new Timer(_ => _ = InvokeAsync(AutoRefresh), null,
            TimeSpan.FromSeconds(RefreshSeconds), TimeSpan.FromSeconds(RefreshSeconds));
    }

    // =========================================================================
    // TẢI DANH SÁCH
    // =========================================================================

    /// <param name="quiet">
    /// true = lượt làm mới nền: bỏ qua nếu đang tải, không xóa lỗi đang hiện.
    /// false = thao tác của người dùng: hủy lần tải đang chạy và tải theo bộ lọc / trang mới nhất.
    /// </param>
    private async Task LoadOrders(bool quiet = false)
    {
        if (quiet && loading) return;

        loadCts?.Cancel();
        loadCts?.Dispose();

        CancellationTokenSource cts;

        try
        {
            cts = CancellationTokenSource.CreateLinkedTokenSource(pageCts.Token);
        }
        catch (ObjectDisposedException)
        {
            return; // trang đã đóng
        }

        loadCts = cts;
        loading = true;

        if (!quiet)
        {
            loadError = null;
        }

        try
        {
            // "Đã hủy" là trạng thái thanh toán CANCELLED; các trạng thái còn lại là trạng thái phục vụ
            bool cancelledOnly = statusFilter == TrangThaiPhucVus.CancelledFilter;

            // Đang ở trang khác / đang lọc → dò đơn mới bằng 1 request riêng, chạy song song với request chính
            bool unfilteredFirstPage = page == 1 && statusFilter == "" && paymentFilter == ""
                                       && !fromDate.HasValue && !toDate.HasValue;
            Task<PagedResult<DonHang>>? scanTask = unfilteredFirstPage
                ? null
                : OrderApi.GetPageAsync(1, NewOrderScan, ct: cts.Token);

            var result = await OrderApi.GetPageAsync(
                page, PageSize,
                trangThai: cancelledOnly ? TrangThaiDon.Cancelled : (paymentFilter == "" ? null : paymentFilter),
                trangThaiPhucVu: cancelledOnly || statusFilter == "" ? null : statusFilter,
                tuNgay: fromDate,
                denNgay: toDate,
                ct: cts.Token);

            orders = result.Data;
            totalOrders = result.Meta.Total;

            // Backend cũ không trả trangThaiPhucVu → ẩn phần phục vụ thay vì hiện "Chờ phục vụ" cho mọi đơn
            if (orders.Count > 0) servingSupported = orders.Any(o => o.TrangThaiPhucVu is not null);
            totalPages = Math.Max(1, result.Meta.TotalPages);
            loadError = null;

            await RefreshSelected(cts.Token);

            // Dò đơn mới từ Tablet KHÔNG phụ thuộc trang / bộ lọc đang xem.
            // Trang 1 không lọc: dùng lại danh sách vừa tải nếu nó đã phủ hết phần đơn mới
            // (ít hơn 1 trang, hoặc đơn cuối trang đã cũ hơn mốc) — nếu không, hỏi riêng máy chủ để khỏi sót.
            bool pageCoversNew = unfilteredFirstPage
                                 && (!newOrdersInitialized || orders.Count < PageSize
                                     || orders.Min(o => o.MaDonHang) <= lastSeenOrderId);
            await CheckNewOrders(pageCoversNew ? orders : null, scanTask, cts.Token);
        }
        catch (ApiException ex)
        {
            if (!cts.IsCancellationRequested)
            {
                loadError = ex.Message;
            }
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // Bị thay bởi lần tải mới hơn, hoặc rời trang
        }
        finally
        {
            // Chỉ lần tải mới nhất mới được tắt cờ "đang tải"
            if (loadCts == cts)
            {
                loading = false;
            }
        }
    }

    /// <summary>
    /// Cập nhật đơn đang xem: lấy từ trang vừa tải, nếu đơn không còn trong trang thì hỏi riêng máy chủ.
    /// </summary>
    private async Task RefreshSelected(CancellationToken ct)
    {
        if (selectedId is not { } id) return;

        var inPage = orders.FirstOrDefault(o => o.MaDonHang == id);

        if (inPage is not null)
        {
            selectedOrder = inPage;
            SyncPickupInput(inPage);
            return;
        }

        try
        {
            selectedOrder = await OrderApi.GetAsync(id, ct);
            SyncPickupInput(selectedOrder);
        }
        catch (ApiException)
        {
            // Giữ bản đang hiển thị; lần làm mới sau sẽ thử lại
        }
    }

