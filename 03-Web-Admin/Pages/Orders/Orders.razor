    private void SelectOrder(int id)
    {
        // Đơn có thể không nằm trong trang đang xem (bấm "Xem" trên thông báo đơn mới khi đang ở trang khác / đang lọc)
        var order = orders.FirstOrDefault(o => o.MaDonHang == id)
                    ?? newOrderCache.GetValueOrDefault(id)
                    ?? (selectedOrder?.MaDonHang == id ? selectedOrder : null);

        // Mở xem rồi → hết là "đơn mới"
        newOrderIds.Remove(id);

        if (selectedId != id)
        {
            payMethod = order?.PhuongThucThanhToan ?? PhuongThucThanhToans.Cash;
            pickupInput = order?.SoNhanMon;
            pickupServerValue = order?.SoNhanMon;
            pickupDirty = false;
            payError = null;
            servingError = null;
            confirmNoPickupId = null;
            confirmServeUnpaidId = null;
        }

        selectedId = id;
        selectedOrder = order;
        scrollToDetail = true;
    }

