    private IEnumerable<Order> FilteredOrders =>
        orders.Where(o =>
            (search == ""
             || o.Code.Contains(search, StringComparison.OrdinalIgnoreCase)
             || (o.CashierName != null && o.CashierName.Contains(search, StringComparison.OrdinalIgnoreCase))
             || (o.TableOrArea != null && o.TableOrArea.Contains(search, StringComparison.OrdinalIgnoreCase))
             || o.Items.Any(i => i.ProductName.Contains(search, StringComparison.OrdinalIgnoreCase)))
            && (!fromDate.HasValue || o.CreatedAt.Date >= fromDate.Value.Date)
            && (!toDate.HasValue || o.CreatedAt.Date <= toDate.Value.Date)
            && (statusFilter == "" || o.Status == statusFilter)
            && (paymentFilter == "" || o.PaymentStatus == paymentFilter)
        ).OrderByDescending(o => o.CreatedAt);

    private List<Order> VisibleOrders =>
        FilteredOrders
            .Skip((page - 1) * PageSize)
            .Take(PageSize)
            .ToList();

    private int Pages =>
        Math.Max(1, (int)Math.Ceiling(FilteredOrders.Count() / (double)PageSize));

    // Cờ yêu cầu cuộn tới khung chi tiết sau khi vẽ lại (màn hình hẹp)
