    /// false = thao tác của người dùng: hủy lần tải đang chạy và tải theo bộ lọc / trang mới nhất.
    /// </param>
    /// <returns>true nếu lần tải này chạy xong (không bị lần tải mới hơn thay thế, không lỗi).</returns>
    private async Task<bool> LoadOrders(bool quiet = false)
    {
        if (quiet && loading) return false;

        loadCts?.Cancel();
        loadCts?.Dispose();

        CancellationTokenSource cts;

        try
        {
            cts = CancellationTokenSource.CreateLinkedTokenSource(pageCts.Token);
        }
        catch (ObjectDisposedException)
