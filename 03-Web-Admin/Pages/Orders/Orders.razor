@page "/orders"
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@inject OrderService OrderApi
@inject ProductService ProductApi
@inject ToppingService ToppingApi
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IServiceProvider Services
@inject ILogger<Orders> Logger

<PageTitle>Đơn hàng - Coffee Shop</PageTitle>

<!-- Thông báo đơn mới từ Tablet: riêng với thông báo thao tác để không đè nhau. Có nút Xem mở ngay chi tiết đơn. -->
<div aria-live="polite">
    @if (!newBannerHidden && UnseenNewOrders is { Count: > 0 } unseen)
    {
        var first = unseen[0];
        <div class="alert new-order-alert orders-alert alert-dismissible">
            <div class="new-order-text">
                <Icon Name="orders" Size="18" />
                @if (unseen.Count == 1)
                {
                    <span>
                        <strong>Đơn mới #@first.MaDonHang</strong> từ Tablet, @first.SoPhan phần, <span class="nowrap">@Money(first.TongTien)</span>
                    </span>
                }
                else
                {
                    <span><strong>Có @unseen.Count đơn mới</strong> từ Tablet chưa xem</span>
                }
            </div>

            <div class="new-order-actions">
                <button type="button"
                        class="btn primary btn-compact"
                        aria-label="Xem đơn #@first.MaDonHang"
                        @onclick="() => OpenFromBanner(first.MaDonHang)">
                    @(unseen.Count == 1 ? "Xem" : $"Xem đơn đầu tiên (#{first.MaDonHang})")
                </button>

                <button type="button" class="icon-button" aria-label="Ẩn thông báo đơn mới" @onclick="() => newBannerHidden = true">
                    <Icon Name="close" Size="14" />
                </button>
            </div>
        </div>
    }
</div>

<!-- Thông báo kết quả thao tác: nổi ở góc màn hình, hiện / tự ẩn không làm bảng và khung chi tiết nhảy lên xuống -->
<div class="orders-toasts" aria-live="polite">

<!-- Banner thông báo kết quả thao tác -->
@if (!string.IsNullOrEmpty(alertMessage) || stockWarnings.Count > 0)
{
    <div class="alert @(alertMessage is null || (stockMessageActive && stockCollapsed) ? "warning" : alertType) orders-alert alert-dismissible @(stockWarnings.Count > 0 && (stockMessageActive || alertMessage is null) ? "has-stock-warning" : "")"
         role="@(alertMessage is not null && alertType == "error" ? "alert" : "status")">
        <div>
            @* Có cảnh báo kho: sau vài giây thu gọn còn 1 dòng (không che khung chi tiết / vùng thanh toán, nhất là
               trên điện thoại). Thông báo khác đến sau KHÔNG xóa dòng cảnh báo: dòng đó vẫn nằm dưới thông báo mới.
               Nút Xem / Thu gọn luôn ở cùng một chỗ để giữ tiêu điểm bàn phím và aria-expanded đúng. *@
            @if (alertMessage is not null && !(stockMessageActive && stockCollapsed))
            {
                <span>@alertMessage</span>
            }

            @if (stockWarnings.Count > 0)
            {
                @* Thông báo phía trên không phải của cảnh báo kho (hoặc đã tự ẩn) → thêm tiêu đề cho danh sách *@
                @if (!stockCollapsed && (!stockMessageActive || alertMessage is null))
                {
                    <strong class="stock-heading">Cảnh báo kho: @stockWarnings.Count nguyên liệu sắp hết</strong>
                }
                <ul class="alert-list" id="stock-warning-list" hidden="@stockCollapsed">
                    @foreach (var w in stockWarnings)
                    {
                        <li>@w.TenNguyenLieu chỉ còn @Number(w.SoLuongTon) @w.DonViTinh (mức cảnh báo @Number(w.MucCanhBaoToiThieu))</li>
                    }
                </ul>
            }

            @if (stockWarnings.Count > 0)
            {
                <button type="button" class="text-button stock-expand"
                        aria-expanded="@(stockCollapsed ? "false" : "true")"
                        aria-controls="stock-warning-list"
                        @onclick="() => stockCollapsed = !stockCollapsed">
                    @(stockCollapsed ? $"Cảnh báo kho: {stockWarnings.Count} nguyên liệu sắp hết · Xem" : "Thu gọn")
                </button>
            }
        </div>

        <button type="button" class="icon-button" aria-label="Đóng thông báo" @onclick="ClearAlert">
            <Icon Name="close" Size="14" />
        </button>
    </div>
}

</div>

<div class="orders-page master-detail-layout @(SelectedOrder != null ? "has-detail" : "")">

    <!-- Cột trái: Bộ lọc, Thanh tác vụ và Danh sách đơn hàng -->
    <div class="master-panel">

        <section class="panel orders-toolbar">

            <div class="filter-row">

                <div class="search-field">

                    <Icon Name="search" />

                    @* Chỉ tìm theo cột đang hiển thị: mã đơn hoặc số nhận món (chỉ nhận chữ số) *@
                    <input value="@searchText"
                           @oninput="OnSearchInput"
                           @onblur="() => searchHint = false"
                           inputmode="numeric"
                           maxlength="10"
                           placeholder="Tìm trong trang này: mã đơn, số nhận món…"
                           aria-label="Tìm trong trang hiện tại theo mã đơn hoặc số nhận món (chỉ nhập số)"
                           aria-describedby="@(searchHint ? "search-hint" : null)" />

                    @* Gợi ý nổi (không đẩy bố cục) khi người dùng gõ ký tự không phải số.
                       Bản cho trình đọc màn hình là vùng live luôn có mặt (chỉ đổi chữ) để được đọc chắc chắn. *@
                    @if (searchHint)
                    {
                        <span id="search-hint" class="search-hint" aria-hidden="true">Chỉ nhập số: mã đơn hoặc số nhận món</span>
                    }
                    <span class="sr-only" role="status">@(searchHint ? "Chỉ nhập số: mã đơn hoặc số nhận món" : "")</span>

                </div>

                <button type="button"
                        class="btn outline filters-toggle"
                        aria-expanded="@(filtersOpen ? "true" : "false")"
                        aria-controls="order-filters"
                        @onclick="() => filtersOpen = !filtersOpen">
                    <Icon Name="filter" />
                    Bộ lọc@(ActiveFilterCount > 0 ? $" ({ActiveFilterCount})" : "")
                </button>

                @* Làm mới: tải lại danh sách mới nhất và bỏ mọi bộ lọc / tìm kiếm, về trang 1.
                   Màn hình rộng: CSS đặt nút ở cuối hàng; màn hình hẹp: nằm cạnh nút "Bộ lọc". *@
                <button type="button"
                        class="btn outline refresh-button @(userLoading ? "is-loading" : "")"
                        title="@(FiltersActive ? "Làm mới và bỏ lọc, xem toàn bộ đơn" : "Làm mới danh sách đơn")"
                        aria-label="@(FiltersActive ? "Làm mới và bỏ lọc" : "Làm mới danh sách đơn")"
                        @onclick="RefreshAll">
                    <Icon Name="reset" Size="18" />
                    @if (FiltersActive)
                    {
                        <span class="filter-dot" aria-hidden="true"></span>
                    }
                </button>

                <div id="order-filters" class="filter-extra @(filtersOpen ? "open" : "")">

                @* Thời gian: mốc chọn nhanh (24h / 7 / 30 ngày, áp dụng ngay) hoặc "Chọn khoảng ngày…"
                   (2 ô Từ ngày / Đến ngày, chỉ lọc khi bấm Áp dụng) *@
                <select class="date-preset"
                        aria-label="Lọc theo thời gian tạo đơn"
                        @bind="datePreset"
                        @bind:after="OnDatePresetChanged">
                    @foreach (var p in DatePresets.Options)
                    {
                        <option value="@p">@DatePresets.Label(p)</option>
                    }
                </select>

                @if (datePreset == DatePresets.Custom)
                {
                    <form class="custom-range" @onsubmit="ApplyCustomRange" novalidate>

                        <label class="range-field">
                            <span>Từ ngày</span>
                            <input type="date"
                                   @bind="customFrom"
                                   max="@IsoDate(customTo ?? DateTime.Today)"
                                   aria-invalid="@(dateError is not null ? "true" : null)"
                                   aria-describedby="date-range-help" />
                        </label>

                        <label class="range-field">
                            <span>Đến ngày</span>
                            <input type="date"
                                   @bind="customTo"
                                   min="@(customFrom is { } cf ? IsoDate(cf) : null)"
                                   max="@IsoDate(DateTime.Today)"
                                   aria-invalid="@(dateError is not null ? "true" : null)"
                                   aria-describedby="date-range-help" />
                        </label>

                        <button type="submit" class="btn primary btn-compact" disabled="@userLoading">Áp dụng</button>

                        <p id="date-range-help" class="range-help @(dateError is not null ? "is-error" : "")">
                            @(dateError ?? "Chỉ chọn một ngày thì xem đơn của riêng ngày đó.")
                        </p>

                        @* Vùng live luôn có mặt khi khung mở → lỗi được trình đọc màn hình đọc, kể cả lỗi lặp lại *@
                        <span class="sr-only" role="alert">@dateError</span>

                    </form>
                }

                <select aria-label="Lọc trạng thái phục vụ" @bind="statusFilter" @bind:after="ApplyFilter">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var s in ServingFilters)
                    {
                        <option value="@s" disabled="@(!servingSupported && s != TrangThaiPhucVus.CancelledFilter)">@TrangThaiPhucVus.Label(s)</option>
                    }
                </select>

                <select aria-label="Lọc thanh toán"
                        @bind="paymentFilter"
                        @bind:after="ApplyFilter"
                        disabled="@(statusFilter == TrangThaiPhucVus.CancelledFilter)"
                        title="@(statusFilter == TrangThaiPhucVus.CancelledFilter ? "Đơn đã hủy không lọc theo thanh toán" : null)">
                    <option value="">Tất cả thanh toán</option>
                    <option value="@TrangThaiDon.Pending">@TrangThaiDon.Label(TrangThaiDon.Pending)</option>
                    <option value="@TrangThaiDon.Paid">@TrangThaiDon.Label(TrangThaiDon.Paid)</option>
                </select>

                </div>

            </div>

            @* Khoảng thời gian đang lọc — ghi rõ mốc bắt đầu để không hiểu nhầm *@
            @if (fromDate is { } rangeFrom)
            {
                <p class="active-range">
                    <Icon Name="calendar" Size="14" />
                    @if (toDate is { } rangeTo)
                    {
                        @(rangeFrom.Date == rangeTo.Date
                            ? $"Đang xem đơn tạo ngày {rangeFrom:dd/MM/yyyy}"
                            : $"Đang xem đơn tạo từ {rangeFrom:dd/MM/yyyy} đến hết {rangeTo:dd/MM/yyyy}")
                    }
                    else
                    {
                        @($"Đang xem đơn tạo từ {rangeFrom:HH:mm dd/MM/yyyy} đến nay ({DatePresets.Label(appliedPreset).ToLowerInvariant()})")
                    }
                </p>
            }

            <!-- Thao tác: Tạo đơn tại quầy và tự động làm mới -->
            <div class="action-bar action-bar-split toolbar-actions">

            <div class="action-group">

                <button class="btn primary"
                        @onclick="OpenCreateOrder">

                    <Icon Name="plus" />
                    Tạo đơn tại quầy

                </button>

                <button class="btn outline"
                        disabled="@(SelectedOrder is not { CoTheSua: true })"
                        title="@(SelectedOrder is { CoTheSua: false } ? "Chỉ sửa được đơn chưa thanh toán và chưa phục vụ" : "Sửa món trong đơn đang chọn")"
                        @onclick="OpenEditOrder">

                    <Icon Name="edit" />
                    Sửa đơn

                </button>

                @if (IsAdmin)
                {
                    <button class="btn danger-outline"
                            @ref="cancelButtonRef"
                            disabled="@(SelectedOrder is not { TrangThaiThanhToan: not TrangThaiDon.Cancelled })"
                            @onclick="OpenCancelOrder">

                        <Icon Name="trash" />
                        Hủy đơn

                    </button>
                }

            </div>

            <!-- Tự động tải lại danh sách để thấy đơn mới từ Tablet -->
            <div class="realtime-controls">

                <button type="button"
                        class="live-toggle @(!autoRefreshEnabled ? "paused" : "")"
                        @onclick="ToggleAutoRefresh"
                        aria-pressed="@(autoRefreshEnabled ? "true" : "false")"
                        title="Bật/Tắt tự động tải đơn mới từ Tablet (mỗi @RefreshSeconds giây)">

                    <span class="live-indicator" aria-hidden="true"></span>
                    <span>Tự cập nhật</span>

                </button>

                @* Công cụ thử nghiệm — chỉ hiện khi chạy với dữ liệu giả *@
                @if (IsMock)
                {
                    <button type="button"
                            class="text-button"
                            disabled="@loading"
                            @onclick="SimulateTabletOrder"
                            title="Chỉ có ở chế độ dữ liệu giả">
                        Mô phỏng đơn từ Tablet
                    </button>
                }

            </div>

            </div>

        </section>

        @if (loadError is not null)
        {
            <p class="alert error" role="alert">
                @loadError
                <button type="button" class="text-button" @onclick="() => LoadOrders()">Thử lại</button>
            </p>
        }

        <!-- Danh sách đơn hàng -->
        <section class="panel list-panel">

            <div class="table-wrap">

                <table class="orders-table">

                    <thead>

                        <tr>
                            <th aria-sort="@AriaSort(SortKeys.Id)">
                                <button type="button" class="sort-button @(sortKey == SortKeys.Id ? "is-sorted" : "")"
                                        title="@SortTitle(SortKeys.Id, "mã đơn")"
                                        @onclick="() => ToggleSort(SortKeys.Id)">
                                    Mã đơn
                                    <SortIcon Direction="@SortDirection(SortKeys.Id)" />
                                </button>
                            </th>
                            <th><span class="label-long">Số nhận món</span><span class="label-short" aria-hidden="true">Số</span></th>
                            <th>Trạng thái</th>
                            <th class="num" aria-sort="@AriaSort(SortKeys.Total)">
                                <button type="button" class="sort-button @(sortKey == SortKeys.Total ? "is-sorted" : "")"
                                        title="@SortTitle(SortKeys.Total, "tổng tiền")"
                                        @onclick="() => ToggleSort(SortKeys.Total)">
                                    Tổng tiền
                                    <SortIcon Direction="@SortDirection(SortKeys.Total)" />
                                </button>
                            </th>
                            <th>
                                <span class="label-long">Thanh toán</span>
                                @* Điện thoại: cột Tổng tiền bị ẩn (số tiền hiện dưới nhãn thanh toán) → nút sắp xếp tổng tiền đặt ở đây *@
                                <button type="button" class="sort-button sort-mobile-only @(sortKey == SortKeys.Total ? "is-sorted" : "")"
                                        aria-label="@SortTitle(SortKeys.Total, "tổng tiền")"
                                        aria-pressed="@(sortKey == SortKeys.Total ? "true" : "false")"
                                        @onclick="() => ToggleSort(SortKeys.Total)">
                                    Tiền
                                    <SortIcon Direction="@SortDirection(SortKeys.Total)" />
                                </button>
                            </th>
                            <th>Nguồn</th>
                            <th>Thời gian tạo</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var order in VisibleOrders)
                        {
                            bool isNew = newOrderIds.Contains(order.MaDonHang);

                            <tr class="selectable @(selectedId == order.MaDonHang ? "selected" : "") @(isNew ? "is-new" : "")"
                                @ref="rowRefs[order.MaDonHang]"
                                tabindex="0"
                                @onclick="() => SelectOrder(order.MaDonHang)"
                                @onkeydown="e => SelectKey(e, order.MaDonHang)">

                                <td>
                                    <strong class="order-id">#@order.MaDonHang</strong>
                                    @if (isNew)
                                    {
                                        <span class="new-mark" title="Đơn mới từ Tablet, chưa mở xem">Mới</span>
                                    }
                                </td>

                                <td>
                                    @if (order.SoNhanMon is { } so)
                                    {
                                        <span class="pickup-number">@so</span>
                                    }
                                    else
                                    {
                                        <span class="muted label-long">Chưa nhập</span>
                                        <span class="muted label-short" aria-hidden="true">—</span>
                                    }
                                </td>

                                <td>
                                    @if (servingSupported || order.DaHuy)
                                    {
                                        <span class="status status-@TrangThaiPhucVus.Tone(order)">@TrangThaiPhucVus.Label(order)</span>
                                    }
                                    else
                                    {
                                        <span class="muted" title="Máy chủ chưa có trạng thái phục vụ">—</span>
                                    }
                                </td>

                                <td class="num">
                                    <strong>@Money(order.TongTien)</strong>
                                </td>

                                <td>
                                    <span class="status status-@PhuongThucThanhToans.Tone(order)">@PhuongThucThanhToans.ShortLabel(order)</span>
                                    @if (PhuongThucThanhToans.Tone(order) != "void")
                                    {
                                        <span class="muted pay-method">@PhuongThucThanhToans.Label(order.PhuongThucThanhToan)</span>
                                    }
                                    <span class="pay-amount">@Money(order.TongTien)</span>
                                </td>

                                <td class="muted">@order.Nguon</td>

                                <td class="muted">@order.ThoiGianTao.ToString("HH:mm, dd/MM")</td>

                            </tr>
                        }

                        @if (VisibleOrders.Count == 0)
                        {
                            <tr>

                                <td class="empty-cell" colspan="7">

                                    <Icon Name="orders" Size="32" />

                                    <p>
                                        @(loading && orders.Count == 0
                                            ? "Đang tải đơn hàng…"
                                            : search.Length > 0 && orders.Count > 0
                                                ? $"Không có đơn khớp \"{search}\" trên trang này. Thử trang khác hoặc bấm nút Làm mới."
                                                : "Không tìm thấy đơn hàng nào phù hợp với bộ lọc.")
                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @* Vùng live luôn có mặt (chỉ đổi chữ) để trình đọc màn hình đọc được; phần nhìn thấy ở <p> bên dưới *@
            <span class="sr-only" role="status">@(SortNoteVisible ? SortNoteText : "")</span>
            @if (SortNoteVisible)
            {
                <p class="sort-note" aria-hidden="true">@SortNoteText</p>
            }

            <div class="list-footer">

                <span>
                    @if (search.Length > 0)
                    {
                        @($"Đang hiện {VisibleOrders.Count}/{orders.Count} đơn trên trang này (tổng {FooterTotal} đơn)")
                    }
                    else
                    {
                        @($"{FooterTotal} đơn hàng")@(SelectedOrder == null && totalOrders > 0 ? ", nhấp vào một đơn để xem chi tiết" : "")
                    }
                    <span class="page-of">Trang @(page)/@totalPages</span>
                </span>

                <div class="pagination">

                    <button class="page-button"
                            aria-label="Trang trước"
                            disabled="@(page <= 1 || loading)"
                            @onclick="() => Move(-1)">

                        <Icon Name="left" Size="16" />

                    </button>

                    <span class="page-number">
                        @(page)
                    </span>

                    <button class="page-button"
                            aria-label="Trang sau"
                            disabled="@(page >= totalPages || loading)"
                            @onclick="() => Move(1)">

                        <Icon Name="right" Size="16" />

                    </button>

                </div>

            </div>

        </section>

    </div>

    <!-- Cột phải: chi tiết đơn hàng (chỉ hiển thị khi đã chọn 1 đơn) -->
    @if (SelectedOrder is { } detail)
    {
        <aside class="detail-panel panel">

            <div class="order-detail-header">
                <div>
                    <h3 tabindex="-1" class="detail-heading" @ref="detailHeading">Đơn hàng #@detail.MaDonHang</h3>
                    <div class="order-badges">
                        @if (servingSupported || detail.DaHuy)
                        {
                            <span class="status status-@TrangThaiPhucVus.Tone(detail)">@TrangThaiPhucVus.Label(detail)</span>
                        }
                        <span class="status status-@PhuongThucThanhToans.Tone(detail)">@PhuongThucThanhToans.ShortLabel(detail)</span>
                    </div>
                </div>

                <button type="button"
                        class="icon-button"
                        aria-label="Đóng chi tiết"
                        title="Đóng khung chi tiết"
                        @onclick="CloseDetail">
                    <Icon Name="close" Size="20" />
                </button>
            </div>

            <!-- Thông tin tổng quan đơn hàng -->
            @if (!orders.Any(o => o.MaDonHang == detail.MaDonHang))
            {
                <p class="form-note">Đơn này không nằm trong danh sách đang hiển thị (trang hoặc bộ lọc khác).</p>
            }

            <dl class="order-facts">
                <div>
                    <dt>Tạo lúc</dt>
                    <dd>@detail.ThoiGianTao.ToString("HH:mm, dd/MM/yyyy")</dd>
                </div>
                <div>
                    <dt>Nguồn</dt>
                    <dd>@(detail.TenNhanVien is { } staff ? $"Tại quầy, {staff}" : "Khách đặt trên Tablet")</dd>
                </div>
                <div>
                    <dt>Thanh toán</dt>
                    <dd>@PhuongThucThanhToans.Summary(detail)</dd>
                </div>
                @if (detail.LyDoHuy is not null)
                {
                    <div>
                        <dt>Lý do hủy</dt>
                        <dd class="text-danger">@detail.LyDoHuy</dd>
                    </div>
                }
                @if (detail.GioHoanTien.HasValue)
                {
                    <div>
                        <dt>Hoàn tiền lúc</dt>
                        <dd>@detail.GioHoanTien.Value.ToString("HH:mm, dd/MM/yyyy")</dd>
                    </div>
                }
            </dl>

            <!-- Phiếu order: món, số lượng, giá thẳng cột như tờ phiếu ở quầy -->
            <section class="order-ticket" aria-labelledby="ticket-title">
                <h4 id="ticket-title">Món đã đặt <span class="muted">(@detail.SoPhan phần)</span></h4>

                <ul class="ticket-lines">
                    @foreach (var item in detail.ChiTiet ?? [])
                    {
                        <li>
                            <div class="ticket-row">
                                <span class="ticket-qty">@item.SoLuong ×</span>
                                <span class="ticket-name">@item.TenMonLuu</span>
                                <span class="num">@Money(item.DonGiaBan * item.SoLuong)</span>
                            </div>

                            @foreach (var top in item.Toppings)
                            {
                                <div class="ticket-row ticket-sub">
                                    <span class="ticket-qty"></span>
                                    <span class="ticket-name">+ @top.TenToppingLuu</span>
                                    <span class="num">@Money(top.DonGiaTopping * item.SoLuong)</span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.GhiChu))
                            {
                                <div class="ticket-note">Ghi chú: @item.GhiChu</div>
                            }
                        </li>
                    }
                </ul>

                <div class="ticket-total">
                    <span>Tổng tiền</span>
                    <span class="num">@Money(detail.TongTien)</span>
                </div>
            </section>

            <!-- NGHIỆP VỤ: SỐ NHẬN MÓN & PHỤC VỤ -->
            @if (!servingSupported)
            {
                <p class="form-note serving-box">
                    Số nhận món và trạng thái phục vụ chưa dùng được: máy chủ chưa hỗ trợ (đã đề xuất với nhóm backend).
                </p>
            }
            else
            {
            <div class="serving-box">
                <div class="field">
                    <label for="pickup-number">Số nhận món (bảng gỗ @SoNhanMons.Min–@SoNhanMons.Max)</label>

                    @if (detail.DangPhucVu)
                    {
                        <div class="pickup-input-row">
                            <input id="pickup-number"
                                   type="number"
                                   inputmode="numeric"
                                   min="@SoNhanMons.Min"
                                   max="@SoNhanMons.Max"
                                   placeholder="Nhập số"
                                   aria-describedby="@(servingError is null ? null : "serving-error")"
                                   aria-invalid="@(servingError is null ? null : "true")"
                                   class="@(servingError is null ? null : "input-error")"
                                   @ref="pickupInputRef"
                                   value="@pickupInput"
                                   @oninput="OnPickupInput"
                                   @onkeydown="PickupKeyDown"
                                   disabled="@servingBusy" />

                            <button type="button"
                                    class="btn outline"
                                    disabled="@(servingBusy || pickupInput == detail.SoNhanMon)"
                                    @onclick="() => SavePickupNumber(detail)">
                                @(detail.SoNhanMon is null ? "Lưu số" : "Đổi số")
                            </button>
                        </div>

                        @if (servingError is not null)
                        {
                            <p id="serving-error" class="alert error" role="alert">@servingError</p>
                        }

                    }
                    else
                    {
                        <p class="pickup-readonly">
                            @if (detail.SoNhanMon is { } so)
                            {
                                <span class="pickup-number">@so</span>
                                <span class="muted">@(detail.DaHuy ? "Đơn đã hủy, số đã được giải phóng." : "Đã phục vụ, số đã được giải phóng.")</span>
                            }
                            else
                            {
                                <span class="muted">Không nhập số nhận món.</span>
                            }
                        </p>
                    }
                </div>

                @if (confirmNoPickupId == detail.MaDonHang
                     && detail.PhucVu == TrangThaiPhucVus.Waiting && !detail.DaHuy && detail.SoNhanMon is null)
                {
                    @* Bắt đầu chuẩn bị khi chưa có số: người mang món ra sẽ không biết đưa tới bàn nào → hỏi lại *@
                    <div class="confirm-inline" role="alertdialog" aria-labelledby="no-pickup-msg"
                         @onkeydown="CloseConfirmOnEscape">
                        <p id="no-pickup-msg">
                            Đơn <strong>#@detail.MaDonHang</strong> <strong>chưa có số nhận món</strong>, người phục vụ sẽ không biết mang món tới bàn nào.
                        </p>
                        <div class="serving-actions">
                            <button type="button" class="btn primary" disabled="@servingBusy" @onclick="FocusPickupInput"
                                    @ref="confirmFirstButton">
                                Nhập số nhận món
                            </button>
                            <button type="button" class="btn outline" disabled="@servingBusy"
                                    @onclick="() => SetServing(detail, TrangThaiPhucVus.Preparing, confirmed: true)">
                                Vẫn bắt đầu (khách mang đi)
                            </button>
                        </div>
                    </div>
                }
                else if (confirmServeUnpaidId == detail.MaDonHang && detail.DangPhucVu
                         && detail.TrangThaiThanhToan == TrangThaiDon.Pending)
                {
                    @* Phục vụ khi chưa thu tiền là thao tác không hoàn tác (giải phóng số) → hỏi lại *@
                    <div class="confirm-inline" role="alertdialog" aria-labelledby="serve-unpaid-msg"
                         @onkeydown="CloseConfirmOnEscape">
                        <p id="serve-unpaid-msg">
                            Đơn <strong>#@detail.MaDonHang</strong> <strong>chưa thanh toán</strong>. Vẫn xác nhận đã phục vụ?
                            @(detail.SoNhanMon is { } holding ? $" Số {holding} sẽ được giải phóng." : "")
                        </p>
                        <div class="serving-actions">
                            <button type="button" class="btn btn-act-pay" disabled="@servingBusy" @onclick="FocusPayButton"
                                    @ref="confirmFirstButton">
                                Thu tiền trước
                            </button>
                            <button type="button" class="btn outline" disabled="@servingBusy"
                                    @onclick="() => SetServing(detail, TrangThaiPhucVus.Served, confirmed: true)">
                                Vẫn xác nhận đã phục vụ
                            </button>
                        </div>
                    </div>
                }
                else if (detail.DangPhucVu)
                {
                    @* Đi lần lượt từng bước, không bỏ qua: Chờ phục vụ → Đang chuẩn bị → Đã phục vụ.
                       Mỗi lúc chỉ có MỘT nút cho bước kế tiếp. *@
                    <ol class="serving-steps" aria-label="Tiến trình phục vụ">
                        @foreach (var step in ServingSteps)
                        {
                            int current = Array.IndexOf(ServingSteps, detail.PhucVu);
                            int index = Array.IndexOf(ServingSteps, step);
                            <li class="@(index < current ? "done" : index == current ? $"current step-{step.ToLowerInvariant()}" : "")"
                                aria-current="@(index == current ? "step" : null)">
                                @TrangThaiPhucVus.Label(step)
                            </li>
                        }
                    </ol>

                    <div class="serving-actions">
                        @if (detail.PhucVu == TrangThaiPhucVus.Waiting)
                        {
                            <button type="button"
                                    class="btn btn-act-prepare"
                                    disabled="@servingBusy"
                                    @onclick="() => SetServing(detail, TrangThaiPhucVus.Preparing)">
                                <Icon Name="cup" Size="16" />
                                Bắt đầu chuẩn bị
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-act-serve"
                                    disabled="@servingBusy"
                                    @onclick="() => SetServing(detail, TrangThaiPhucVus.Served)">
                                <Icon Name="check" Size="16" />
                                Xác nhận đã phục vụ
                            </button>
                        }
                    </div>
                }

                @if (servingError is not null && !detail.DangPhucVu)
                {
                    <p class="alert error" role="alert">@servingError</p>
                }
            </div>
            }

            <!-- NGHIỆP VỤ: THANH TOÁN -->
            <div class="order-action-group">

                @if (detail.TrangThaiThanhToan == TrangThaiDon.Pending)
                {
                    @* Đơn giản hóa: không nhập "tiền khách đưa" — nhân viên chỉ xác nhận đã thu đủ.
                       Khách chuyển khoản trên tablet → cổng thanh toán báo về, đơn tự sang PAID ("Đã thu"). *@
                    <div class="pay-box">
                        <div class="pay-box-head">
                            <span>Cần thu</span>
                            <strong class="grand-total small">@Money(detail.TongTien)</strong>
                        </div>

                        @* Hình thức thanh toán: chọn ngay trên nút xác nhận (như các phần mềm bán hàng), mặc định là hình thức khách đã chọn.
                           Chỉ được ghi vào đơn khi bấm xác nhận — để đối soát két tiền mặt / sao kê ngân hàng cuối ca cho đúng. *@
                        <fieldset class="pay-picker" disabled="@paying">
                            <legend>Hình thức thanh toán</legend>
                            @foreach (var m in PayMethods)
                            {
                                <label class="pay-picker-option @(payMethod == m ? "is-selected" : "")">
                                    <input type="radio"
                                           name="pay-method"
                                           value="@m"
                                           aria-label="@PhuongThucThanhToans.Label(m)"
                                           checked="@(payMethod == m)"
                                           @onchange="() => SelectPayMethod(m)" />
                                    <Icon Name="@(m == PhuongThucThanhToans.Cash ? "coins" : "check")" Size="16" />
                                    @PhuongThucThanhToans.Label(m)
                                </label>
                            }
                        </fieldset>

                        @{
                            string? payChangedText = payMethod != detail.PhuongThucThanhToan
                                ? $"Khách đã chọn {PhuongThucThanhToans.Label(detail.PhuongThucThanhToan).ToLowerInvariant()} khi đặt. " +
                                  $"Đơn sẽ được ghi là {PhuongThucThanhToans.Label(payMethod).ToLowerInvariant()} khi xác nhận."
                                : null;
                        }
                        @* Vùng live luôn có mặt (chỉ đổi chữ); phần nhìn thấy ở <p> bên dưới *@
                        <span class="sr-only" role="status">@payChangedText</span>
                        @if (payChangedText is not null)
                        {
                            <p class="pay-picker-changed" aria-hidden="true">@payChangedText</p>
                        }

                        @if (payMethod == PhuongThucThanhToans.QrTransfer)
                        {
                            <p class="form-note">
                                @* Câu "tự cập nhật" chỉ đúng khi chính khách chọn chuyển khoản lúc đặt (cổng thanh toán báo về) *@
                                @if (detail.PhuongThucThanhToan == PhuongThucThanhToans.QrTransfer && detail.MaNguoiDung is null)
                                {
                                    <text>Khách chuyển khoản trên tablet: hệ thống tự cập nhật "@TrangThaiDon.Label(TrangThaiDon.Paid)" khi nhận được tiền. </text>
                                }
                                Chỉ bấm xác nhận khi đã kiểm tra tài khoản nhận được tiền (nội dung: <strong>COFFEE @detail.MaDonHang</strong>).
                            </p>
                        }

                        <button type="button"
                                class="btn btn-act-pay btn-large"
                                disabled="@paying"
                                @ref="payButtonRef"
                                @onclick="() => Pay(detail)">
                            <Icon Name="@(payMethod == PhuongThucThanhToans.Cash ? "coins" : "check")" Size="18" />
                            @(paying
                                ? "Đang xác nhận…"
                                : payMethod == PhuongThucThanhToans.Cash ? "Xác nhận đã thu tiền mặt" : "Xác nhận đã nhận chuyển khoản")
                        </button>
                    </div>

                    @if (payError is not null)
                    {
                        <p class="alert error" role="alert">@payError</p>
                    }
                }

                <!-- Các nút hành động phụ -->
                <div class="detail-actions">
                    <button type="button"
                            class="btn outline"
                            disabled="@detail.DaHuy"
                            title="@(detail.DaHuy ? "Đơn đã hủy, không in hóa đơn" : "In hóa đơn cho khách")"
                            @onclick="PrintReceipt">
                        <Icon Name="printer" Size="16" />
                        In hóa đơn
                    </button>

                </div>

            </div>

        </aside>
    }

</div>

<!-- ========================================================================= -->
<!-- MODAL TẠO ĐƠN TẠI QUẦY -->
<!-- ========================================================================= -->
@if (isOrderModalOpen)
{
    <Modal Title="@(editingOrderId is { } editId ? $"Sửa đơn hàng #{editId}" : "Tạo đơn hàng tại quầy")"
           OnClose="CloseOrderModal"
           Busy="@creating">

        <div class="order-modal-builder">

            @if (menuError is not null)
            {
                <p class="alert error" role="alert">@menuError</p>
            }

            <div class="form-grid">
                <div class="field">
                    <label for="order-payment">Hình thức thanh toán</label>
                    <select id="order-payment" @bind="draftPaymentMethod">
                        <option value="@PhuongThucThanhToans.Cash">@PhuongThucThanhToans.Label(PhuongThucThanhToans.Cash)</option>
                        <option value="@PhuongThucThanhToans.QrTransfer">@PhuongThucThanhToans.Label(PhuongThucThanhToans.QrTransfer)</option>
                    </select>
                </div>
            </div>

            <!-- Bộ công cụ thêm món vào đơn -->
            <div class="item-builder-card">
                <strong class="builder-title">Thêm món & topping vào đơn</strong>

                <div class="form-grid">
                    <div class="field">
                        <label for="builder-product">Chọn món</label>
                        <select id="builder-product" @bind="builderProductId" @bind:after="OnBuilderProductChanged">
                            @if (menuLoading)
                            {
                                <option value="0">Đang tải thực đơn…</option>
                            }
                            @foreach (var prod in menu)
                            {
                                <option value="@prod.MaTenMon">@prod.TenMon</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="builder-size">Kích cỡ</label>
                        <select id="builder-size" @bind="builderSizeId">
                            @foreach (var s in BuilderSizes)
                            {
                                <option value="@s.MaChiTietMon">
                                    @s.TenKichThuoc — @Money(s.GiaSauGiam)@(s.GiaSauGiam < s.GiaBan ? $" (gốc {Money(s.GiaBan)})" : "")
                                </option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="builder-quantity">Số lượng</label>
                        <input id="builder-quantity" type="number" min="1" max="50" @bind="builderQuantity" />
                    </div>

                    <div class="field">
                        <label for="builder-note">Ghi chú món</label>
                        <input id="builder-note" maxlength="255" @bind="builderNote" placeholder="70% đường, ít đá…" />
                    </div>
                </div>

                @if (availableToppings.Count > 0)
                {
                    <fieldset class="field">
                        <legend>Topping thêm (mỗi loại 1 phần/ly)</legend>
                        <div class="toppings-picker-grid">
                            @foreach (var top in availableToppings)
                            {
                                <label class="topping-checkbox-item">
                                    <input type="checkbox"
                                           checked="@selectedToppingIds.Contains(top.MaTopping)"
                                           @onchange="e => ToggleTopping(top.MaTopping, e)" />
                                    <span>@top.TenTopping (+@Money(top.GiaThem))</span>
                                </label>
                            }
                        </div>
                    </fieldset>
                }

                <div class="builder-actions">
                    <button type="button" class="btn outline" disabled="@(BuilderSize is null)" @onclick="AddItemToDraft">
                        <Icon Name="plus" Size="14" />
                        Thêm món này vào đơn
                    </button>
                </div>
            </div>

            <!-- Bảng các món trong đơn đang tạo -->
            <div>
                <strong class="builder-title">Các món trong đơn (@draftLines.Count):</strong>

                <div class="table-wrap builder-items-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Món & size</th>
                                <th>Topping</th>
                                <th>Đơn giá</th>
                                <th>SL</th>
                                <th>Thành tiền</th>
                                <th><span class="sr-only">Bỏ món</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in draftLines)
                            {
                                <tr>
                                    <td>
                                        <strong>@line.TenMon</strong>
                                        <div class="muted">@line.TenKichThuoc@(string.IsNullOrWhiteSpace(line.GhiChu) ? "" : $" · {line.GhiChu}")</div>
                                    </td>
                                    <td>
                                        @(line.Toppings.Count > 0 ? string.Join(", ", line.Toppings.Select(t => t.TenTopping)) : "Không")
                                    </td>
                                    <td>@Money(line.DonGia)</td>
                                    <td><strong>@line.SoLuong</strong></td>
                                    <td><strong class="text-accent">@Money(line.ThanhTien)</strong></td>
                                    <td>
                                        <button type="button" class="icon-button" aria-label="Bỏ @line.TenMon khỏi đơn" @onclick="() => draftLines.Remove(line)">
                                            <Icon Name="close" Size="14" />
                                        </button>
                                    </td>
                                </tr>
                            }

                            @if (draftLines.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="empty-cell">
                                        Chưa có món nào. Chọn món rồi bấm "Thêm món này vào đơn".
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4">Tạm tính:</td>
                                <td colspan="2"><strong class="grand-total small">@Money(draftLines.Sum(l => l.ThanhTien))</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <p class="form-note">
                    @(editingOrderId is null
                        ? "Tổng tiền chính thức do máy chủ tính khi tạo đơn (áp khuyến mãi theo giờ hiện tại)."
                        : "Tổng tiền chính thức do máy chủ tính lại khi lưu (áp khuyến mãi theo giờ tạo đơn).")
                </p>
            </div>

        </div>

        @if (orderModalError is not null)
        {
            <div class="alert error modal-error" role="alert">
                <span>@orderModalError</span>
                @if (shortages.Count > 0)
                {
                    <ul class="alert-list">
                        @foreach (var s in shortages)
                        {
                            <li>@s.TenNguyenLieu: cần @Number(s.CanDung) @s.DonViTinh, còn @Number(s.ConTon) @s.DonViTinh</li>
                        }
                    </ul>
                }
            </div>
        }

        <div class="modal-footer">
            <button type="button" class="btn outline" disabled="@creating" @onclick="CloseOrderModal">Hủy</button>
            <button type="button" class="btn primary" disabled="@(creating || draftLines.Count == 0)" @onclick="SaveDraftOrder">
                @(editingOrderId is null
                    ? (creating ? "Đang tạo đơn…" : "Tạo đơn hàng")
                    : (creating ? "Đang lưu…" : "Lưu thay đổi"))
            </button>
        </div>

    </Modal>
}

<!-- ========================================================================= -->
<!-- MODAL HỦY ĐƠN (chỉ Quản lý) -->
<!-- ========================================================================= -->
@if (isCancelModalOpen && SelectedOrder is { } toCancel)
{
    <Modal Title="Hủy đơn hàng" OnClose="CloseCancelModal" Busy="@cancelling">
        <p>
            Hủy đơn hàng <strong>#@toCancel.MaDonHang</strong> (tổng tiền @Money(toCancel.TongTien))?
        </p>

        @if (toCancel.TrangThaiThanhToan == TrangThaiDon.Paid)
        {
            <p class="alert error">Đơn đã thanh toán — hệ thống sẽ đánh dấu <strong>hoàn tiền</strong> cho khách. Nguyên liệu đã dùng không được cộng lại kho.</p>
        }

        <div class="field">
            <label for="cancel-reason">Lý do hủy *</label>
            <textarea id="cancel-reason"
                      rows="2"
                      maxlength="255"
                      @bind="cancelReason"
                      @bind:event="oninput"
                      placeholder="Ví dụ: Khách đổi ý, hết món…"></textarea>
        </div>

        @if (cancelError is not null)
        {
            <p class="alert error" role="alert">@cancelError</p>
        }

        <div class="modal-footer">
            <button type="button" class="btn outline" disabled="@cancelling" @onclick="CloseCancelModal">Đóng</button>
            <button type="button" class="btn danger" disabled="@(cancelling || string.IsNullOrWhiteSpace(cancelReason))" @onclick="ConfirmCancelOrder">
                @(cancelling ? "Đang hủy…" : "Xác nhận hủy đơn")
            </button>
        </div>
    </Modal>
}

<!-- ========================================================================= -->
<!-- MẪU HÓA ĐƠN IN CHO KHÁCH (ẩn; appHelpers.printReceipt chép nội dung này sang khung in riêng) -->
<!-- ========================================================================= -->
@if (SelectedOrder is { } receipt)
{
    @* HÓA ĐƠN IN CHO KHÁCH — giấy nhiệt K80 (rộng 80mm, vùng in 72mm), dài theo nội dung.
       Bố cục theo mẫu hóa đơn quán cà phê / trà sữa phổ biến (KiotViet, Sapo, iPOS…), cá nhân hóa cho dự án:
       tên quán → HÓA ĐƠN THANH TOÁN → HĐ / Ngày / Giờ (+ số nhận món) → bảng TÊN HÀNG | SL | Đ.GIÁ | T.TIỀN
       → T.CỘNG → TỔNG THANH TOÁN + số tiền bằng chữ → hình thức (khi đã thu) → lời cảm ơn.
       Không in: trạng thái "chưa thu", tên nhân viên / tài khoản, mã nội bộ khác.
       Header / footer của trình duyệt (ngày, tiêu đề, đường dẫn) bị tắt bằng @page margin 0 trong appHelpers. *@
    <div id="receipt-source" hidden>
        <div class="r-center r-head">
            <div class="r-shop">@ReceiptShopName</div>
            @if (!string.IsNullOrWhiteSpace(ReceiptAddress))
            {
                <div class="r-small">@ReceiptAddress</div>
            }
            @if (!string.IsNullOrWhiteSpace(ReceiptPhone))
            {
                <div class="r-small">ĐT: @ReceiptPhone</div>
            }
            <div class="r-title">HÓA ĐƠN THANH TOÁN</div>
        </div>

        <table class="r-info">
            <tr>
                <td>HĐ: <strong>@receipt.MaDonHang.ToString("D4")</strong></td>
                <td class="r-right">@(receipt.SoNhanMon is { } receiptNo ? $"Số nhận món: {receiptNo}" : "")</td>
            </tr>
            <tr>
                <td>Ngày: @receipt.ThoiGianTao.ToString("dd/MM/yyyy")</td>
                <td class="r-right">Giờ: @receipt.ThoiGianTao.ToString("HH:mm:ss")</td>
            </tr>
        </table>

        <table class="r-items">
            <colgroup>
                <col />
                <col class="c-qty" />
                <col class="c-price" />
                <col class="c-total" />
            </colgroup>
            <thead>
                <tr>
                    <th>TÊN HÀNG</th>
                    <th class="r-num">SL</th>
                    <th class="r-num">Đ.GIÁ</th>
                    <th class="r-num">T.TIỀN</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in receipt.ChiTiet ?? [])
                {
                    <tr class="r-line">
                        <td>@line.TenMonLuu</td>
                        <td class="r-num">@line.SoLuong</td>
                        <td class="r-num">@Number(line.DonGiaBan)</td>
                        <td class="r-num">@Number(line.DonGiaBan * line.SoLuong)</td>
                    </tr>
                    @foreach (var top in line.Toppings)
                    {
                        <tr class="r-topping">
                            <td>+ @top.TenToppingLuu</td>
                            <td class="r-num">@line.SoLuong</td>
                            <td class="r-num">@Number(top.DonGiaTopping)</td>
                            <td class="r-num">@Number(top.DonGiaTopping * line.SoLuong)</td>
                        </tr>
                    }
                    @if (!string.IsNullOrWhiteSpace(line.GhiChu))
                    {
                        <tr class="r-note">
                            <td colspan="4">Ghi chú: @line.GhiChu</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr class="r-sum">
                    <td>T.CỘNG</td>
                    <td class="r-num">@receipt.SoPhan</td>
                    <td></td>
                    <td class="r-num">@Number(receipt.TongTien)</td>
                </tr>
            </tfoot>
        </table>

        <div class="r-row r-total"><span>TỔNG THANH TOÁN</span><span class="r-money">@Money(receipt.TongTien)</span></div>
        <div class="r-words">(@DocSoTien.Doc(receipt.TongTien))</div>

        @if (receipt.TrangThaiThanhToan == TrangThaiDon.Paid)
        {
            <div class="r-row r-paid"><span>@PhuongThucThanhToans.Label(receipt.PhuongThucThanhToan)</span><span class="r-money">@Number(receipt.TongTien)</span></div>
        }

        <div class="r-center r-thanks">Cảm ơn quý khách!</div>
        @if (!string.IsNullOrWhiteSpace(ReceiptFooter))
        {
            <div class="r-center r-small">@ReceiptFooter</div>
        }
    </div>
}

