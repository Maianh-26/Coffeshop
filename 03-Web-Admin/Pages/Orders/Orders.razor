    /// <summary>
    /// Dò đơn mới từ Tablet trên toàn bộ dữ liệu (không theo trang / bộ lọc đang xem).
    /// <paramref name="newestFirst"/> = trang 1 không lọc vừa tải (dùng lại, khỏi gọi thêm); null = hỏi riêng máy chủ.
    /// Lần đầu chỉ ghi nhận mã đơn lớn nhất, không báo (đơn có sẵn khi mở trang không tính là "mới").
    /// </summary>
    private async Task CheckNewOrders(List<DonHang>? newestFirst, Task<PagedResult<DonHang>>? scanTask, CancellationToken ct)
    {
        try
        {
            if (newestFirst is null)
            {
                newestFirst = (await (scanTask ?? OrderApi.GetPageAsync(1, NewOrderScan, ct: ct))).Data;
            }
            else if (scanTask is not null)
            {
                await scanTask; // không dùng tới, chỉ để không bỏ rơi task đang chạy
            }
        }
        catch (ApiException ex)
        {
            // Không làm phiền người dùng: lần làm mới sau sẽ thử lại
            Logger.LogWarning("Không dò được đơn mới: {Message}", ex.Message);
            return;
        }

        int maxId = newestFirst.Count == 0 ? 0 : newestFirst.Max(o => o.MaDonHang);

        if (newOrdersInitialized)
        {
            var arrived = newestFirst.Where(o => o.MaDonHang > lastSeenOrderId && o.MaNguoiDung is null).ToList();

            if (arrived.Count > 0)
            {
                foreach (var o in arrived) newOrderIds.Add(o.MaDonHang);
                newBannerHidden = false; // có đơn mới nữa → hiện lại thông báo dù trước đó đã ẩn
            }
        }

        // Cập nhật bản lưu của các đơn mới (để mở được chi tiết khi đơn không nằm trong trang đang xem)
        foreach (var o in newestFirst.Where(o => newOrderIds.Contains(o.MaDonHang)))
        {
            newOrderCache[o.MaDonHang] = o;
        }

        // Đơn đã bị hủy hoặc đã phục vụ xong ở máy khác thì thôi báo (không lọc theo "đã thanh toán":
        // đơn chuyển khoản trên tablet tự sang PAID ngay nhưng vẫn cần nhân viên xử lý); bỏ bản lưu của đơn không còn "mới"
        newOrderIds.RemoveWhere(id => newOrderCache.GetValueOrDefault(id) is { DangPhucVu: false });
        foreach (int id in newOrderCache.Keys.Where(id => !newOrderIds.Contains(id)).ToList())
        {
            newOrderCache.Remove(id);
        }

        lastSeenOrderId = Math.Max(lastSeenOrderId, maxId);
        newOrdersInitialized = true;
    }

    /// <summary>Đơn mới chưa xem, cũ nhất trước (đơn đến trước xử lý trước).</summary>
    private List<DonHang> UnseenNewOrders =>
        newOrderIds.Select(id => newOrderCache.GetValueOrDefault(id))
            .OfType<DonHang>()
            .OrderBy(o => o.MaDonHang)
            .ToList();

