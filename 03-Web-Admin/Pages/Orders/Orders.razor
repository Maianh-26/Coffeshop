@if (isCancelModalOpen && SelectedOrder is { } toCancel)
{
    <Modal Title="Hủy đơn hàng" OnClose="CloseCancelModal" Busy="@cancelling">
        <p>
            Hủy đơn hàng <strong>#@toCancel.MaDonHang</strong> (tổng tiền @Money(toCancel.TongTien))?
        </p>

        @if (toCancel.TrangThaiThanhToan == TrangThaiDon.Paid)
        {
            <p class="alert error">Đơn đã thanh toán — hệ thống sẽ đánh dấu <strong>hoàn tiền</strong> cho khách. Nguyên liệu đã dùng không được cộng lại kho.</p>
        }

        <div class="field">
            <label for="cancel-reason">Lý do hủy *</label>
            <textarea id="cancel-reason"
                      rows="2"
                      maxlength="255"
                      @bind="cancelReason"
                      @bind:event="oninput"
                      placeholder="Ví dụ: Khách đổi ý, hết món…"></textarea>
        </div>

        @if (cancelError is not null)
        {
            <p class="alert error" role="alert">@cancelError</p>
        }

        <div class="modal-footer">
            <button type="button" class="btn outline" disabled="@cancelling" @onclick="CloseCancelModal">Đóng</button>
            <button type="button" class="btn danger" disabled="@(cancelling || string.IsNullOrWhiteSpace(cancelReason))" @onclick="ConfirmCancelOrder">
                @(cancelling ? "Đang hủy…" : "Xác nhận hủy đơn")
            </button>
        </div>
    </Modal>
}

