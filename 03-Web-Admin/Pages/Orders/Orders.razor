    /// <returns>Đơn vừa lưu số (đúng đơn được truyền vào), hoặc null nếu không lưu / lỗi.</returns>
    private async Task<DonHang?> SavePickupNumber(DonHang order)
    {
        if (servingBusy || pickupInput == order.SoNhanMon) return null;

        if (pickupInput is { } n && (n < SoNhanMons.Min || n > SoNhanMons.Max))
        {
            servingError = $"Số nhận món phải từ {SoNhanMons.Min} đến {SoNhanMons.Max}.";
            return null;
        }

        servingBusy = true;
        servingError = null;

        try
        {
            var updated = await OrderApi.SetPickupNumberAsync(order.MaDonHang, pickupInput, pageCts.Token);
            pickupDirty = false;
            Replace(updated);
            ShowAlert(updated.SoNhanMon is { } so
                ? $"Đã gán số nhận món {so} cho đơn #{updated.MaDonHang}."
                : $"Đã bỏ số nhận món của đơn #{updated.MaDonHang}.", "success");
            return updated;
        }
        catch (ApiException ex)
        {
            servingError = ProposedApiError(ex);
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            servingBusy = false;
        }

        return null;
    }

    private async Task SetServing(DonHang order, string status, bool confirmed = false)
    {
        if (servingBusy) return;

        int? savedNumber = null; // số vừa được lưu kèm trong cùng lần bấm (để báo gộp)

        if (status == TrangThaiPhucVus.Preparing && !confirmed)
        {
            if (pickupDirty && pickupInput != order.SoNhanMon)
            {
                // Ô bị xóa trống / gõ giá trị không hợp lệ trong lúc đơn đang có số → không âm thầm bắt đầu với số cũ
                if (pickupInput is null)
                {
                    servingError = "Ô số nhận món đang trống hoặc không hợp lệ. Nhập lại số, hoặc bấm Lưu số để bỏ số.";
                    return;
                }

                // Đã gõ số nhưng chưa bấm "Lưu số" → lưu luôn rồi mới bắt đầu (đỡ một lần bấm, không mất số đã gõ).
                // Dùng đúng đơn vừa lưu: người dùng có thể đã bấm sang đơn khác trong lúc chờ máy chủ.
                if (await SavePickupNumber(order) is not { } saved) return; // số trùng / sai → lỗi đã hiện cạnh ô nhập
                order = saved;
                savedNumber = saved.SoNhanMon;
            }

            // Chưa có số nhận món → hỏi lại trước
            if (order.SoNhanMon is null)
            {
                confirmNoPickupId = order.MaDonHang;
                confirmServeUnpaidId = null;
                focusConfirmButton = true;
                return;
            }
        }

        // Phục vụ khi chưa thu tiền: hỏi lại trước (thao tác không hoàn tác)
        if (status == TrangThaiPhucVus.Served && !confirmed && order.TrangThaiThanhToan == TrangThaiDon.Pending)
        {
            confirmServeUnpaidId = order.MaDonHang;
            confirmNoPickupId = null;
            focusConfirmButton = true;
            return;
        }

        confirmServeUnpaidId = null;
        confirmNoPickupId = null;

        servingBusy = true;
        servingError = null;

        try
        {
            var updated = await OrderApi.SetServingStatusAsync(order.MaDonHang, status, pageCts.Token);
            Replace(updated);

            // Nút vừa bấm bị thay bằng nút bước kế tiếp (hoặc biến mất) → đưa focus về tiêu đề khung chi tiết
            if (selectedId == updated.MaDonHang) focusDetailHeading = true;
            ShowAlert(status == TrangThaiPhucVus.Served
                ? $"Đơn #{updated.MaDonHang} đã phục vụ.{(updated.SoNhanMon is { } so ? $" Số {so} đã được giải phóng." : "")}"
                : savedNumber is { } no
                    ? $"Đã gán số {no} và bắt đầu chuẩn bị đơn #{updated.MaDonHang}."
                    : $"Đơn #{updated.MaDonHang} đang được chuẩn bị.", "success");
        }
        catch (ApiException ex)
        {
            servingError = ProposedApiError(ex);
            if (ex.Status == 409)
            {
                ClearClientSortCache();
                await LoadOrders(quiet: true);
            }
        }
        catch (OperationCanceledException) when (pageCts.IsCancellationRequested)
        {
        }
        finally
        {
            servingBusy = false;
        }
    }

