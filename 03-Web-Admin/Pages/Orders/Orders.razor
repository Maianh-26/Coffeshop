    private static class SortKeys
    {
        public const string None = "";          // mặc định: mới nhất trước
        public const string Id = "maDonHang";
        public const string Total = "tongTien";
    }

    private string sortKey = SortKeys.None;
    private bool sortDesc;
    private bool serverSortSupported = true;    // false khi máy chủ bỏ qua tham số sapXep (backend chưa cập nhật)

    /// <summary>Giá trị gửi lên máy chủ: "maDonHang" / "-maDonHang" / "tongTien" / "-tongTien".</summary>
    private string? SortParam => sortKey == SortKeys.None ? null : (sortDesc ? "-" : "") + sortKey;

    // Danh sách quá dài để web tự tải hết và sắp xếp → chỉ sắp xếp phần đơn mới nhất, báo rõ để người dùng lọc thêm
    // Tổng số đơn khớp bộ lọc (khi danh sách quá dài chỉ sắp xếp phần đầu, vẫn ghi tổng thật)
    private int FooterTotal => sortTruncated && sortKey != SortKeys.None ? totalOrdersAll : totalOrders;

    private bool SortNoteVisible => sortKey != SortKeys.None && sortTruncated;

    private string SortNoteText =>
        $"Danh sách có {totalOrdersAll:N0} đơn: đang sắp xếp {MaxClientSortOrders:N0} đơn mới nhất. Hãy lọc theo thời gian để sắp xếp đủ.";

    /// <summary>
    /// Bấm tiêu đề cột: cột mới → thấp đến cao; bấm lại cùng cột → đổi chiều (cao đến thấp ↔ thấp đến cao).
    /// Nút Làm mới đưa về thứ tự mặc định (mới nhất trước).
    /// </summary>
    private async Task ToggleSort(string key)
    {
        if (sortKey == key)
        {
            sortDesc = !sortDesc;
        }
        else
        {
            sortKey = key;
            sortDesc = false;
        }

        page = 1;
        await LoadOrders();
    }

    private decimal SortValue(DonHang o) => sortKey == SortKeys.Total ? o.TongTien : o.MaDonHang;

    /// <summary>Danh sách trả về đã đúng thứ tự yêu cầu chưa (để biết máy chủ có hỗ trợ sapXep không).</summary>
    private bool IsSorted(List<DonHang> list)
    {
        for (int i = 1; i < list.Count; i++)
        {
            int cmp = SortValue(list[i - 1]).CompareTo(SortValue(list[i]));
            if (sortDesc ? cmp < 0 : cmp > 0) return false;
        }

        return true;
    }

    /// <summary>Sắp xếp tại web (khi máy chủ chưa hỗ trợ "sapXep"); bằng nhau thì đơn mới hơn trước, giống đề xuất 5.3b.</summary>
    private List<DonHang> SortLocally(List<DonHang> list)
    {
        var sorted = sortDesc
            ? list.OrderByDescending(SortValue)
            : list.OrderBy(SortValue);

        return sorted.ThenByDescending(o => o.MaDonHang).ToList();
    }

    /// <summary>Bộ lọc đang áp dụng, dùng chung cho request 1 trang và request tải hết để sắp xếp.</summary>
    private sealed record OrderFilter(string? TrangThai, string? TrangThaiPhucVu, DateTime? TuNgay, DateTime? DenNgay);

    // Máy chủ chưa hỗ trợ "sapXep": web tự tải hết danh sách (đã lọc) theo lô 100 đơn — mức tối đa backend cho phép —
    // rồi sắp xếp và chia trang tại chỗ. Giới hạn để không tải quá nhiều khi danh sách rất dài.
    private const int FetchBatchSize = 100;
    private const int MaxClientSortOrders = 2000;
    private bool sortTruncated;      // danh sách dài hơn giới hạn → chỉ sắp xếp phần mới nhất
    private int totalOrdersAll;      // tổng số đơn khớp bộ lọc (kể cả phần không tải)

    // Danh sách đã tải hết + sắp xếp, giữ lại để chuyển trang / tự làm mới không phải tải lại toàn bộ.
    // Gắn với bộ lọc + cách sắp xếp; hết hạn sau ClientSortCacheSeconds (đơn mới vẫn được báo qua thông báo đơn mới).
    private const int ClientSortCacheSeconds = 60;
    private List<DonHang>? clientSorted;
    private string? clientSortedKey;
    private DateTime clientSortedAt;

    // Tăng mỗi lần xóa bộ nhớ đệm: lượt tải toàn bộ đang chạy dở (bắt đầu TRƯỚC khi thu tiền / sửa đơn…)
    // thấy số này đổi thì bỏ kết quả, không ghi đè dữ liệu mới bằng dữ liệu cũ.
    private int clientSortGeneration;
    // Lượt tải vừa rồi lấy danh sách từ bộ nhớ đệm (không hỏi máy chủ) → đơn đang xem phải hỏi lại riêng.
    private bool listFromCache;

    private void ClearClientSortCache()
    {
        clientSorted = null;
        clientSortGeneration++;
    }

    /// <summary>
    /// Tải mọi trang của danh sách đang lọc (song song sau trang đầu), sắp xếp toàn bộ theo cột đang chọn
    /// rồi cắt đúng trang đang xem. Trả false nếu lượt tải đã bị thay bởi lượt mới hơn.
    /// </summary>
    private async Task<bool> LoadAllAndSort(OrderFilter filter, CancellationToken ct)
    {
        // Mốc nhanh: khóa theo TÊN mốc (giờ cụ thể đổi mỗi lần tải); khoảng tự chọn: khóa theo 2 ngày đã chọn
        string range = appliedPreset == DatePresets.Custom ? $"{filter.TuNgay:yyyyMMdd}-{filter.DenNgay:yyyyMMdd}" : appliedPreset;
        string key = $"{filter.TrangThai}|{filter.TrangThaiPhucVu}|{range}|{SortParam}";

        // Còn danh sách vừa tải cho đúng bộ lọc + cách sắp xếp → chỉ cắt lại trang, không gọi máy chủ
        if (clientSorted is not null && clientSortedKey == key
            && DateTime.UtcNow - clientSortedAt < TimeSpan.FromSeconds(ClientSortCacheSeconds))
        {
            ShowClientSortedPage();
            listFromCache = true;
            return true;
        }

        int generation = clientSortGeneration;

        // Một lô lỗi → hủy ngay các lô còn lại thay vì để chúng chạy hết
        using var batchCts = CancellationTokenSource.CreateLinkedTokenSource(ct);

        async Task<PagedResult<DonHang>> Fetch(int p)
        {
            try
            {
                return await OrderApi.GetPageAsync(
                    p, FetchBatchSize,
                    trangThai: filter.TrangThai,
                    trangThaiPhucVu: filter.TrangThaiPhucVu,
                    tuNgay: filter.TuNgay,
                    denNgay: filter.DenNgay,
                    ct: batchCts.Token);
            }
            catch
            {
                batchCts.Cancel();
                throw;
            }
        }

        PagedResult<DonHang> first;
        PagedResult<DonHang>[] rest;
        int batches;

        // Trong lúc tải có thao tác đổi dữ liệu (thu tiền, sửa, tạo đơn…) → tải lại (tối đa 2 lần nữa) thay vì bỏ
        // lượt này: bỏ thì bảng giữ dữ liệu cũ dù biểu tượng sắp xếp / số trang đã đổi, và lượt tải lại sau 409 bị mất.
        for (int attempt = 0; ; attempt++)
        {
            first = await Fetch(1);
            if (ct.IsCancellationRequested) return false;

            batches = Math.Min(first.Meta.TotalPages, MaxClientSortOrders / FetchBatchSize);
            rest = await Task.WhenAll(Enumerable.Range(2, Math.Max(0, batches - 1)).Select(Fetch));

            // Bị thay bởi lượt mới hơn
            if (ct.IsCancellationRequested) return false;

            if (generation == clientSortGeneration || attempt >= 2) break;
            generation = clientSortGeneration;
        }

        var all = first.Data.Concat(rest.SelectMany(r => r.Data))
            .DistinctBy(o => o.MaDonHang)   // đơn mới chen vào giữa các lô có thể làm 1 đơn xuất hiện 2 lần
            .ToList();

        totalOrdersAll = first.Meta.Total;
        // Theo số TRANG còn lại chưa tải (không theo số đơn): đơn rời bộ lọc giữa các lô không làm báo nhầm
        sortTruncated = first.Meta.TotalPages > batches;

        clientSorted = SortLocally(all);
        clientSortedKey = key;
        clientSortedAt = DateTime.UtcNow;
        ShowClientSortedPage();
        listFromCache = false;
        return true;
    }

    /// <summary>Cắt trang đang xem từ danh sách đã sắp xếp ở web.</summary>
    private void ShowClientSortedPage()
    {
        var sorted = clientSorted ?? [];
        totalOrders = sorted.Count;
        totalPages = Math.Max(1, (int)Math.Ceiling(sorted.Count / (double)PageSize));
        page = Math.Clamp(page, 1, totalPages);
        orders = sorted.Skip((page - 1) * PageSize).Take(PageSize).ToList();
    }

