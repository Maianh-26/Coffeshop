    /// <summary>Nút Làm mới: bỏ mọi bộ lọc / tìm kiếm, về trang 1 và tải lại danh sách mới nhất.</summary>
    private async Task RefreshAll()
    {
        bool hadFilters = FiltersActive;

        search = "";
        searchText = "";
        searchHint = false;
        searchVersion++;
        datePreset = DatePresets.All;
        appliedPreset = DatePresets.All;
        fromDate = null;
        toDate = null;
        customFrom = null;
        customTo = null;
        dateError = null;
        sortKey = SortKeys.None;
        sortDesc = false;
        serverSortSupported = true;   // dò lại ở lần sắp xếp sau (backend có thể vừa được cập nhật)
        ClearClientSortCache();       // Làm mới = luôn tải lại dữ liệu mới nhất
        statusFilter = "";
        paymentFilter = "";
        page = 1;

        bool completed = await LoadOrders();

        // Chỉ báo khi lượt tải này thật sự xong (không bị lượt mới hơn thay thế),
        // và không đè cảnh báo kho / lỗi đang hiện từ thao tác trước
        // (danh sách cảnh báo kho đang MỞ thì để yên cho người dùng đọc; đã thu gọn thì thông báo mới hiện phía trên nó)
        if (completed && !(stockWarnings.Count > 0 && !stockCollapsed) && !(alertMessage is not null && alertType == "error"))
        {
            ShowAlert(hadFilters ? "Đã bỏ lọc và tải lại toàn bộ đơn hàng." : "Đã tải lại danh sách đơn hàng.", "success");
        }
    }

    private async Task Move(int direction)
    {
        int next = page + direction;
        if (next < 1 || next > totalPages) return;

        page = next;
        await LoadOrders();
    }

