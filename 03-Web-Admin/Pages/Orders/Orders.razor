@page "/orders"
@implements IDisposable
@inject IJSRuntime JS
@inject IConfiguration Configuration

<PageTitle>Đơn hàng - Coffee Shop</PageTitle>

<!-- Banner thông báo kết quả thao tác / đơn mới -->
@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="alert @alertType" role="status" style="margin-bottom: 14px; display: flex; align-items: center; justify-content: space-between;">
        <span>@alertMessage</span>
        <button type="button" class="icon-button" aria-label="Đóng thông báo" @onclick="() => alertMessage = null">
            <Icon Name="close" Size="14" />
        </button>
    </div>
}

<div class="orders-page master-detail-layout @(selected != null ? "has-detail" : "")">

    <!-- Cột trái: Bộ lọc, Thanh tác vụ và Danh sách đơn hàng -->
    <div class="master-panel">

        <section class="panel filters-panel">

            <div class="filter-row">

                <div class="search-field">

                    <Icon Name="search" />

                    <input @bind="search"
                           @bind:event="oninput"
                           placeholder="Tìm mã đơn, bàn, món…"
                           aria-label="Tìm đơn hàng theo mã đơn, bàn, thu ngân hoặc món" />

                </div>

                <div class="date-range">

                    <input type="date"
                           aria-label="Từ ngày"
                           @bind="fromDate" />

                    <span>–</span>

                    <input type="date"
                           aria-label="Đến ngày"
                           @bind="toDate" />

                </div>

                <select aria-label="Lọc trạng thái đơn" @bind="statusFilter">
                    <option value="">Tất cả trạng thái đơn</option>
                    <option>Chờ tiếp nhận</option>
                    <option>Đang pha chế</option>
                    <option>Hoàn thành</option>
                    <option>Đã hủy</option>
                </select>

                <select aria-label="Lọc trạng thái thanh toán" @bind="paymentFilter">
                    <option value="">Tất cả thanh toán</option>
                    <option>Chưa thanh toán</option>
                    <option>Đã thanh toán</option>
                </select>

                <button class="btn primary"
                        @onclick="Filter">

                    <Icon Name="filter" />
                    Lọc

                </button>

                <button class="btn outline"
                        @onclick="Reset">

                    <Icon Name="reset" />
                    Đặt lại

                </button>

            </div>

        </section>

        <!-- Thanh thao tác: Tạo đơn, Sửa, Xóa và Realtime Tablet -->
        <section class="panel action-bar" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">

            <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">

                <button class="btn primary"
                        @onclick="OpenCreateOrder">

                    <Icon Name="plus" />
                    Tạo đơn tại quầy

                </button>

                <button class="btn outline"
                        disabled="@(selected == null)"
                        @onclick="OpenEditOrder">

                    <Icon Name="edit" />
                    Sửa đơn

                </button>

                <button class="btn danger-outline"
                        disabled="@(selected == null)"
                        @onclick="OpenDeleteOrder">

                    <Icon Name="trash" />
                    Hủy đơn

                </button>

            </div>

            <!-- Cơ chế Tự động làm mới từ Tablet -->
            <div class="realtime-controls">

                <button type="button"
                        class="realtime-pill @(!autoRefreshEnabled ? "paused" : "")"
                        @onclick="ToggleAutoRefresh"
                        title="Bật/Tắt tự động đồng bộ đơn mới từ Tablet">

                    <span class="live-indicator" aria-hidden="true"></span>
                    <span>@(autoRefreshEnabled ? "Tablet Realtime: Đang bật" : "Tablet Realtime: Tạm dừng")</span>

                </button>

                @* Công cụ thử nghiệm — chỉ hiện khi chạy với dữ liệu giả *@
                @if (Configuration.GetValue("Api:UseMock", true))
                {
                    <button class="btn outline btn-compact"
                            @onclick="SimulateTabletOrder"
                            title="Mô phỏng khách từ Tablet ở bàn bấm gửi đơn về thu ngân">

                        <Icon Name="cup" Size="14" />
                        Mô phỏng gửi đơn từ Tablet

                    </button>
                }

            </div>

        </section>

        <!-- Danh sách đơn hàng -->
        <section class="panel list-panel">

            <div class="table-wrap">

                <table class="orders-table">

                    <thead>

                        <tr>
                            <th>Mã đơn</th>
                            <th>Nguồn</th>
                            <th>Thời gian</th>
                            <th>Bàn / Vị trí</th>
                            <th>Số món</th>
                            <th>Tổng tiền</th>
                            <th>Thanh toán</th>
                            <th>Trạng thái đơn</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var order in VisibleOrders)
                        {
                            <tr class="selectable @(selected == order.Code ? "selected" : "")"
                                tabindex="0"
                                @onclick="() => SelectOrder(order.Code)"
                                @onclick:stopPropagation="true">

                                <td>
                                    <strong>@order.Code</strong>
                                </td>

                                <td>
                                    <span class="badge @(order.Source == "Tablet" ? "purple" : "gray")">
                                        @order.Source
                                    </span>
                                </td>

                                <td>
                                    @order.CreatedAt.ToString("HH:mm · dd/MM")
                                </td>

                                <td>
                                    <strong>@order.TableOrArea</strong>
                                </td>

                                <td>
                                    @order.Items.Sum(i => i.Quantity) phần
                                </td>

                                <td>
                                    <strong class="text-accent">@Money(order.Total)</strong>
                                </td>

                                <td>
                                    <span class="badge @(order.PaymentStatus == "Đã thanh toán" ? "green" : "yellow")">
                                        @order.PaymentStatus
                                    </span>
                                </td>

                                <td>
                                    <span class="badge @StatusBadgeColor(order.Status)">
                                        @order.Status
                                    </span>
                                </td>

                            </tr>
                        }

                        @if (VisibleOrders.Count == 0)
                        {
                            <tr>

                                <td class="empty-cell" colspan="8">

                                    <Icon Name="orders" Size="32" />

                                    <p>
                                        Không tìm thấy đơn hàng nào phù hợp với bộ lọc.
                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="list-footer">

                <span>
                    @FilteredOrders.Count() đơn hàng
                    @(selected == null ? "· Nhấp vào đơn hàng để xem chi tiết" : "")
                    · Trang @(page)/@Pages
                </span>

                <div class="pagination">

                    <button class="page-button"
                            aria-label="Trang trước"
                            @onclick="() => Move(-1)">

                        <Icon Name="left" Size="16" />

                    </button>

                    <span class="page-number">
                        @(page)
                    </span>

                    <button class="page-button"
                            aria-label="Trang sau"
                            @onclick="() => Move(1)">

                        <Icon Name="right" Size="16" />

                    </button>

                </div>

            </div>

        </section>

    </div>

    <!-- Cột phải: Ô CHỨC NĂNG CHI TIẾT ĐƠN HÀNG (Chỉ hiển thị khi đã chọn 1 đơn hàng) -->
    @if (SelectedOrderDetail != null)
    {
        var detail = SelectedOrderDetail;

        <aside class="detail-panel panel">

            <div class="order-detail-header">
                <div>
                    <h3>Đơn hàng #@detail.Code</h3>
                    <div style="display: flex; gap: 6px; align-items: center; margin-top: 4px;">
                        <span class="badge @StatusBadgeColor(detail.Status)">
                            @detail.Status
                        </span>
                        <span class="badge @(detail.PaymentStatus == "Đã thanh toán" ? "green" : "yellow")">
                            @detail.PaymentStatus
                        </span>
                        <span class="badge @(detail.Source == "Tablet" ? "purple" : "gray")">
                            @detail.Source
                        </span>
                    </div>
                </div>

                <button type="button"
                        class="icon-button"
                        aria-label="Đóng chi tiết"
                        title="Đóng khung chi tiết (trở về toàn màn hình)"
                        @onclick="() => selected = null">
                    <Icon Name="close" Size="20" />
                </button>
            </div>

            <!-- Thông tin tổng quan đơn hàng -->
            <div class="order-meta-info">
                <div class="meta-item">
                    <span class="meta-label">Thời gian tạo:</span>
                    <span class="meta-val">@detail.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Bàn / Vị trí:</span>
                    <span class="meta-val">@detail.TableOrArea</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Thu ngân / Phụ trách:</span>
                    <span class="meta-val">@detail.CashierName</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Hình thức thanh toán:</span>
                    <span class="meta-val">@detail.PaymentMethod</span>
                </div>

                @if (detail.AcceptedAt.HasValue)
                {
                    <div class="meta-item">
                        <span class="meta-label">Thời gian tiếp nhận:</span>
                        <span class="meta-val">@detail.AcceptedAt.Value.ToString("HH:mm:ss")</span>
                    </div>
                }

                @if (detail.PaidAt.HasValue)
                {
                    <div class="meta-item">
                        <span class="meta-label">Thời gian thanh toán:</span>
                        <span class="meta-val">@detail.PaidAt.Value.ToString("HH:mm:ss")</span>
                    </div>
                }
            </div>

            <!-- Danh sách món đã đặt chi tiết gồm món, size, topping, giá -->
            <div class="order-items-section">
                <h4>Chi tiết món đã đặt (@detail.Items.Sum(i => i.Quantity) phần)</h4>

                <div class="order-items-list">
                    @foreach (var item in detail.Items)
                    {
                        <div class="order-item-card">
                            <div class="item-main-row">
                                <span class="item-name">@item.ProductName</span>
                                <span class="item-qty">x@(item.Quantity)</span>
                                <span class="item-total">@Money(item.TotalPrice)</span>
                            </div>

                            <div class="item-options">
                                <div class="option-row">
                                    <span class="opt-label">Kích cỡ:</span>
                                    <span class="opt-val">@item.SizeName</span>
                                    @if (item.SizeExtraPrice > 0)
                                    {
                                        <span class="opt-price">(+@Money(item.SizeExtraPrice))</span>
                                    }
                                </div>

                                @if (item.Toppings != null && item.Toppings.Count > 0)
                                {
                                    <div class="option-row">
                                        <span class="opt-label">Topping:</span>
                                        <div class="toppings-tags">
                                            @foreach (var top in item.Toppings)
                                            {
                                                <span class="topping-pill">
                                                    + @top.ToppingName
                                                    <strong>(+@Money(top.Price))</strong>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="option-row">
                                        <span class="opt-label">Topping:</span>
                                        <span class="opt-muted">Không chọn thêm</span>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.Note))
                                {
                                    <div class="option-row">
                                        <span class="opt-label">Ghi chú:</span>
                                        <span class="opt-note-text">@item.Note</span>
                                    </div>
                                }

                                <div class="item-unit-calc">
                                    Đơn giá: @Money(item.UnitPrice) / phần
                                    @if (item.BasePrice > 0)
                                    {
                                        <span> · (Gốc @Money(item.BasePrice) + Phụ thu @Money(item.SizeExtraPrice + (item.Toppings?.Sum(t => t.Price) ?? 0)))</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Bảng kê tổng tiền -->
            <div class="order-summary-box">
                <div class="summary-line">
                    <span>Tạm tính (tiền món gốc):</span>
                    <span>@Money(detail.SubTotal)</span>
                </div>

                <div class="summary-line">
                    <span>Phụ thu Size & Topping:</span>
                    <span class="text-accent">+@Money(detail.ToppingTotal)</span>
                </div>

                @if (detail.DiscountAmount > 0)
                {
                    <div class="summary-line">
                        <span>Giảm giá khuyến mãi:</span>
                        <span class="text-danger">-@Money(detail.DiscountAmount)</span>
                    </div>
                }

                <div class="summary-line total-line">
                    <strong>Tổng tiền hóa đơn</strong>
                    <strong class="grand-total">@Money(detail.Total)</strong>
                </div>
            </div>

            <!-- KHỐI NGHIỆP VỤ: XÁC NHẬN THANH TOÁN & TIẾP NHẬN ĐƠN HÀNG -->
            <div class="order-action-group">

                <!-- 1. Tác vụ Tiếp nhận đơn hàng (nếu đang Chờ tiếp nhận) -->
                @if (detail.Status == "Chờ tiếp nhận")
                {
                    <button type="button"
                            class="btn primary btn-large"
                            @onclick="() => AcceptOrder(detail)">
                        <Icon Name="check" Size="18" />
                        Tiếp nhận đơn hàng (Bắt đầu pha chế)
                    </button>
                }

                <!-- 2. Tác vụ Thanh toán (nếu Chưa thanh toán) -->
                @if (detail.PaymentStatus != "Đã thanh toán" && detail.Status != "Đã hủy")
                {
                    @if (detail.PaymentMethod == "Tiền mặt")
                    {
                        <!-- Khách thanh toán Tiền mặt -->
                        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 6px; padding: 12px; margin-top: 4px;">
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                                <strong style="color: #92400e; font-size: 13px;">Thu tiền mặt: @Money(detail.Total)</strong>
                                <span class="badge yellow">Chưa thanh toán</span>
                            </div>
                            <button type="button"
                                    class="btn btn-success btn-large"
                                    @onclick="() => ConfirmCashPayment(detail)">
                                <Icon Name="coins" Size="18" />
                                Xác nhận đã thu đủ tiền mặt
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- Khách thanh toán Quét mã QR -->
                        <div class="qr-payment-box">
                            <strong style="color: #9a3412; font-size: 13px;">Mã QR chuyển khoản VietQR (@Money(detail.Total))</strong>

                            <div class="qr-code-canvas">
                                <!-- SVG Mô phỏng mã QR tiêu chuẩn thanh toán ngân hàng -->
                                <svg class="qr-code-svg" viewBox="0 0 100 100">
                                    <rect width="100" height="100" fill="#ffffff" />
                                    <!-- 3 góc QR định vị -->
                                    <rect x="5" y="5" width="28" height="28" fill="#1e293b" />
                                    <rect x="9" y="9" width="20" height="20" fill="#ffffff" />
                                    <rect x="13" y="13" width="12" height="12" fill="#89543a" />

                                    <rect x="67" y="5" width="28" height="28" fill="#1e293b" />
                                    <rect x="71" y="9" width="20" height="20" fill="#ffffff" />
                                    <rect x="75" y="13" width="12" height="12" fill="#89543a" />

                                    <rect x="5" y="67" width="28" height="28" fill="#1e293b" />
                                    <rect x="9" y="71" width="20" height="20" fill="#ffffff" />
                                    <rect x="13" y="75" width="12" height="12" fill="#89543a" />

                                    <!-- Dữ liệu pixel QR ngẫu nhiên biểu trưng -->
                                    <rect x="38" y="10" width="6" height="6" fill="#1e293b" />
                                    <rect x="48" y="15" width="8" height="6" fill="#1e293b" />
                                    <rect x="38" y="25" width="18" height="6" fill="#89543a" />
                                    <rect x="10" y="38" width="6" height="8" fill="#1e293b" />
                                    <rect x="22" y="42" width="10" height="6" fill="#1e293b" />
                                    <rect x="38" y="38" width="24" height="24" fill="#89543a" />
                                    <rect x="44" y="44" width="12" height="12" fill="#ffffff" />
                                    <circle cx="50" cy="50" r="4" fill="#89543a" />
                                    <rect x="68" y="38" width="10" height="8" fill="#1e293b" />
                                    <rect x="82" y="42" width="12" height="6" fill="#1e293b" />
                                    <rect x="10" y="52" width="12" height="6" fill="#1e293b" />
                                    <rect x="70" y="52" width="18" height="6" fill="#1e293b" />
                                    <rect x="38" y="68" width="8" height="6" fill="#1e293b" />
                                    <rect x="52" y="68" width="6" height="12" fill="#1e293b" />
                                    <rect x="42" y="78" width="14" height="6" fill="#89543a" />
                                    <rect x="68" y="68" width="24" height="6" fill="#1e293b" />
                                    <rect x="74" y="80" width="16" height="12" fill="#1e293b" />
                                </svg>
                            </div>

                            <div class="qr-payment-info">
                                <div>Nội dung: <strong>COFFEE @detail.Code</strong></div>
                                <div>Số tiền: <strong>@Money(detail.Total)</strong></div>
                            </div>

                            <div class="qr-listening-pulse">
                                <span class="live-indicator"></span>
                                <span>Đang tự động lắng nghe quét mã từ khách...</span>
                            </div>

                            <!-- Nút mô phỏng khách quét QR thành công (hệ thống tự động tiếp nhận & cập nhật đã thanh toán) -->
                            <button type="button"
                                    class="btn btn-warning"
                                    style="width: 100%; font-size: 13px;"
                                    @onclick="() => SimulateQrSuccess(detail)">
                                <Icon Name="check" Size="16" />
                                Mô phỏng khách quét QR thành công
                            </button>
                        </div>
                    }
                }

                <!-- 3. Nút Hoàn thành đơn (khi đang pha chế và đã thanh toán) -->
                @if (detail.Status == "Đang pha chế" && detail.PaymentStatus == "Đã thanh toán")
                {
                    <button type="button"
                            class="btn btn-success btn-large"
                            @onclick="() => CompleteOrder(detail)">
                        <Icon Name="check" Size="18" />
                        Hoàn thành đơn (Đã giao khách)
                    </button>
                }

                <!-- Các nút hành động phụ -->
                <div class="detail-actions" style="margin-top: 6px;">
                    <button type="button"
                            class="btn primary"
                            @onclick="PrintReceipt">
                        <Icon Name="download" Size="16" />
                        In hóa đơn
                    </button>

                    <button type="button"
                            class="btn outline"
                            @onclick="() => selected = null">
                        Đóng chi tiết
                    </button>
                </div>

            </div>

        </aside>
    }

</div>

<!-- ========================================================================= -->
<!-- MODAL THÊM / SỬA ĐƠN HÀNG (CRUD) -->
<!-- ========================================================================= -->
@if (isOrderModalOpen)
{
    <Modal Title="@(isEditing ? $"Sửa đơn hàng #{draftOrder.Code}" : "Tạo đơn hàng mới tại quầy")"
           OnClose="CloseOrderModal">

        <div class="order-modal-builder">

            <!-- Thông tin đơn -->
            <div class="form-grid">
                <div class="field">
                    <label for="order-table">Bàn / Vị trí phục vụ *</label>
                    <select id="order-table" @bind="draftOrder.TableOrArea">
                        <option>Mang đi</option>
                        <option>Bàn 01</option>
                        <option>Bàn 02</option>
                        <option>Bàn 03</option>
                        <option>Bàn 04</option>
                        <option>Bàn 05</option>
                        <option>Bàn 06 (Sân vườn)</option>
                        <option>Bàn 07 (Tầng 2)</option>
                    </select>
                </div>

                <div class="field">
                    <label for="order-payment">Hình thức thanh toán *</label>
                    <select id="order-payment" @bind="draftOrder.PaymentMethod">
                        <option>Tiền mặt</option>
                        <option>Chuyển khoản QR</option>
                    </select>
                </div>

                <div class="field">
                    <label for="order-cashier">Thu ngân phụ trách</label>
                    <input id="order-cashier" @bind="draftOrder.CashierName" placeholder="Tên thu ngân" />
                </div>

                <div class="field">
                    <label for="order-discount">Giảm giá / Ưu đãi (đ)</label>
                    <input id="order-discount" type="number" min="0" step="1000" @bind="draftOrder.DiscountAmount" placeholder="0" />
                </div>

                <div class="field" style="grid-column: 1 / -1;">
                    <label for="order-note">Ghi chú đơn hàng</label>
                    <input id="order-note" @bind="draftOrder.Note" placeholder="Ví dụ: Khách vội, ít đá..." />
                </div>
            </div>

            <!-- Bộ công cụ thêm món vào đơn (Item Builder) -->
            <div class="item-builder-card">
                <strong style="color: var(--brown); font-size: 13px;">Thêm món & Topping vào đơn</strong>

                <div class="form-grid" style="margin-bottom: 8px;">
                    <div class="field">
                        <label for="builder-product">Chọn món</label>
                        <select id="builder-product" @bind="builderProductCode" @bind:after="OnBuilderProductChanged">
                            @foreach (var prod in availableProducts)
                            {
                                <option value="@prod.Code">@prod.Name (@Money(prod.Price ?? 0))</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="builder-size">Kích cỡ</label>
                        <select id="builder-size" @bind="builderSizeCode" @bind:after="OnBuilderSizeChanged">
                            @foreach (var s in availableSizes)
                            {
                                <option value="@s.Code">@s.Name (+@Money(s.ExtraPrice))</option>
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label for="builder-quantity">Số lượng</label>
                        <input id="builder-quantity" type="number" min="1" max="99" @bind="builderQuantity" />
                    </div>

                    <div class="field">
                        <label for="builder-note">Ghi chú món</label>
                        <input id="builder-note" @bind="builderNote" placeholder="70% đường, ít đá..." />
                    </div>
                </div>

                <!-- Chọn Topping -->
                <div>
                    <label style="font-size: 12px; font-weight: 600; display: block; margin-bottom: 6px;">Chọn Topping thêm kèm món này:</label>
                    <div class="toppings-picker-grid">
                        @foreach (var top in availableToppings)
                        {
                            <label class="topping-checkbox-item">
                                <input type="checkbox"
                                       checked="@selectedToppingCodes.Contains(top.Code)"
                                       @onchange="e => ToggleToppingInBuilder(top.Code, e)" />
                                <span>@top.Name (+@Money(top.ExtraPrice))</span>
                            </label>
                        }
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; margin-top: 6px;">
                    <button type="button" class="btn outline" @onclick="AddItemToDraftOrder">
                        <Icon Name="plus" Size="14" />
                        Thêm món này vào danh sách
                    </button>
                </div>
            </div>

            <!-- Bảng danh sách món trong đơn đang tạo/sửa -->
            <div>
                <strong style="font-size: 13px; color: var(--ink);">Các món trong đơn (@draftOrder.Items.Count món):</strong>

                <div class="table-wrap builder-items-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Tên món & Size</th>
                                <th>Topping thêm</th>
                                <th>Đơn giá</th>
                                <th>SL</th>
                                <th>Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in draftOrder.Items)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.ProductName</strong>
                                        <div style="font-size: 11px; color: var(--muted);">@item.SizeName</div>
                                    </td>
                                    <td>
                                        @if (item.Toppings != null && item.Toppings.Count > 0)
                                        {
                                            @string.Join(", ", item.Toppings.Select(t => t.ToppingName))
                                        }
                                        else
                                        {
                                            <span style="color: #999; font-style: italic;">Không</span>
                                        }
                                    </td>
                                    <td>@Money(item.UnitPrice)</td>
                                    <td><strong>@item.Quantity</strong></td>
                                    <td><strong class="text-accent">@Money(item.TotalPrice)</strong></td>
                                    <td>
                                        <button type="button" class="icon-button" aria-label="Bỏ @item.ProductName khỏi đơn" @onclick="() => draftOrder.Items.Remove(item)">
                                            <Icon Name="close" Size="14" />
                                        </button>
                                    </td>
                                </tr>
                            }

                            @if (draftOrder.Items.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" style="text-align: center; color: #999; padding: 18px;">
                                        Chưa có món nào. Vui lòng chọn món và bấm 'Thêm món này vào danh sách'.
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" style="text-align: right; font-weight: 700;">Tổng cộng đơn hàng:</td>
                                <td colspan="2"><strong class="grand-total small">@Money(draftOrder.Total)</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

        </div>

        @if (orderModalError is not null)
        {
            <p class="alert error modal-error" role="alert">@orderModalError</p>
        }

        <div class="modal-footer">
            <button type="button" class="btn outline" @onclick="CloseOrderModal">Hủy</button>
            <button type="button" class="btn primary" @onclick="SaveDraftOrder">
                @(isEditing ? "Lưu thay đổi" : "Tạo đơn hàng")
            </button>
        </div>

    </Modal>
}

<!-- ========================================================================= -->
<!-- MODAL XÁC NHẬN HỦY / XÓA ĐƠN HÀNG -->
<!-- ========================================================================= -->
@if (isDeleteModalOpen && SelectedOrderDetail != null)
{
    <Modal Title="Xác nhận hủy đơn hàng" OnClose="() => isDeleteModalOpen = false">
        <p>
            Bạn có chắc chắn muốn hủy đơn hàng <strong>#@SelectedOrderDetail.Code</strong> (@SelectedOrderDetail.TableOrArea - Tổng tiền @Money(SelectedOrderDetail.Total))?
        </p>
        <p class="form-note">
            Thao tác này sẽ chuyển trạng thái đơn hàng sang 'Đã hủy'. Lịch sử đơn hàng vẫn được lưu trữ phục vụ đối soát.
        </p>

        <div class="modal-footer">
            <button type="button" class="btn outline" @onclick="() => isDeleteModalOpen = false">Đóng</button>
            <button type="button" class="btn danger" @onclick="ConfirmCancelOrder">Xác nhận hủy đơn</button>
        </div>
    </Modal>
}

