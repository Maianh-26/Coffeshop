@page "/orders"
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@inject OrderService OrderApi
@inject ProductService ProductApi
@inject ToppingService ToppingApi
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IServiceProvider Services
@inject ILogger<Orders> Logger

<PageTitle>Đơn hàng - Coffee Shop</PageTitle>

<!-- Thông báo đơn mới từ Tablet: riêng với thông báo thao tác để không đè nhau. Có nút Xem mở ngay chi tiết đơn. -->
<div aria-live="polite">
    @if (!newBannerHidden && UnseenNewOrders is { Count: > 0 } unseen)
    {
        var first = unseen[0];
        <div class="alert new-order-alert orders-alert alert-dismissible">
            <div class="new-order-text">
                <Icon Name="orders" Size="18" />
                @if (unseen.Count == 1)
                {
                    <span>
                        <strong>Đơn mới #@first.MaDonHang</strong> từ Tablet, @first.SoPhan phần, @Money(first.TongTien)
                    </span>
                }
                else
                {
                    <span><strong>Có @unseen.Count đơn mới</strong> từ Tablet chưa xem</span>
                }
            </div>

            <div class="new-order-actions">
                <button type="button"
                        class="btn primary btn-compact"
                        aria-label="Xem đơn #@first.MaDonHang"
                        @onclick="() => OpenFromBanner(first.MaDonHang)">
                    <Icon Name="eye" Size="14" />
                    @(unseen.Count == 1 ? "Xem" : $"Xem đơn đầu tiên (#{first.MaDonHang})")
                </button>

                <button type="button" class="icon-button" aria-label="Ẩn thông báo đơn mới" @onclick="() => newBannerHidden = true">
                    <Icon Name="close" Size="14" />
                </button>
            </div>
        </div>
    }
</div>

<!-- Thông báo kết quả thao tác: nổi ở góc màn hình, hiện / tự ẩn không làm bảng và khung chi tiết nhảy lên xuống -->
<div class="orders-toasts" aria-live="polite">

<!-- Banner thông báo kết quả thao tác -->
@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="alert @alertType orders-alert alert-dismissible @(stockWarnings.Count > 0 ? "has-stock-warning" : "")"
         role="@(alertType == "error" ? "alert" : "status")">
        <div>
            <span>@alertMessage</span>

            @if (stockWarnings.Count > 0)
            {
                <ul class="alert-list">
                    @foreach (var w in stockWarnings)
                    {
                        <li>@w.TenNguyenLieu chỉ còn @Number(w.SoLuongTon) @w.DonViTinh (mức cảnh báo @Number(w.MucCanhBaoToiThieu))</li>
                    }
                </ul>
            }
        </div>

        <button type="button" class="icon-button" aria-label="Đóng thông báo" @onclick="ClearAlert">
            <Icon Name="close" Size="14" />
        </button>
    </div>
}

</div>

<div class="orders-page master-detail-layout @(SelectedOrder != null ? "has-detail" : "")">

    <!-- Cột trái: Bộ lọc, Thanh tác vụ và Danh sách đơn hàng -->
    <div class="master-panel">

        <section class="panel orders-toolbar">

            <div class="filter-row">

                <div class="search-field">

                    <Icon Name="search" />

                    @* Chỉ tìm theo cột đang hiển thị: mã đơn hoặc số nhận món (chỉ nhận chữ số) *@
                    <input value="@search"
                           @oninput="OnSearchInput"
                           inputmode="numeric"
                           maxlength="10"
                           placeholder="Tìm mã đơn hoặc số nhận món…"
                           aria-label="Tìm trong trang hiện tại theo mã đơn hoặc số nhận món (chỉ nhập số)" />

                </div>

                <button type="button"
                        class="btn outline filters-toggle"
                        aria-expanded="@(filtersOpen ? "true" : "false")"
                        aria-controls="order-filters"
                        @onclick="() => filtersOpen = !filtersOpen">
                    <Icon Name="filter" />
                    Bộ lọc@(ActiveFilterCount > 0 ? $" ({ActiveFilterCount})" : "")
                </button>

                <div id="order-filters" class="filter-extra @(filtersOpen ? "open" : "")">

                <div class="date-range">

                    <input type="date"
                           aria-label="Từ ngày"
                           @bind="fromDate"
                           @bind:after="ApplyFilter" />

                    <span>–</span>

                    <input type="date"
                           aria-label="Đến ngày"
                           @bind="toDate"
                           @bind:after="ApplyFilter" />

                </div>

                <select aria-label="Lọc trạng thái phục vụ" @bind="statusFilter" @bind:after="ApplyFilter">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var s in ServingFilters)
                    {
                        <option value="@s" disabled="@(!servingSupported && s != TrangThaiPhucVus.CancelledFilter)">@TrangThaiPhucVus.Label(s)</option>
                    }
                </select>

                <select aria-label="Lọc thanh toán"
                        @bind="paymentFilter"
                        @bind:after="ApplyFilter"
                        disabled="@(statusFilter == TrangThaiPhucVus.CancelledFilter)"
                        title="@(statusFilter == TrangThaiPhucVus.CancelledFilter ? "Đơn đã hủy không lọc theo thanh toán" : null)">
                    <option value="">Tất cả thanh toán</option>
                    <option value="@TrangThaiDon.Pending">@TrangThaiDon.Label(TrangThaiDon.Pending)</option>
                    <option value="@TrangThaiDon.Paid">@TrangThaiDon.Label(TrangThaiDon.Paid)</option>
                </select>

                </div>

                @if (FiltersActive)
                {
                    <button type="button" class="text-button clear-filters" @onclick="Reset">
                        Xóa lọc
                    </button>
                }

            </div>

            <!-- Thao tác: Tạo đơn tại quầy và tự động làm mới -->
            <div class="action-bar action-bar-split toolbar-actions">

            <div class="action-group">

                <button class="btn primary"
                        @onclick="OpenCreateOrder">

                    <Icon Name="plus" />
                    Tạo đơn tại quầy

                </button>

                <button class="btn outline"
                        disabled="@(SelectedOrder is not { CoTheSua: true })"
                        title="@(SelectedOrder is { CoTheSua: false } ? "Chỉ sửa được đơn chưa thanh toán và chưa phục vụ" : "Sửa món trong đơn đang chọn")"
                        @onclick="OpenEditOrder">

                    <Icon Name="edit" />
                    Sửa đơn

                </button>

                @if (IsAdmin)
                {
                    <button class="btn danger-outline"
                            @ref="cancelButtonRef"
                            disabled="@(SelectedOrder is not { TrangThaiThanhToan: not TrangThaiDon.Cancelled })"
                            @onclick="OpenCancelOrder">

                        <Icon Name="trash" />
                        Hủy đơn

                    </button>
                }

            </div>

            <!-- Tự động tải lại danh sách để thấy đơn mới từ Tablet -->
            <div class="realtime-controls">

                <button type="button"
                        class="live-toggle @(!autoRefreshEnabled ? "paused" : "")"
                        @onclick="ToggleAutoRefresh"
                        aria-pressed="@(autoRefreshEnabled ? "true" : "false")"
                        title="Bật/Tắt tự động tải đơn mới từ Tablet (mỗi @RefreshSeconds giây)">

                    <span class="live-indicator" aria-hidden="true"></span>
                    <span>Tự cập nhật</span>

                </button>

                @* Công cụ thử nghiệm — chỉ hiện khi chạy với dữ liệu giả *@
                @if (IsMock)
                {
                    <button type="button"
                            class="text-button"
                            disabled="@loading"
                            @onclick="SimulateTabletOrder"
                            title="Chỉ có ở chế độ dữ liệu giả">
                        Mô phỏng đơn từ Tablet
                    </button>
                }

            </div>

            </div>

        </section>

        @if (loadError is not null)
        {
            <p class="alert error" role="alert">
                @loadError
                <button type="button" class="text-button" @onclick="() => LoadOrders()">Thử lại</button>
            </p>
        }

        <!-- Danh sách đơn hàng -->
        <section class="panel list-panel">

            <div class="table-wrap">

                <table class="orders-table">

                    <thead>

                        <tr>
                            <th>Mã đơn</th>
                            <th><span class="label-long">Số nhận món</span><span class="label-short" aria-hidden="true">Số</span></th>
                            <th>Trạng thái</th>
                            <th class="num">Tổng tiền</th>
                            <th>Thanh toán</th>
                            <th>Nguồn</th>
                            <th>Thời gian tạo</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var order in VisibleOrders)
                        {
                            bool isNew = newOrderIds.Contains(order.MaDonHang);

                            <tr class="selectable @(selectedId == order.MaDonHang ? "selected" : "") @(isNew ? "is-new" : "")"
                                @ref="rowRefs[order.MaDonHang]"
                                tabindex="0"
                                @onclick="() => SelectOrder(order.MaDonHang)"
                                @onkeydown="e => SelectKey(e, order.MaDonHang)">

                                <td>
                                    <strong class="order-id">#@order.MaDonHang</strong>
                                    @if (isNew)
                                    {
                                        <span class="new-mark" title="Đơn mới từ Tablet, chưa mở xem">Mới</span>
                                    }
                                </td>

                                <td>
                                    @if (order.SoNhanMon is { } so)
                                    {
                                        <span class="pickup-number">@so</span>
                                    }
                                    else
                                    {
                                        <span class="muted label-long">Chưa nhập</span>
                                        <span class="muted label-short" aria-hidden="true">—</span>
                                    }
                                </td>

                                <td>
                                    @if (servingSupported || order.DaHuy)
                                    {
                                        <span class="status status-@TrangThaiPhucVus.Tone(order)">@TrangThaiPhucVus.Label(order)</span>
                                    }
                                    else
                                    {
                                        <span class="muted" title="Máy chủ chưa có trạng thái phục vụ">—</span>
                                    }
                                </td>

                                <td class="num">
                                    <strong>@Money(order.TongTien)</strong>
                                </td>

                                <td>
                                    <span class="status status-@PhuongThucThanhToans.Tone(order)">@PhuongThucThanhToans.ShortLabel(order)</span>
                                    @if (PhuongThucThanhToans.Tone(order) != "void")
                                    {
                                        <span class="muted pay-method">@PhuongThucThanhToans.Label(order.PhuongThucThanhToan)</span>
                                    }
                                    <span class="pay-amount">@Money(order.TongTien)</span>
                                </td>

                                <td class="muted">@order.Nguon</td>

                                <td class="muted">@order.ThoiGianTao.ToString("HH:mm, dd/MM")</td>

                            </tr>
                        }

                        @if (VisibleOrders.Count == 0)
                        {
                            <tr>

                                <td class="empty-cell" colspan="7">

                                    <Icon Name="orders" Size="32" />

                                    <p>
                                        @(loading && orders.Count == 0
                                            ? "Đang tải đơn hàng…"
                                            : "Không tìm thấy đơn hàng nào phù hợp với bộ lọc.")
                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="list-footer">

                <span>
                    @totalOrders đơn hàng@(SelectedOrder == null ? ", nhấp vào một đơn để xem chi tiết" : "")
                    <span class="page-of">Trang @(page)/@totalPages</span>
                </span>

                <div class="pagination">

                    <button class="page-button"
                            aria-label="Trang trước"
                            disabled="@(page <= 1 || loading)"
                            @onclick="() => Move(-1)">

                        <Icon Name="left" Size="16" />

                    </button>

                    <span class="page-number">
                        @(page)
                    </span>

                    <button class="page-button"
                            aria-label="Trang sau"
                            disabled="@(page >= totalPages || loading)"
                            @onclick="() => Move(1)">

                        <Icon Name="right" Size="16" />

                    </button>

                </div>

            </div>

        </section>

    </div>

    <!-- Cột phải: chi tiết đơn hàng (chỉ hiển thị khi đã chọn 1 đơn) -->
    @if (SelectedOrder is { } detail)
    {
        <aside class="detail-panel panel">

            <div class="order-detail-header">
                <div>
                    <h3 tabindex="-1" class="detail-heading" @ref="detailHeading">Đơn hàng #@detail.MaDonHang</h3>
                    <div class="order-badges">
                        @if (servingSupported || detail.DaHuy)
                        {
                            <span class="status status-@TrangThaiPhucVus.Tone(detail)">@TrangThaiPhucVus.Label(detail)</span>
                        }
                        <span class="status status-@PhuongThucThanhToans.Tone(detail)">@PhuongThucThanhToans.ShortLabel(detail)</span>
                    </div>
                </div>

                <button type="button"
                        class="icon-button"
                        aria-label="Đóng chi tiết"
                        title="Đóng khung chi tiết"
                        @onclick="CloseDetail">
                    <Icon Name="close" Size="20" />
                </button>
            </div>

            <!-- Thông tin tổng quan đơn hàng -->
            @if (!orders.Any(o => o.MaDonHang == detail.MaDonHang))
            {
                <p class="form-note">Đơn này không nằm trong danh sách đang hiển thị (trang hoặc bộ lọc khác).</p>
            }

            <dl class="order-facts">
                <div>
                    <dt>Tạo lúc</dt>
                    <dd>@detail.ThoiGianTao.ToString("HH:mm, dd/MM/yyyy")</dd>
                </div>
                <div>
                    <dt>Nguồn</dt>
                    <dd>@(detail.TenNhanVien is { } staff ? $"Tại quầy, {staff}" : "Khách đặt trên Tablet")</dd>
                </div>
                <div>
                    <dt>Thanh toán</dt>
                    <dd>@PhuongThucThanhToans.Summary(detail)</dd>
                </div>
                @if (detail.LyDoHuy is not null)
                {
                    <div>
                        <dt>Lý do hủy</dt>
                        <dd class="text-danger">@detail.LyDoHuy</dd>
                    </div>
                }
                @if (detail.GioHoanTien.HasValue)
                {
                    <div>
                        <dt>Hoàn tiền lúc</dt>
                        <dd>@detail.GioHoanTien.Value.ToString("HH:mm, dd/MM/yyyy")</dd>
                    </div>
                }
            </dl>

            <!-- Phiếu order: món, số lượng, giá thẳng cột như tờ phiếu ở quầy -->
            <section class="order-ticket" aria-labelledby="ticket-title">
                <h4 id="ticket-title">Món đã đặt <span class="muted">(@detail.SoPhan phần)</span></h4>

                <ul class="ticket-lines">
                    @foreach (var item in detail.ChiTiet ?? [])
                    {
                        <li>
                            <div class="ticket-row">
                                <span class="ticket-qty">@item.SoLuong ×</span>
                                <span class="ticket-name">@item.TenMonLuu</span>
                                <span class="num">@Money(item.DonGiaBan * item.SoLuong)</span>
                            </div>

                            @foreach (var top in item.Toppings)
                            {
                                <div class="ticket-row ticket-sub">
                                    <span class="ticket-qty"></span>
                                    <span class="ticket-name">+ @top.TenToppingLuu</span>
                                    <span class="num">@Money(top.DonGiaTopping * item.SoLuong)</span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.GhiChu))
                            {
                                <div class="ticket-note">Ghi chú: @item.GhiChu</div>
                            }
                        </li>
                    }
                </ul>

                <div class="ticket-total">
                    <span>Tổng tiền</span>
                    <span class="num">@Money(detail.TongTien)</span>
                </div>
            </section>

            <!-- NGHIỆP VỤ: SỐ NHẬN MÓN & PHỤC VỤ -->
            @if (!servingSupported)
            {
                <p class="form-note serving-box">
                    Số nhận món và trạng thái phục vụ chưa dùng được: máy chủ chưa hỗ trợ (đã đề xuất với nhóm backend).
                </p>
            }
            else
            {
            <div class="serving-box">
                <div class="field">
                    <label for="pickup-number">Số nhận món (bảng gỗ @SoNhanMons.Min–@SoNhanMons.Max)</label>

                    @if (detail.DangPhucVu)
                    {
                        <div class="pickup-input-row">
                            <input id="pickup-number"
                                   type="number"
                                   inputmode="numeric"
                                   min="@SoNhanMons.Min"
                                   max="@SoNhanMons.Max"
                                   placeholder="Nhập số"
                                   aria-describedby="@(servingError is null ? null : "serving-error")"
                                   aria-invalid="@(servingError is null ? null : "true")"
                                   class="@(servingError is null ? null : "input-error")"
                                   @ref="pickupInputRef"
                                   value="@pickupInput"
                                   @oninput="OnPickupInput"
                                   @onkeydown="PickupKeyDown"
                                   disabled="@servingBusy" />

                            <button type="button"
                                    class="btn outline"
                                    disabled="@(servingBusy || pickupInput == detail.SoNhanMon)"
                                    @onclick="() => SavePickupNumber(detail)">
                                @(detail.SoNhanMon is null ? "Lưu số" : "Đổi số")
                            </button>
                        </div>

                        @if (servingError is not null)
                        {
                            <p id="serving-error" class="alert error" role="alert">@servingError</p>
                        }

                    }
                    else
                    {
                        <p class="pickup-readonly">
                            @if (detail.SoNhanMon is { } so)
                            {
                                <span class="pickup-number">@so</span>
                                <span class="muted">@(detail.DaHuy ? "Đơn đã hủy, số đã được giải phóng." : "Đã phục vụ, số đã được giải phóng.")</span>
                            }
                            else
                            {
                                <span class="muted">Không nhập số nhận món.</span>
                            }
                        </p>
                    }
                </div>

                @if (confirmNoPickupId == detail.MaDonHang
                     && detail.PhucVu == TrangThaiPhucVus.Waiting && !detail.DaHuy && detail.SoNhanMon is null)
                {
                    @* Bắt đầu chuẩn bị khi chưa có số: người mang món ra sẽ không biết đưa tới bàn nào → hỏi lại *@
                    <div class="confirm-inline" role="alertdialog" aria-labelledby="no-pickup-msg"
                         @onkeydown="CloseConfirmOnEscape">
                        <p id="no-pickup-msg">
                            Đơn <strong>#@detail.MaDonHang</strong> <strong>chưa có số nhận món</strong>, người phục vụ sẽ không biết mang món tới bàn nào.
                        </p>
                        <div class="serving-actions">
                            <button type="button" class="btn primary" disabled="@servingBusy" @onclick="FocusPickupInput"
                                    @ref="confirmFirstButton">
                                Nhập số nhận món
                            </button>
                            <button type="button" class="btn outline" disabled="@servingBusy"
                                    @onclick="() => SetServing(detail, TrangThaiPhucVus.Preparing, confirmed: true)">
                                Vẫn bắt đầu (khách mang đi)
                            </button>
                        </div>
                    </div>
                }
                else if (confirmServeUnpaidId == detail.MaDonHang && detail.DangPhucVu
                         && detail.TrangThaiThanhToan == TrangThaiDon.Pending)
                {
                    @* Phục vụ khi chưa thu tiền là thao tác không hoàn tác (giải phóng số) → hỏi lại *@
                    <div class="confirm-inline" role="alertdialog" aria-labelledby="serve-unpaid-msg"
                         @onkeydown="CloseConfirmOnEscape">
                        <p id="serve-unpaid-msg">
                            Đơn <strong>#@detail.MaDonHang</strong> <strong>chưa thanh toán</strong>. Vẫn xác nhận đã phục vụ?
                            @(detail.SoNhanMon is { } holding ? $" Số {holding} sẽ được giải phóng." : "")
                        </p>
                        <div class="serving-actions">
                            <button type="button" class="btn btn-act-pay" disabled="@servingBusy" @onclick="FocusPayButton"
                                    @ref="confirmFirstButton">
                                Thu tiền trước
                            </button>
                            <button type="button" class="btn outline" disabled="@servingBusy"
                                    @onclick="() => SetServing(detail, TrangThaiPhucVus.Served, confirmed: true)">
                                Vẫn xác nhận đã phục vụ
                            </button>
                        </div>
                    </div>
                }
                else if (detail.DangPhucVu)
                {
                    @* Đi lần lượt từng bước, không bỏ qua: Chờ phục vụ → Đang chuẩn bị → Đã phục vụ.
                       Mỗi lúc chỉ có MỘT nút cho bước kế tiếp. *@
                    <ol class="serving-steps" aria-label="Tiến trình phục vụ">
                        @foreach (var step in ServingSteps)
                        {
                            int current = Array.IndexOf(ServingSteps, detail.PhucVu);
                            int index = Array.IndexOf(ServingSteps, step);
                            <li class="@(index < current ? "done" : index == current ? $"current step-{step.ToLowerInvariant()}" : "")"
                                aria-current="@(index == current ? "step" : null)">
                                @TrangThaiPhucVus.Label(step)
                            </li>
                        }
                    </ol>

                    <div class="serving-actions">
                        @if (detail.PhucVu == TrangThaiPhucVus.Waiting)
                        {
                            <button type="button"
                                    class="btn btn-act-prepare"
                                    disabled="@servingBusy"
                                    @onclick="() => SetServing(detail, TrangThaiPhucVus.Preparing)">
                                <Icon Name="cup" Size="16" />
                                Bắt đầu chuẩn bị
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-act-serve"
                                    disabled="@servingBusy"
                                    @onclick="() => SetServing(detail, TrangThaiPhucVus.Served)">
                                <Icon Name="check" Size="16" />
                                Xác nhận đã phục vụ
                            </button>
                        }
                    </div>
                }

                @if (servingError is not null && !detail.DangPhucVu)
                {
                    <p class="alert error" role="alert">@servingError</p>
                }
            </div>
            }

            <!-- NGHIỆP VỤ: THANH TOÁN -->
            <div class="order-action-group">

                @if (detail.TrangThaiThanhToan == TrangThaiDon.Pending)
                {
                    @* Đơn giản hóa: không nhập "tiền khách đưa" — nhân viên chỉ xác nhận đã thu đủ.
                       Khách chuyển khoản trên tablet → cổng thanh toán báo về, đơn tự sang PAID ("Đã thu"). *@
                    <div class="pay-box">
                        <div class="pay-box-head">
                            <span>Cần thu (@PhuongThucThanhToans.Label(payMethod))</span>
                            <strong class="grand-total small">@Money(detail.TongTien)</strong>
                        </div>

                        @if (payMethod == PhuongThucThanhToans.QrTransfer)
                        {
                            <p class="form-note">
                                Khách chuyển khoản trên tablet: hệ thống tự cập nhật "@TrangThaiDon.Label(TrangThaiDon.Paid)" khi nhận được tiền.
                                Chỉ bấm xác nhận khi đã kiểm tra tài khoản nhận được tiền (nội dung: <strong>COFFEE @detail.MaDonHang</strong>).
                            </p>
                        }

                        <button type="button"
                                class="btn btn-act-pay btn-large"
                                disabled="@paying"
                                @ref="payButtonRef"
                                @onclick="() => Pay(detail)">
                            <Icon Name="@(payMethod == PhuongThucThanhToans.Cash ? "coins" : "check")" Size="18" />
                            @(paying
                                ? "Đang xác nhận…"
                                : payMethod == PhuongThucThanhToans.Cash ? "Xác nhận đã thu tiền mặt" : "Xác nhận đã nhận chuyển khoản")
                        </button>

                        <button type="button"
                                class="text-button switch-pay"
                                disabled="@paying"
                                @onclick="SwitchPayMethod">
                            Khách đổi sang @(payMethod == PhuongThucThanhToans.Cash
                                ? PhuongThucThanhToans.Label(PhuongThucThanhToans.QrTransfer).ToLowerInvariant()
                                : PhuongThucThanhToans.Label(PhuongThucThanhToans.Cash).ToLowerInvariant())
                        </button>
                    </div>

                    @if (payError is not null)
                    {
                        <p class="alert error" role="alert">@payError</p>
                    }
                }

                <!-- Các nút hành động phụ -->
                <div class="detail-actions">
                    <button type="button"
                            class="btn outline"
                            disabled="@detail.DaHuy"
                            title="@(detail.DaHuy ? "Đơn đã hủy, không in hóa đơn" : "In hóa đơn cho khách")"
                            @onclick="PrintReceipt">
                        <Icon Name="printer" Size="16" />
                        In hóa đơn
                    </button>

                </div>

            </div>

        </aside>
    }

</div>

