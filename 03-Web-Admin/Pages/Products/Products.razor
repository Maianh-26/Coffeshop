@page "/products"
@attribute [Authorize(Roles = Roles.Admin)]

<PageTitle>Món - Coffee Shop</PageTitle>

<div class="products-page">

    <section class="panel filters-panel">

        <div class="tabs">

            <button class="tab @(ProductTab ? "active" : "")" aria-pressed="@(ProductTab ? "true" : "false")"
                    @onclick='() => SwitchTab("products")'>
                <Icon Name="cup" />
                Món
            </button>

            <button class="tab @(CategoryTab ? "active" : "")" aria-pressed="@(CategoryTab ? "true" : "false")"
                    @onclick='() => SwitchTab("categories")'>
                <Icon Name="grid" />
                Danh mục
            </button>

            <button class="tab @(ToppingTab ? "active" : "")" aria-pressed="@(ToppingTab ? "true" : "false")"
                    @onclick='() => SwitchTab("toppings")'>
                <Icon Name="recipe" />
                Topping
            </button>

        </div>

        @* Bộ lọc đồng bộ với trang Đơn hàng / Kho: màn hình rộng hiện đủ; màn hình hẹp gom vào nút "Bộ lọc (n)".
           Nút Làm mới (biểu tượng) bỏ mọi bộ lọc / tìm kiếm / sắp xếp của tab đang xem, về trang 1 và tải lại; có chấm khi đang lọc. *@
        <div class="filter-row @(HasFilters ? "" : "no-filters")">

            <div class="search-field">

                <Icon Name="search" />

                <input @bind="search"
                       @bind:event="oninput"
                       @bind:after="Filter"
                       maxlength="100"
                       placeholder="@SearchPlaceholder"
                       aria-label="@($"Tìm {TabNoun} theo tên hoặc mã")" />

            </div>

            @if (HasFilters)
            {
                <button type="button"
                        class="btn outline filters-toggle"
                        aria-expanded="@(filtersOpen ? "true" : "false")"
                        aria-controls="product-filters"
                        @onclick="() => filtersOpen = !filtersOpen">
                    <Icon Name="filter" />
                    Bộ lọc@(ActiveFilterCount > 0 ? $" ({ActiveFilterCount})" : "")
                </button>
            }

            <RefreshButton Active="FiltersActive" Spinning="refreshing" Title="@RefreshTitle" OnClick="RefreshAll" />

            @if (HasFilters)
            {
                <div id="product-filters" class="filter-extra @(filtersOpen ? "open" : "")">

                    @* Màn hình hẹp: xuống hàng sau nút Bộ lọc + Làm mới, các ô lọc chia đôi hàng dưới (như trang Kho) *@
                    <span class="filter-break" aria-hidden="true"></span>

                    @if (ProductTab)
                    {
                        <select class="filter-half" aria-label="Lọc danh mục" @bind="categoryFilter" @bind:after="Filter">
                            <option value="">Tất cả danh mục</option>
                            @foreach (var item in categories)
                            {
                                <option value="@item.MaDanhMuc">@item.TenDanhMuc</option>
                            }
                        </select>
                    }

                    <select class="filter-half" aria-label="Lọc trạng thái" @bind="statusFilter" @bind:after="Filter">
                        <option value="">Tất cả trạng thái</option>
                        @foreach (var status in TrangThaiMon.Options)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>

                </div>
            }

        </div>

    </section>

    @* Thanh thao tác chung: Thêm · Sửa · Xóa, sau đó nút riêng của trang (Công thức) *@
    <CrudActions AddLabel="@(ToppingTab ? "Thêm topping" : CategoryTab ? "Thêm danh mục" : "Thêm món")"
                 ItemName="@TabNoun"
                 HasSelection="HasSelection"
                 DeleteBlockedReason="@DeleteBlockedReason"
                 OnAdd="Add"
                 OnEdit="Edit"
                 OnDelete="AskDelete">
        @if (ProductTab || ToppingTab)
        {
            <button type="button" class="btn outline" @onclick="OpenRecipe">
                <Icon Name="recipe" />
                Công thức
            </button>
        }
    </CrudActions>

    @if (message is not null)
    {
        <p class="alert success" role="status">
            @message
        </p>
    }

    @if (loadError is not null)
    {
        <p class="alert error" role="alert">
            @loadError
            <button type="button" class="text-button" @onclick="Load">Thử lại</button>
        </p>
    }

    <section class="panel list-panel">

        <div class="table-wrap">

            @* menu-table: ẩn / gộp cột phụ của bảng món trên màn hình hẹp (CSS mục [12]) *@
            <table class="products-table @(ProductTab ? "menu-table" : "")">

                <thead>

                    @if (ToppingTab)
                    {
                        <tr>
                            <SortHeader Sort="sort" Key="@SortId" Label="Mã" Name="mã" OnSort="ToggleSort" />
                            <th>Tên topping</th>
                            <SortHeader Sort="sort" Key="@SortPrice" Label="Giá thêm" Name="giá thêm" OnSort="ToggleSort" />
                            <th>Trạng thái</th>
                        </tr>
                    }
                    else if (CategoryTab)
                    {
                        <tr>
                            <SortHeader Sort="sort" Key="@SortId" Label="Mã danh mục" OnSort="ToggleSort" />
                            <th>Tên danh mục</th>
                            <th>Số món đang bán</th>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <SortHeader Sort="sort" Key="@SortId" Label="Mã món" Name="mã món" OnSort="ToggleSort" />
                            <th>Ảnh</th>
                            <th>Tên món</th>
                            <th>Danh mục</th>
                            @* Giá gốc lưu trong CSDL; giá khuyến mãi xem ở trang Khuyến mãi *@
                            <SortHeader Sort="sort" Key="@SortPrice" Label="Giá bán theo size" Name="giá bán" OnSort="ToggleSort" />
                            <th>Trạng thái</th>
                        </tr>
                    }

                </thead>

                <tbody>

                    @if (ToppingTab)
                    {
                        @foreach (var item in Paged(ToppingMatches))
                        {
                            string key = item.MaTopping.ToString();
                            string status = TrangThaiMon.Of(item);

                            <tr class="selectable @(selected == key ? "selected" : "")"
                                tabindex="0"
                                @onkeydown="e => SelectKey(e, key)"
                                @onclick="() => selected = key">

                                <td><strong>@item.MaTopping</strong></td>
                                <td>@item.TenTopping</td>
                                <td><strong class="text-accent">+@Money(item.GiaThem)</strong></td>
                                <td><span class="badge @TrangThaiMon.Color(status)">@status</span></td>

                            </tr>
                        }
                    }
                    else if (CategoryTab)
                    {
                        @foreach (var item in Paged(CategoryMatches))
                        {
                            string key = item.MaDanhMuc.ToString();

                            <tr class="selectable @(selected == key ? "selected" : "")"
                                tabindex="0"
                                @onkeydown="e => SelectKey(e, key)"
                                @onclick="() => selected = key">

                                <td><strong>@item.MaDanhMuc</strong></td>
                                <td>@item.TenDanhMuc</td>
                                <td>@item.SoMon</td>

                            </tr>
                        }
                    }
                    else
                    {
                        @foreach (var item in Paged(ProductMatches))
                        {
                            string key = item.MaTenMon.ToString();
                            string status = TrangThaiMon.Of(item);

                            <tr class="selectable @(selected == key ? "selected" : "")"
                                tabindex="0"
                                @onkeydown="e => SelectKey(e, key)"
                                @onclick="() => selected = key">

                                <td><strong>@item.MaTenMon</strong></td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.HinhAnh))
                                    {
                                        <img class="product-image" src="@item.HinhAnh" alt="@item.TenMon" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="image-placeholder">
                                            <Icon Name="cup" />
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.TenMon
                                    @* Màn hình hẹp: cột Danh mục bị ẩn → hiện gọn dưới tên món *@
                                    <span class="stock-sub">@item.TenDanhMuc</span>
                                </td>
                                <td>@item.TenDanhMuc</td>

                                <td>
                                    <div class="size-prices">
                                        @foreach (var size in ActiveSizes(item))
                                        {
                                            <span class="size-price @(size.DuNguyenLieu ? "" : "is-short")"
                                                  title="@(size.DuNguyenLieu ? "" : "Không đủ nguyên liệu")">
                                                <strong>@size.MaKichThuoc</strong>
                                                @Money(size.GiaBan)
                                            </span>
                                        }

                                        @if (!ActiveSizes(item).Any())
                                        {
                                            <span class="muted">Chưa có giá</span>
                                        }
                                    </div>
                                </td>

                                <td><span class="badge @TrangThaiMon.Color(status)">@status</span></td>

                            </tr>
                        }
                    }

                    @if (Count == 0)
                    {
                        <EmptyRow Columns="@(ToppingTab ? 4 : CategoryTab ? 3 : 6)"
                                  IconName="cup"
                                  Text="@EmptyText"
                                  ShowClear="@(!loading && FiltersActive)"
                                  OnClear="RefreshAll" />
                    }

                </tbody>

            </table>

        </div>

        <div class="list-footer">

            <span>
                @Count @TabNoun
                · Trang @(page)/@Pages
            </span>

            <div class="pagination">

                <button class="page-button"
                        aria-label="Trang trước"
                        disabled="@(page <= 1)"
                        @onclick="() => Move(-1)">
                    <Icon Name="left" Size="16" />
                </button>

                <span class="page-number">
                    @(page)
                </span>

                <button class="page-button"
                        aria-label="Trang sau"
                        disabled="@(page >= Pages)"
                        @onclick="() => Move(1)">
                    <Icon Name="right" Size="16" />
                </button>

            </div>

        </div>

    </section>

</div>

@if (dialog != "")
{
    <Modal Title="@DialogTitle"
           OnClose="Close"
           Busy="@saving">

        @if (dialog == "product")
        {
            <EditForm Model="productModel"
                      OnValidSubmit="SaveProduct"
                      novalidate>

                <DataAnnotationsValidator />

                <div class="form-grid">

                    <div class="field">
                        <label for="p-name">Tên món *</label>
                        <InputText id="p-name"
                                   @bind-Value="productModel.TenMon"
                                   placeholder="Nhập tên món" />
                        <ValidationMessage For="@(() => productModel.TenMon)" />
                    </div>

                    <div class="field">
                        <label for="p-category">Danh mục *</label>
                        <InputSelect id="p-category"
                                     @bind-Value="productModel.MaDanhMuc">
                            <option value="0">Chọn danh mục</option>
                            @foreach (var item in categories)
                            {
                                <option value="@item.MaDanhMuc">@item.TenDanhMuc</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => productModel.MaDanhMuc)" />
                    </div>

                    <div class="field field-wide">
                        <label for="p-image">Ảnh món</label>
                        <InputText id="p-image"
                                   @bind-Value="productModel.HinhAnh"
                                   placeholder="images/mon/bac-xiu.jpg hoặc https://…" />
                        <ValidationMessage For="@(() => productModel.HinhAnh)" />

                        @if (!string.IsNullOrWhiteSpace(productModel.HinhAnh))
                        {
                            <div class="image-preview">
                                <img src="@productModel.HinhAnh" alt="Ảnh xem trước" />
                                <button type="button" class="text-button" @onclick="() => productModel.HinhAnh = null">
                                    Xóa ảnh
                                </button>
                            </div>
                        }
                    </div>

                </div>

                <fieldset class="field">
                    <legend>Giá bán (giá gốc) theo kích thước *</legend>

                    <div class="size-price-editor">
                        @foreach (var price in productModel.Prices)
                        {
                            <div class="size-price-row">
                                <label class="checkbox-line">
                                    <InputCheckbox @bind-Value="price.Ban" />
                                    @price.MaKichThuoc – @price.TenKichThuoc
                                </label>

                                <InputNumber @bind-Value="price.GiaBan"
                                             disabled="@(!price.Ban)"
                                             min="0"
                                             step="1000"
                                             placeholder="Giá (đ)"
                                             aria-label="@($"Giá size {price.MaKichThuoc}")" />
                            </div>
                        }

                        @if (productModel.Prices.Count == 0)
                        {
                            <p class="form-note">Chưa có kích thước nào.</p>
                        }
                    </div>
                </fieldset>

                @* Món mới luôn Đang bán; khi sửa chọn trạng thái ("Hết nguyên liệu" do hệ thống tự tính nên không chọn tay) *@
                @if (editing)
                {
                    @* Ô sổ xuống như trang Kho (Trạng thái nguyên liệu) *@
                    <div class="field">
                        <label for="p-status">Trạng thái</label>
                        <InputSelect id="p-status" @bind-Value="productModel.TrangThai">
                            @foreach (var status in TrangThaiMon.Editable)
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                    </div>
                }

                @if (error is not null)
                {
                    <p class="alert error" role="alert">@error</p>
                }

                <div class="modal-footer">
                    <button type="button" class="btn outline" disabled="@saving" @onclick="Close">Hủy</button>
                    <button type="submit" class="btn primary" disabled="@saving">
                        @(saving ? "Đang lưu…" : editing ? "Lưu thay đổi" : "Thêm món")
                    </button>
                </div>

            </EditForm>
        }

        @if (dialog == "category")
        {
            <EditForm Model="nameModel"
                      OnValidSubmit="SaveCategory">

                <DataAnnotationsValidator />

                <div class="form-stack">
                    <div class="field">
                        <label for="c-name">Tên danh mục *</label>
                        <InputText id="c-name"
                                   @bind-Value="nameModel.Ten"
                                   placeholder="Nhập tên danh mục" />
                        <ValidationMessage For="@(() => nameModel.Ten)" />
                    </div>
                </div>

                @if (error is not null)
                {
                    <p class="alert error" role="alert">@error</p>
                }

                <div class="modal-footer">
                    <button type="button" class="btn outline" disabled="@saving" @onclick="Close">Hủy</button>
                    <button type="submit" class="btn primary" disabled="@saving">
                        @(saving ? "Đang lưu…" : editing ? "Lưu thay đổi" : "Thêm danh mục")
                    </button>
                </div>

            </EditForm>
        }

        @if (dialog == "topping")
        {
            <EditForm Model="toppingModel"
                      OnValidSubmit="SaveTopping"
                      novalidate>

                <DataAnnotationsValidator />

                <div class="form-grid">

                    <div class="field">
                        <label for="t-name">Tên topping *</label>
                        <InputText id="t-name"
                                   @bind-Value="toppingModel.TenTopping"
                                   placeholder="VD: Trân châu đen, Kem cheese…" />
                        <ValidationMessage For="@(() => toppingModel.TenTopping)" />
                    </div>

                    <div class="field">
                        <label for="t-price">Giá thêm (đ) *</label>
                        <InputNumber id="t-price"
                                     @bind-Value="toppingModel.GiaThem"
                                     min="0"
                                     step="1000" />
                        <ValidationMessage For="@(() => toppingModel.GiaThem)" />
                    </div>

                </div>

                @* Topping mới luôn Đang bán; khi sửa chọn trạng thái *@
                @if (editing)
                {
                    @* Ô sổ xuống như trang Kho (Trạng thái nguyên liệu) *@
                    <div class="field">
                        <label for="t-status">Trạng thái</label>
                        <InputSelect id="t-status" @bind-Value="toppingModel.TrangThai">
                            @foreach (var status in TrangThaiMon.Editable)
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                    </div>
                }

                @if (error is not null)
                {
                    <p class="alert error" role="alert">@error</p>
                }

                <div class="modal-footer">
                    <button type="button" class="btn outline" disabled="@saving" @onclick="Close">Hủy</button>
                    <button type="submit" class="btn primary" disabled="@saving">
                        @(saving ? "Đang lưu…" : editing ? "Lưu thay đổi" : "Thêm topping")
                    </button>
                </div>

            </EditForm>
        }

        @if (dialog == "delete")
        {
            <p>Xóa @TabNoun <strong>@SelectedName</strong>?</p>

            @if (error is not null)
            {
                <p class="alert error" role="alert">@error</p>
            }

            <div class="modal-footer">
                <button class="btn outline" disabled="@saving" @onclick="Close">Hủy</button>
                <button class="btn danger" disabled="@saving" @onclick="Delete">
                    @(saving ? "Đang xóa…" : "Xóa")
                </button>
            </div>
        }

        @if (dialog == "recipe")
        {
            <div class="field">
                <label for="recipe-target">
                    @(ToppingTab ? "Topping" : "Món – size")
                </label>

                <select id="recipe-target"
                        value="@recipeOwner"
                        disabled="@(saving || recipeLoading)"
                        @onchange="PickRecipe">
                    <option value="0">Chọn @(ToppingTab ? "topping" : "món – size")</option>
                    @foreach (var (id, label) in RecipeTargets)
                    {
                        <option value="@id">@label</option>
                    }
                </select>
            </div>

            @if (recipeLoading)
            {
                <p class="muted">Đang tải công thức…</p>
            }
            else if (recipeOwner != 0)
            {
                <div class="table-wrap recipe-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Nguyên liệu</th>
                                <th>Định lượng</th>
                                <th>Đơn vị</th>
                                <th><span class="sr-only">Xóa dòng</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in recipe)
                            {
                                <tr @key="line">
                                    <td>
                                        <select aria-label="Nguyên liệu" @bind="line.MaNguyenLieu">
                                            <option value="0">Chọn nguyên liệu</option>
                                            @foreach (var ingredient in ingredients.Where(i => i.DangSuDung || i.MaNguyenLieu == line.MaNguyenLieu))
                                            {
                                                <option value="@ingredient.MaNguyenLieu">@ingredient.TenNguyenLieu@(ingredient.DangSuDung ? "" : " (ngừng sử dụng)")</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number"
                                               aria-label="Định lượng"
                                               @bind="line.LuongSuDung"
                                               min="0.01"
                                               step="0.01" />
                                    </td>
                                    <td>@UnitOf(line.MaNguyenLieu)</td>
                                    <td>
                                        <button type="button" class="icon-button" aria-label="Xóa dòng" @onclick="() => recipe.Remove(line)">
                                            <Icon Name="close" Size="16" />
                                        </button>
                                    </td>
                                </tr>
                            }

                            @if (recipe.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="empty-cell">Chưa có định mức.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Công thức trống: món vẫn bán được (backend coi là đủ nguyên liệu) nhưng thu tiền KHÔNG trừ kho gì *@
                @if (error is null && !recipe.Any(r => r.MaNguyenLieu > 0))
                {
                    <p class="alert yellow" role="status">
                        @(ToppingTab ? "Topping" : "Món – size") này <strong>chưa có định mức</strong>: vẫn bán được nhưng khi thu tiền
                        sẽ <strong>không trừ kho</strong>. Thêm nguyên liệu để tồn kho đúng thực tế.
                    </p>
                }

                @* Nguyên liệu đã ngừng sử dụng vẫn bị trừ kho theo công thức → nhắc thay bằng nguyên liệu đang dùng *@
                @if (StoppedInRecipe is { Count: > 0 } stopped)
                {
                    <p class="alert yellow" role="status">
                        Công thức đang dùng nguyên liệu đã <strong>ngừng sử dụng</strong>: @string.Join(", ", stopped).
                        Kho vẫn bị trừ theo các dòng này — hãy thay bằng nguyên liệu đang dùng hoặc bỏ dòng.
                    </p>
                }

                <button type="button" class="btn outline" @onclick="() => recipe.Add(new())">
                    <Icon Name="plus" Size="16" />
                    Thêm dòng
                </button>
            }

            @if (error is not null)
            {
                <p class="alert error" role="alert">@error</p>
            }

            <div class="modal-footer">
                <button class="btn outline" disabled="@saving" @onclick="Close">Đóng</button>
                <button class="btn primary" disabled="@(saving || recipeLoading || recipeOwner == 0)" @onclick="SaveRecipe">
                    @(saving ? "Đang lưu…" : "Lưu công thức")
                </button>
            </div>
        }

    </Modal>
}
