@page "/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Quên mật khẩu - Coffee Shop</PageTitle>

<div class="auth-card">

    @if (step != Step.Done)
    {
        <p class="auth-step" aria-live="polite">Bước @((int)step + 1)/3</p>
    }

    @switch (step)
    {
        case Step.Email:

            <h1>Quên mật khẩu</h1>

            <p class="auth-intro">
                Nhập email của tài khoản. Hệ thống sẽ gửi mã xác minh gồm 6 chữ số tới email này.
            </p>

            @if (error is not null)
            {
                <p class="alert error" role="alert">@error</p>
            }

            <EditForm Model="emailModel" OnValidSubmit="SendCode" novalidate>

                <DataAnnotationsValidator />

                <div class="form-stack">
                    <div class="field">
                        <label for="reset-email">Email</label>
                        <InputTextLive id="reset-email"
                                   @ref="emailInput"
                                   type="email"
                                   @bind-Value="emailModel.Email"
                                   placeholder="Email đã đăng ký với chủ quán"
                                   autocomplete="email" />
                        <ValidationMessage For="@(() => emailModel.Email)" />
                    </div>
                </div>

                <button type="submit" class="btn primary auth-submit" disabled="@busy">
                    @(busy ? "Đang gửi mã…" : "Gửi mã xác minh")
                </button>

            </EditForm>

            break;

        case Step.Code:

            <h1>Nhập mã xác minh</h1>

            <p class="auth-intro" aria-live="polite">
                @if (info is not null)
                {
                    @info
                    <br />
                }
                Email: <strong>@emailModel.Email</strong>
                <button type="button" class="text-button" disabled="@busy" @onclick="ChangeEmail">Đổi email</button>
            </p>

            @if (devCode is not null)
            {
                <p class="alert dev-hint" role="note">
                    <strong>Chế độ giả lập:</strong> chưa kết nối máy chủ gửi Gmail. Mã của bạn là
                    <strong class="dev-code">@devCode</strong>
                </p>
            }

            @if (error is not null)
            {
                <p class="alert error" role="alert">@error</p>
            }

            <EditForm Model="codeModel" OnValidSubmit="VerifyCode" novalidate>

                <DataAnnotationsValidator />

                <div class="form-stack">
                    <div class="field">
                        <label for="reset-code">Mã xác minh (6 chữ số)</label>
                        <InputTextLive id="reset-code"
                                   @ref="codeInput"
                                   class="code-input"
                                   @bind-Value="codeModel.Code"
                                   @bind-Value:after="NormalizeCode"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   autocomplete="one-time-code"
                                   maxlength="12"
                                   disabled="@codeLocked"
                                   placeholder="••••••" />
                        <ValidationMessage For="@(() => codeModel.Code)" />
                    </div>
                </div>

                <button type="submit" class="btn primary auth-submit" disabled="@(busy || codeLocked)">
                    @(busy ? "Đang kiểm tra…" : "Xác minh")
                </button>

            </EditForm>

            <p class="auth-resend">
                @(codeLocked ? "Mã cũ không còn dùng được." : "Chưa nhận được mã?")
                @(" ")
                @if (resendIn > 0)
                {
                    <span class="muted">Gửi lại sau @resendIn giây</span>
                }
                else
                {
                    <button type="button" class="text-button" disabled="@busy" @onclick="ResendCode">Gửi lại mã</button>
                }
            </p>

            <p class="auth-help">
                Không thấy email sau vài phút? Kiểm tra mục Spam, kiểm tra lại địa chỉ email (bấm “Đổi email”)
                hoặc liên hệ chủ quán để được đặt lại mật khẩu.
            </p>

            break;

        case Step.NewPassword:

            <h1>Đặt mật khẩu mới</h1>

            <p class="auth-intro">Mật khẩu mới tối thiểu 6 ký tự.</p>

            @if (error is not null)
            {
                <p class="alert error" role="alert">@error</p>
            }

            <EditForm Model="passwordModel" OnValidSubmit="SavePassword" novalidate>

                <DataAnnotationsValidator />

                <div class="form-stack">

                    <div class="field">
                        <label for="new-password">Mật khẩu mới</label>
                        <div class="password-field">
                            <InputTextLive id="new-password"
                                       @ref="passwordInput"
                                       type="@(showPassword ? "text" : "password")"
                                       @bind-Value="passwordModel.NewPassword"
                                       autocomplete="new-password"
                                       placeholder="Nhập mật khẩu mới" />
                            <button type="button"
                                    class="icon-button"
                                    aria-label="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")"
                                    @onclick="() => showPassword = !showPassword">
                                <Icon Name="@(showPassword ? "eye-off" : "eye")" Size="18" />
                            </button>
                        </div>
                        <ValidationMessage For="@(() => passwordModel.NewPassword)" />
                    </div>

                    <div class="field">
                        <label for="confirm-password">Nhập lại mật khẩu mới</label>
                        <InputTextLive id="confirm-password"
                                   type="@(showPassword ? "text" : "password")"
                                   @bind-Value="passwordModel.ConfirmPassword"
                                   autocomplete="new-password"
                                   placeholder="Nhập lại mật khẩu mới" />
                        <ValidationMessage For="@(() => passwordModel.ConfirmPassword)" />
                    </div>

                </div>

                <button type="submit" class="btn primary auth-submit" disabled="@busy">
                    @(busy ? "Đang lưu…" : "Lưu mật khẩu mới")
                </button>

            </EditForm>

            break;

        case Step.Done:

            <div class="auth-finish">
                <Icon Name="check" Size="56" />
                <h1>Đã đổi mật khẩu</h1>
                <p class="auth-intro">Bạn có thể đăng nhập bằng mật khẩu mới.</p>
                <a class="btn primary auth-submit" href="login">Quay lại đăng nhập</a>
            </div>

            break;
    }

    @if (step != Step.Done)
    {
        <p class="auth-link auth-back">
            <a href="login">← Quay lại đăng nhập</a>
        </p>
    }

</div>
