@* Logo do nhóm thiết kế: cắt tròn, nền ngoài trong suốt, nền trong là kem ấm cho hợp giao diện.
   logo.png (400px) cho trang đăng nhập, logo-sm.png (128px) cho sidebar. *@
<div class="brand @(Large ? "large" : "")">

    @if (Large)
    {
        @* Trang đăng nhập: chữ "COFFEE SHOP" nằm trong logo nên alt chính là tên quán *@
        <img class="brand-mark"
             src="images/logo.png"
             alt="Coffee Shop"
             width="400"
             height="400" />

        <p class="brand-caption">Quản lý quán cà phê</p>
    }
    else
    {
        @* Sidebar: tên quán đã có chữ bên cạnh → ảnh chỉ để trang trí *@
        <img class="brand-mark"
             src="images/logo-sm.png"
             alt=""
             width="128"
             height="128" />

        <span class="brand-name">
            <strong>Coffee Shop</strong>
        </span>
    }

</div>

@code {
    [Parameter]
    public bool Large { get; set; }
}
