@page "/"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Tổng quan - Coffee Shop</PageTitle>

<div class="dashboard-toolbar">

    <div class="date-filters">

        <div class="date-range">

            <input type="date"
                   aria-label="Từ ngày"
                   @bind="filter.From" />

            <span>–</span>

            <input type="date"
                   aria-label="Đến ngày"
                   @bind="filter.To" />

        </div>

        <select aria-label="Khoảng thời gian"
                @onchange="ChangePeriod">

            <option value="">Tùy chọn</option>
            <option value="7">7 ngày gần nhất</option>
            <option value="30">30 ngày gần nhất</option>
            <option value="month">Tháng này</option>

        </select>

        <button class="btn primary"
                @onclick="Apply">
            Áp dụng
        </button>

    </div>

    <button class="btn primary"
            @onclick="() => exportOpen = true">

        <Icon Name="download" />
        Xuất báo cáo

    </button>

</div>

<p class="filter-caption">
    @range
</p>

@if (error is not null)
{
    <p class="alert error" role="alert">
        @error
    </p>
}

<div class="stat-grid">

    <section class="stat-card">

        <span class="stat-icon">
            <Icon Name="coins" Size="25" />
        </span>

        <div>

            <p>Doanh thu đã thanh toán</p>

            <strong>
                @(report.Rows.Count == 0
                    ? "—"
                    : Money(report.Revenue))
            </strong>

            <small>Doanh thu sau giảm giá.</small>

        </div>

    </section>

    <section class="stat-card">

        <span class="stat-icon">
            <Icon Name="orders" Size="25" />
        </span>

        <div>

            <p>Đơn đã thanh toán</p>

            <strong>
                @(report.Rows.Count == 0
                    ? "—"
                    : report.Orders + " đơn")
            </strong>

            <small>
                Trong khoảng thời gian đã áp dụng.
            </small>

        </div>

    </section>

    <section class="stat-card">

        <span class="stat-icon">
            <Icon Name="box" Size="25" />
        </span>

        <div>

            <p>Chi phí nhập kho</p>

            <strong>
                @(report.Rows.Count == 0
                    ? "—"
                    : Money(report.Cost))
            </strong>

            <small>
                Chỉ tính nhập mua nguyên liệu.
            </small>

        </div>

    </section>

</div>

<section class="panel chart-panel">

    <h2>Doanh thu theo ngày</h2>

    <span class="axis-unit">
        Triệu đồng
    </span>

    @if (report.Rows.Count == 0)
    {
        <div class="chart-empty">
            Chưa có dữ liệu.
        </div>
    }
    else
    {
        <div class="chart-scroll">

            <div class="chart-container"
                 style="@($"min-width:{Math.Max(600, report.Rows.Count * 48)}px")">

                <div class="chart-axis">

                    @for (int i = 6; i >= 0; i--)
                    {
                        <span style="@AxisPosition(i)">
                            @((ChartMax * i / 6m / 1000000m)
                                .ToString("0.#", Vi))
                        </span>
                    }

                </div>

                <div class="plot">

                    <div class="grid-lines">

                        @for (int i = 0; i < 7; i++)
                        {
                            <div></div>
                        }

                    </div>

                    <div class="bars">

                        @foreach (var row in report.Rows)
                        {
                            <div class="bar-column">

                                <div class="bar-value-area">

                                    <strong style="@LabelPosition(row.Revenue)">
                                        @((row.Revenue / 1000000m)
                                            .ToString("0.#", Vi))
                                    </strong>

                                    <div class="bar"
                                         style="@BarHeight(row.Revenue)">
                                    </div>

                                </div>

                                <span>
                                    @row.Date.ToString("dd/MM")
                                </span>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>
    }

</section>

<section class="panel report-panel">

    <h2>Báo cáo theo ngày</h2>

    <div class="table-wrap">

        <table class="report-table">

            <thead>

                <tr>
                    <th>Ngày</th>
                    <th>Đơn đã thanh toán</th>
                    <th>Doanh thu</th>
                    <th>Chi phí nhập kho</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var row in report.Rows)
                {
                    <tr>
                        <td>@row.Date.ToString("dd/MM/yyyy")</td>
                        <td>@row.Orders</td>
                        <td>@Money(row.Revenue)</td>
                        <td>@Money(row.Cost)</td>
                    </tr>
                }

                @if (report.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="empty-cell">
                            Chưa có dữ liệu báo cáo.
                        </td>
                    </tr>
                }

            </tbody>

            <tfoot>

                <tr>
                    <td>Tổng</td>
                    <td>@report.Orders</td>
                    <td>@Money(report.Revenue)</td>
                    <td>@Money(report.Cost)</td>
                </tr>

            </tfoot>

        </table>

    </div>

</section>

@if (exportOpen)
{
    <Modal Title="Xuất báo cáo"
           OnClose="() => exportOpen = false">

        <p>@range</p>

        <div class="actions">

            <button class="btn primary"
                    @onclick="ExportExcel">
                Excel (.csv)
            </button>

            <button class="btn outline"
                    @onclick="PrintPdf">
                PDF / In
            </button>

        </div>

        <p class="form-note">
            Báo cáo dùng bộ lọc đã Áp dụng.
            Với PDF, chọn Lưu dưới dạng PDF trong hộp thoại in.
        </p>

        <div class="modal-footer">

            <button class="btn outline"
                    @onclick="() => exportOpen = false">
                Đóng
            </button>

        </div>

    </Modal>
}